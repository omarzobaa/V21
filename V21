-- defined near the runtime tail after all pages and mini controls exist.
function OS_captureUiConfig()
	return {
		activeTab = ACTIVE_TAB_KEY,
		minimized = MINIMIZED == true,
		panelPosition = OS_serializeUDim2(OS_SAVED_PANEL_POS or (panel and panel.Position)),
		guiTargetFps = OS_GUI_TARGET_FPS,
		rainbowKeypointSteps = OS_RAINBOW_KEYPOINT_STEPS,
	}
end

function OS_applyUiConfig(uiConfig)
	if type(uiConfig) ~= "table" then
		return
	end
	local savedFps = tonumber(uiConfig.guiTargetFps)
	if savedFps then
		OS_GUI_TARGET_FPS = math.clamp(math.floor(savedFps + 0.5), 30, OS_GUI_TARGET_FPS_MAX or 60)
		if OS_RAINBOW_UPDATE_INTERVAL then
			OS_RAINBOW_UPDATE_INTERVAL = 1 / OS_GUI_TARGET_FPS
		end
		if OS_SCROLLBAR_UPDATE_INTERVAL then
			OS_SCROLLBAR_UPDATE_INTERVAL = 1 / math.min(OS_GUI_TARGET_FPS, 60)
		end
	end
	local savedKeypoints = tonumber(uiConfig.rainbowKeypointSteps)
	if savedKeypoints then
		OS_RAINBOW_KEYPOINT_STEPS = math.clamp(math.floor(savedKeypoints + 0.5), 4, 10)
	end
	if type(setSavedPos) ~= "function" or type(setMinimized) ~= "function" then
		OS_PENDING_UI_CONFIG = uiConfig
		return
	end
	local savedPos = OS_deserializeUDim2(uiConfig.panelPosition)
	if savedPos then
		setSavedPos(savedPos)
	end
	if type(uiConfig.activeTab) == "string" and tabPages and tabPages[uiConfig.activeTab] then
		setActiveTab(uiConfig.activeTab)
	end
	if uiConfig.minimized ~= nil then
		setMinimized(uiConfig.minimized == true, true)
	end
end

function OS_applyPlayerToolsConfig(playerToolsConfig)
	if type(playerToolsConfig) ~= "table" then
		return
	end
	if type(PLAYERTOOLS) ~= "table" or type(PLAYERTOOLS.createCheckpointCard) ~= "function" then
		OS_PENDING_PLAYERTOOLS_CONFIG = playerToolsConfig
		return
	end
	if type(PLAYERTOOLS.stopAll) == "function" then
		PLAYERTOOLS.stopAll()
	end
	PLAYERTOOLS.exclusiveAimTargets = PLAYERTOOLS.exclusiveAimTargets or {}
	PLAYERTOOLS.exclusiveEspTargets = PLAYERTOOLS.exclusiveEspTargets or {}
	PLAYERTOOLS.aimWhitelist = PLAYERTOOLS.aimWhitelist or {}
	PLAYERTOOLS.aimBlacklist = PLAYERTOOLS.aimBlacklist or {}
	PLAYERTOOLS.espWhitelist = PLAYERTOOLS.espWhitelist or {}
	PLAYERTOOLS.espBlacklist = PLAYERTOOLS.espBlacklist or {}
	OS_restorePlayerNameMap(PLAYERTOOLS.exclusiveAimTargets, playerToolsConfig.exclusiveAimTargets)
	OS_restorePlayerNameMap(PLAYERTOOLS.exclusiveEspTargets, playerToolsConfig.exclusiveEspTargets)
	OS_restorePlayerNameMap(PLAYERTOOLS.aimWhitelist, playerToolsConfig.aimWhitelist)
	OS_restorePlayerNameMap(PLAYERTOOLS.aimBlacklist, playerToolsConfig.aimBlacklist)
	OS_restorePlayerNameMap(PLAYERTOOLS.espWhitelist, playerToolsConfig.espWhitelist)
	OS_restorePlayerNameMap(PLAYERTOOLS.espBlacklist, playerToolsConfig.espBlacklist)

	if type(PLAYERTOOLS.checkpoints) ~= "table" then
		PLAYERTOOLS.checkpoints = {}
	else
		table.clear(PLAYERTOOLS.checkpoints)
	end
	PLAYERTOOLS.checkpointCounter = tonumber(playerToolsConfig.checkpointCounter) or 0
	if PLAYERTOOLS.checkpointCardsContainer then
		for _, child in ipairs(PLAYERTOOLS.checkpointCardsContainer:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	if type(playerToolsConfig.checkpoints) == "table" then
		for _, saved in ipairs(playerToolsConfig.checkpoints) do
			if type(saved) == "table" then
				local checkpointData = {
					index = tonumber(saved.index),
					name = tostring(saved.name or ""),
					cframe = OS_deserializeCFrame(saved.cframe),
				}
				table.insert(PLAYERTOOLS.checkpoints, checkpointData)
				PLAYERTOOLS.createCheckpointCard(checkpointData)
			end
		end
	end

	PLAYERTOOLS.returnCFrame = nil
	PLAYERTOOLS.trackTarget = nil
	PLAYERTOOLS.trackModeActive = false
	PLAYERTOOLS.spectateTarget = nil
	PLAYERTOOLS.spectateActive = false
	PLAYERTOOLS.followTarget = nil
	PLAYERTOOLS.followActive = false
	if type(PLAYERTOOLS.refreshReturnButtons) == "function" then
		PLAYERTOOLS.refreshReturnButtons()
	end
	if type(PLAYERTOOLS.refreshFilters) == "function" then
		PLAYERTOOLS.refreshFilters()
	end

	if PLAYERTOOLS.trackAction then
		PLAYERTOOLS.trackAction.setSelected(nil, "Track idle", OS_PLAYERTOOLS_NEUTRAL_COLOR)
		if PLAYERTOOLS.trackAction.searchBox then
			PLAYERTOOLS.trackAction.searchBox.Text = ""
		end
	end
	if type(PLAYERTOOLS.refreshTrackButtons) == "function" then
		PLAYERTOOLS.refreshTrackButtons()
	end
	OS_PENDING_PLAYERTOOLS_CONFIG = nil
end

