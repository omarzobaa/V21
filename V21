do
	local player = Players.LocalPlayer
	local KEY = "_osInspectorIntegratedInvis"
	local VISUAL_ALPHA = 0.5
	local SHIFT = CFrame.new(-200000, 0, 0)
	local BIND_NAME = ("OSIntegratedInvRestore_%s_%s"):format(player.UserId, tostring(OS_EXEC_ID))

	local old = getgenv()[KEY]
	if type(old) == "table" and type(old.cleanup) == "function" then
		pcall(old.cleanup)
	end

	local state = {
		on = false,
		character = nil,
		root = nil,
		transparencies = {},
		connections = {},
		descendantConn = nil,
		restore = nil,
		pendingRootCharacter = nil,
	}
	getgenv()[KEY] = state
	getgenv()._osInspectorIntegratedInvis = state

	local function live()
		return state.character and state.root and state.character.Parent and state.root.Parent
	end

	local function getVisualModifier(baseTransparency)
		if baseTransparency >= VISUAL_ALPHA then
			return 0
		end
		local denom = 1 - baseTransparency
		if denom <= 0 then
			return 0
		end
		return math.clamp(1 - ((1 - VISUAL_ALPHA) / denom), 0, 1)
	end

	local function registerVisual(item)
		if item:IsA("BasePart") or item:IsA("Decal") then
			state.transparencies[item] = item.Transparency
			if state.on then
				if item:IsA("BasePart") then
					item.LocalTransparencyModifier = getVisualModifier(item.Transparency)
				else
					item.Transparency = math.max(item.Transparency, VISUAL_ALPHA)
				end
			end
		end
	end

	local function apply()
		for item, transparency in pairs(state.transparencies) do
			if item and item.Parent then
				if item:IsA("BasePart") then
					item.LocalTransparencyModifier = state.on and getVisualModifier(transparency) or 0
				else
					item.Transparency = state.on and math.max(transparency, VISUAL_ALPHA) or transparency
				end
			end
		end
	end

	local function syncUi()
		pcall(function()
			if type(refreshIntegratedInvisUi) == "function" then
				refreshIntegratedInvisUi()
			end
		end)
	end

	local function refresh(characterOverride)
		local character = characterOverride or player.Character
		state.character = character
		state.root = nil
		state.restore = nil

		if state.descendantConn then
			state.descendantConn:Disconnect()
			state.descendantConn = nil
		end

		table.clear(state.transparencies)

		if not (character and character.Parent) then
			syncUi()
			return
		end

		local root = character:FindFirstChild("HumanoidRootPart")
		if not (root and root:IsA("BasePart")) then
			if state.pendingRootCharacter ~= character then
				state.pendingRootCharacter = character
				task.spawn(function()
					local awaitedRoot = character:WaitForChild("HumanoidRootPart", 15)
					if getgenv()[KEY] ~= state then return end
					if state.pendingRootCharacter ~= character then return end
					state.pendingRootCharacter = nil
					if awaitedRoot and awaitedRoot:IsA("BasePart") and player.Character == character then
						refresh(character)
					end
				end)
			end
			syncUi()
			return
		end

		state.pendingRootCharacter = nil
		state.root = root
		for _, item in ipairs(character:GetDescendants()) do
			registerVisual(item)
		end
		state.descendantConn = character.DescendantAdded:Connect(registerVisual)

		apply()
		syncUi()
	end

	local function set(on)
		if state.on == on then
			return
		end

		state.on = on

		if not on and state.restore and live() then
			state.root.CFrame = state.restore
			state.restore = nil
		end

		apply()
		syncUi()
	end

	state.toggle = function()
		set(not state.on)
	end
	state.set = set
	state.refresh = refresh

	function state.cleanup()
		pcall(function()
			set(false)
		end)

		pcall(function()
			RunService:UnbindToRenderStep(BIND_NAME)
		end)

		for _, connection in ipairs(state.connections) do
			pcall(function()
				connection:Disconnect()
			end)
		end
		table.clear(state.connections)
		if state.descendantConn then
			pcall(function()
				state.descendantConn:Disconnect()
			end)
			state.descendantConn = nil
		end

		for item, transparency in pairs(state.transparencies) do
			if item and item.Parent then
				if item:IsA("BasePart") then
					item.LocalTransparencyModifier = 0
				else
					item.Transparency = transparency
				end
			end
		end
		table.clear(state.transparencies)

		if getgenv()[KEY] == state then
			getgenv()[KEY] = nil
		end
		if getgenv()._osInspectorIntegratedInvis == state then
			getgenv()._osInspectorIntegratedInvis = nil
		end
	end

	table.insert(state.connections, player.CharacterAdded:Connect(function(character)
		task.defer(function()
			if getgenv()[KEY] == state then
				refresh(character)
			end
		end)
	end))

	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value - 1, function()
		if state.restore and live() then
			state.root.CFrame = state.restore
		end
		state.restore = nil
	end)

	table.insert(state.connections, RunService.Heartbeat:Connect(function()
		if not state.on or not live() then
			return
		end

		local now = os.clock()
		if now >= (state.nextVisualApply or 0) then
			state.nextVisualApply = now + 0.15
			apply()
		end

		if state.restore then
			state.root.CFrame = state.restore
			state.restore = nil
		end

		local current = state.root.CFrame
		state.restore = current
		state.root.CFrame = current * SHIFT
	end))

	refresh()
end

