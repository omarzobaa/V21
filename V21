			Size = UDim2.fromOffset(math.max(1, math.floor(SLIDER_KNOB_SIZE * 0.45)), math.max(1, math.floor(SLIDER_KNOB_SIZE * 0.45))),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			BackgroundColor3 = THEME_TEXT,
			BorderSizePixel = 0,
			ZIndex = 56,
			Parent = knob,
		})
		mk("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knobInner })

		local function showError(message: string?)
			if not message or message == "" then
				errorLabel.Visible = false
				return
			end
			errorToken += 1
			local token = errorToken
			errorLabel.Text = message
			errorLabel.TextTransparency = 0
			errorLabel.Visible = true
			task.delay(2, function()
				if errorToken ~= token then return end
				tween(errorLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					TextTransparency = 1,
				})
				task.delay(0.26, function()
					if errorToken ~= token then return end
					errorLabel.Visible = false
				end)
			end)
		end

		local function setValue(value: number, showLimitError: boolean?)
			local rounded = math.floor(value + 0.5)
			if rounded < 1 then
				rounded = 1
			end
			if rounded > inputMax then
				rounded = inputMax
				if showLimitError then
					showError(("Max is %d"):format(inputMax))
				end
			end
			OS_POVCAM.maxZoom = rounded
			local displayValue = math.clamp(rounded, 1, sliderMax)
			local alpha = (displayValue - 1) / math.max(1, sliderMax - 1)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			valueBox.Text = tostring(rounded)
			if OS_POVCAM.enabled then
				OS_applyPovCameraState()
			end
		end

		local function setFromX(x: number)
			local absPos = track.AbsolutePosition
			local absSize = track.AbsoluteSize
			if absSize.X <= 0 then return end
			local alpha = math.clamp((x - absPos.X) / absSize.X, 0, 1)
			setValue(1 + ((sliderMax - 1) * alpha))
		end

		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragLock = true
				setFromX(input.Position.X)
			end
		end)
		knob.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragLock = true
				setFromX(input.Position.X)
			end
		end)
		OS_CONNECT(UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			setFromX(input.Position.X)
		end))
		OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
				clearDragLockIfIdle()
			end
		end))
		valueBox.Focused:Connect(function()
			dragLock = true
		end)
		valueBox.FocusLost:Connect(function()
			clearDragLockIfIdle()
			local parsed = tonumber(valueBox.Text)
			if not parsed then
				valueBox.Text = tostring(math.floor(OS_POVCAM.maxZoom + 0.5))
				showError("Numbers only")
				return
			end
			setValue(parsed, true)
		end)

		povRefreshers[#povRefreshers + 1] = function()
			setValue(OS_POVCAM.maxZoom)
		end
		setValue(OS_POVCAM.maxZoom)
	end

	povHeader("POV CAMERA")
	povNote("Unlimited zoom uses Roblox's smooth scroll. Wall ignore keeps your camera from snapping in.", S(30))
	povNote("Transparent walls forces every part transparent instantly while POV is enabled.", S(34))
	povSwitchRow("Unlimited Zoom", function()
		return OS_POVCAM.enabled == true
	end, function(value)
		OS_POVCAM.enabled = value
		OS_POVCAM.wallIgnore = true
		if value then
			OS_POVCAM.savedMaxZoom = OS_POVCAM.maxZoom
			OS_POVCAM.maxZoom = OS_POVCAM_UNLIMITED_ZOOM or 1e6
		else
			OS_POVCAM.maxZoom = OS_POVCAM.savedMaxZoom or 512
		end
		OS_applyPovCameraState(not value)
		OS_clearPovWallTransparency()
		OS_clearAllLocalTransparencyModifiers()
	end)
	povSwitchRow("Transparent Walls", function()
		return OS_POVCAM.transparentWalls == true
	end, function(value)
		OS_POVCAM.transparentWalls = value
		OS_updatePovWallTransparency()
		OS_applyPovCameraState()
	end)
	povPill("Free Cam", function()
		if FREECAM.speedInfoLabel then
			FREECAM.speedInfoLabel.Text = "Current move speed: " .. tostring(OS_getFreecamSpeedValue())
		end
		FREECAM.start()
	end)

	refreshPovUi()
	if OS_POVCAM.enabled then
		OS_applyPovCameraState()
	end
	OS_updatePovWallTransparency()
end

