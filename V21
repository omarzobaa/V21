end)

local function findAimClosestPart(partName: string)
	local referencePoint = aimControlMode == "Mouse"
		and getMouseViewportPosition()
		or Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
	local bestPart = nil
	local bestDistance = math.huge
	local bestDepth = math.huge

	local function considerCandidate(part: BasePart?)
		if not isAimTargetPartValid(part) then
			return
		end

		local aimPosition = getPredictedAimPosition(part)
		local screenPoint = worldToAimScreenPoint(aimPosition, false)
		if not screenPoint then
			return
		end

		local distance = (screenPoint - referencePoint).Magnitude
		if distance > AIM_MOUSE_RADIUS then
			return
		end
		local cameraSpace = Camera.CFrame:PointToObjectSpace(aimPosition)
		local depth = math.abs(cameraSpace.Z)

		if depth > MAX_RAY_DISTANCE then
			return
		end

		if bestPart == nil or distance < bestDistance or (distance == bestDistance and depth < bestDepth) then
			bestDistance = distance
			bestDepth = depth
			bestPart = part
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and (not PLAYERTOOLS or not PLAYERTOOLS.allowAimPlayer or PLAYERTOOLS.allowAimPlayer(plr)) then
			local char = plr.Character
			if char and alive(char) then
				considerCandidate(getAimCandidatePart(char, partName))
			end
		end
	end

	if PLAYERTOOLS and PLAYERTOOLS.npcAimEnabled == true then
		for model in pairs(NPCTargets) do
			if alive(model) then
				considerCandidate(getAimCandidatePart(model, partName))
			end
		end
	end

	return bestPart
end

local function tryAcquireAimTarget(partName: string): BasePart?
	if aimLeaveBlockAcquire then
		return nil
	end

	if not aimTargetSwitchEnabled and aimHoldAcquireConsumed then
		return nil
	end

	if not aimTargetSwitchEnabled then
		aimHoldAcquireConsumed = true
	end

	local acquiredPart = findAimClosestPart(partName)
	if acquiredPart then
		return setAimTarget(acquiredPart)
	end

	clearAimTarget()
	return nil
end

local function applyCameraAim(aimPosition: Vector3, dt: number?)
	local currentCamera = Camera.CFrame
	local targetCamera = CFrame.new(currentCamera.Position, aimPosition)
	local smoothnessAlpha = getAimSmoothnessAlpha(dt)
	local targetOffset = aimPosition - currentCamera.Position
	local targetDirection = targetOffset.Magnitude > 0 and targetOffset.Unit or currentCamera.LookVector
	local angleDelta = math.acos(math.clamp(currentCamera.LookVector:Dot(targetDirection), -1, 1))
	local catchUpBoost = math.clamp(1 + (angleDelta / math.rad(8)), 1, 4)
	smoothnessAlpha = math.min(1, smoothnessAlpha * catchUpBoost)
	Camera.CFrame = smoothnessAlpha >= 1 and targetCamera or currentCamera:Lerp(targetCamera, smoothnessAlpha)
end

