local destroyLaser
OS_TRACKED_PLAYER_ESP_CHARACTERS = {} :: { [Model]: boolean }
OS_PLAYER_CHARACTER_LIFECYCLE_CONNECTIONS = {} :: { [Player]: { RBXScriptConnection } }

function OS_forgetTrackedPlayerEspCharacter(character: Model?)
	if not character or not character:IsA("Model") then return end
	OS_TRACKED_PLAYER_ESP_CHARACTERS[character] = nil
	local hl = character:FindFirstChild(HIGHLIGHT_NAME)
	if hl then
		hl:Destroy()
	end
end

function OS_trackPlayerEspCharacter(character: Model?)
	if character and character:IsA("Model") then
		OS_TRACKED_PLAYER_ESP_CHARACTERS[character] = true
	end
end

function OS_sweepTrackedPlayerEspCharacters(activeCharacters: { [Model]: boolean })
	local staleCharacters = {} :: { Model }
	for character in pairs(OS_TRACKED_PLAYER_ESP_CHARACTERS) do
		if not activeCharacters[character] or not character.Parent or not alive(character) then
			table.insert(staleCharacters, character)
		end
	end
	for _, character in ipairs(staleCharacters) do
		OS_forgetTrackedPlayerEspCharacter(character)
	end
end

function OS_disconnectPlayerCharacterLifecycle(plr: Player)
	local bucket = OS_PLAYER_CHARACTER_LIFECYCLE_CONNECTIONS[plr]
	if not bucket then return end
	for _, conn in ipairs(bucket) do
		if conn then
			conn:Disconnect()
		end
	end
	OS_PLAYER_CHARACTER_LIFECYCLE_CONNECTIONS[plr] = nil
end

function OS_bindPlayerCharacterLifecycle(plr: Player)
	if plr == LocalPlayer or OS_PLAYER_CHARACTER_LIFECYCLE_CONNECTIONS[plr] then
		return
	end

	local bucket = {} :: { RBXScriptConnection }
	OS_PLAYER_CHARACTER_LIFECYCLE_CONNECTIONS[plr] = bucket

	table.insert(bucket, plr.CharacterAdded:Connect(function(character)
		if not OS_EXEC_IS_CURRENT() then return end
		OS_forgetTrackedPlayerEspCharacter(character)
		OS_ESP_NEXT_UPDATE = 0
	end))

	pcall(function()
		table.insert(bucket, plr.CharacterAppearanceLoaded:Connect(function(character)
			if not OS_EXEC_IS_CURRENT() then return end
			OS_forgetTrackedPlayerEspCharacter(character)
			OS_ESP_NEXT_UPDATE = 0
		end))
	end)

	table.insert(bucket, plr.CharacterRemoving:Connect(function(character)
		if not OS_EXEC_IS_CURRENT() then return end
		OS_forgetTrackedPlayerEspCharacter(character)
		if targetPlayer == plr or (targetPart and targetPart:IsDescendantOf(character)) then
			clearAimTarget()
			destroyLaser()
		end
		OS_ESP_NEXT_UPDATE = 0
	end))
end

local function ensureHighlight(target)
	local char = target
	if typeof(target) == "Instance" and target:IsA("Player") then
		if target == LocalPlayer then return nil end
		char = target.Character
	end
	if not char or not char:IsA("Model") or char == LocalPlayer.Character then return nil end

	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Highlight") and child.Name ~= HIGHLIGHT_NAME then
			child:Destroy()
		end
	end

	local hl = char:FindFirstChild(HIGHLIGHT_NAME)
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = HIGHLIGHT_NAME
	end
	hl.Adornee = char
	hl.Parent = char
	hl.Enabled = true
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.OutlineColor = HIGHLIGHT_OUTLINE
	hl.FillTransparency = HIGHLIGHT_FILL_TRANSPARENCY
	return hl
end

local function removeHighlight(target)
	local char = target
	if typeof(target) == "Instance" and target:IsA("Player") then
		if target == LocalPlayer then return end
		char = target.Character
	end
	if not char or not char:IsA("Model") then return end
	local hl = char:FindFirstChild(HIGHLIGHT_NAME)
	if hl then hl:Destroy() end
end

local function removeAllHighlights()
	local trackedCharacters = {} :: { Model }
	for character in pairs(OS_TRACKED_PLAYER_ESP_CHARACTERS) do
		table.insert(trackedCharacters, character)
	end
	for _, character in ipairs(trackedCharacters) do
		OS_forgetTrackedPlayerEspCharacter(character)
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		removeHighlight(plr)
	end
	for model in pairs(NPCTargets) do
		removeHighlight(model)
	end
end

