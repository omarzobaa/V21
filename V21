function OS_initPlayerToolsState()
	PLAYERTOOLS = PLAYERTOOLS or {}
	PLAYERTOOLS.spectateActive = false
	PLAYERTOOLS.followActive = false
	PLAYERTOOLS.spectateTarget = nil
	PLAYERTOOLS.followTarget = nil
	PLAYERTOOLS.trackModeActive = false
	PLAYERTOOLS.trackTarget = nil
	PLAYERTOOLS.returnCFrame = nil
	PLAYERTOOLS.exclusiveAimTargets = PLAYERTOOLS.exclusiveAimTargets or {}
	PLAYERTOOLS.exclusiveEspTargets = PLAYERTOOLS.exclusiveEspTargets or {}
	PLAYERTOOLS.aimWhitelist = PLAYERTOOLS.aimWhitelist or {}
	PLAYERTOOLS.aimBlacklist = PLAYERTOOLS.aimBlacklist or {}
	PLAYERTOOLS.espWhitelist = PLAYERTOOLS.espWhitelist or {}
	PLAYERTOOLS.espBlacklist = PLAYERTOOLS.espBlacklist or {}
	PLAYERTOOLS.checkpoints = PLAYERTOOLS.checkpoints or {}
	PLAYERTOOLS.checkpointCounter = PLAYERTOOLS.checkpointCounter or 0
	PLAYERTOOLS.filterRefreshers = {}
	PLAYERTOOLS.allowAimPlayer = function(plr)
		if not plr or plr == LocalPlayer then return false end
		if PLAYERTOOLS.aimBlacklist[plr.UserId] then return false end
		if next(PLAYERTOOLS.exclusiveAimTargets) ~= nil then
			return PLAYERTOOLS.exclusiveAimTargets[plr.UserId] ~= nil
		end
		return next(PLAYERTOOLS.aimWhitelist) == nil or PLAYERTOOLS.aimWhitelist[plr.UserId] ~= nil
	end
	PLAYERTOOLS.allowEspPlayer = function(plr)
		if not plr or plr == LocalPlayer then return false end
		if PLAYERTOOLS.espBlacklist[plr.UserId] then return false end
		if next(PLAYERTOOLS.exclusiveEspTargets) ~= nil then
			return PLAYERTOOLS.exclusiveEspTargets[plr.UserId] ~= nil
		end
		return next(PLAYERTOOLS.espWhitelist) == nil or PLAYERTOOLS.espWhitelist[plr.UserId] ~= nil
	end
	PLAYERTOOLS.refreshFilters = function()
		for _, refresh in ipairs(PLAYERTOOLS.filterRefreshers) do
			refresh()
		end
		if aimEnabled then
			aimHoldAcquireConsumed = false
			clearAimTarget()
			destroyLaser()
		end
		if espEnabled then
			removeAllHighlights()
			OS_ESP_NEXT_UPDATE = 0
		end
	end
	PLAYERTOOLS.onPlayerRemoving = function(plr)
		local userId = plr and plr.UserId
		if not userId then return end
		if PLAYERTOOLS.trackTarget == plr then
			PLAYERTOOLS.trackTarget = nil
			if PLAYERTOOLS.trackAction then
				PLAYERTOOLS.trackAction.setSelected(nil, "Tracked player left the server", OS_PLAYERTOOLS_ERROR_COLOR)
			end
		end
		PLAYERTOOLS.exclusiveAimTargets[userId] = nil
		PLAYERTOOLS.exclusiveEspTargets[userId] = nil
		PLAYERTOOLS.aimWhitelist[userId] = nil
		PLAYERTOOLS.aimBlacklist[userId] = nil
		PLAYERTOOLS.espWhitelist[userId] = nil
		PLAYERTOOLS.espBlacklist[userId] = nil
		PLAYERTOOLS.refreshFilters()
	end
end

