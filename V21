OS_SAVED_PANEL_POS = panel.Position

function setSavedPos(pos: UDim2)
	OS_SAVED_PANEL_POS = pos
	panel.Position = pos
	mini.Position = pos
end

function makeDraggable(frame: GuiObject)
	local dragging = false
	local dragStart = Vector2.zero
	local startPos = UDim2.new()

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if dragLock then return end -- Prevent drag when slider dragLock active
			dragging = true
			dragStart = input.Position
			startPos = OS_SAVED_PANEL_POS or frame.Position
		end
	end)

	OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end))

	OS_CONNECT(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local delta = input.Position - dragStart
		setSavedPos(UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y))
	end))
end
makeDraggable(panel)
makeDraggable(mini)

