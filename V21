function OS_bindPlayerToolsHeartbeat()
	OS_CONNECT(RunService.Heartbeat:Connect(function()
		if not OS_EXEC_IS_CURRENT() then return end
		if PLAYERTOOLS.spectateActive then
			local target = PLAYERTOOLS.spectateTarget
			if not target or target.Parent ~= Players then
				PLAYERTOOLS.stopSpectate("Player left the server", OS_PLAYERTOOLS_ERROR_COLOR)
			else
				local hum = OS_playerToolsGetPlayerHumanoid(target)
				if hum then
					OS_syncCurrentCamera()
					Camera.CameraType = Enum.CameraType.Custom
					if Camera.CameraSubject ~= hum then
						Camera.CameraSubject = hum
					end
				else
					local localHum = getHumanoid()
					if localHum and Camera.CameraSubject ~= localHum then
						OS_restorePlayerCamera(localHum)
					end
				end
			end
		end

		if PLAYERTOOLS.followActive then
			local target = PLAYERTOOLS.followTarget
			if not target or target.Parent ~= Players then
				PLAYERTOOLS.stopFollow("Player left the server", OS_PLAYERTOOLS_ERROR_COLOR)
			else
				local localRoot = OS_playerToolsGetLocalRoot()
				local targetRoot = OS_playerToolsGetPlayerRoot(target)
				if localRoot and targetRoot then
					local hum = getHumanoid()
					if hum then
						hum:Move(Vector3.zero, true)
					end
					localRoot.CFrame = OS_playerToolsGetBehindTargetCFrame(targetRoot, 1.2)
					localRoot.AssemblyLinearVelocity = Vector3.zero
					localRoot.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end
	end))
end

