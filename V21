function OS_showGravityError(message: string?)
	if not gravityErrorLabel then
		return
	end
	if not message or message == "" then
		gravityErrorLabel.Visible = false
		return
	end
	gravityErrorToken += 1
	local token = gravityErrorToken
	gravityErrorLabel.Text = message
	gravityErrorLabel.TextTransparency = 0
	gravityErrorLabel.Visible = true
	task.delay(2, function()
		if gravityErrorToken ~= token then return end
		tween(gravityErrorLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextTransparency = 1,
		})
		task.delay(0.26, function()
			if gravityErrorToken ~= token then return end
			gravityErrorLabel.Visible = false
		end)
	end)
end

function OS_updateGravitySliderVisual(value: number)
	if not gravitySliderKnobOuter then
		return
	end
	local percent = math.clamp(value, 0, GRAVITY_SLIDER_MAX) / GRAVITY_SLIDER_MAX
	gravitySliderKnobOuter.Position = UDim2.new(percent, 0, 0.5, 0)
end

function OS_updateGravitySliderFromX(x: number)
	if not gravitySliderTrack then
		return
	end
	local absPos = gravitySliderTrack.AbsolutePosition
	local absSize = gravitySliderTrack.AbsoluteSize
	if absSize.X <= 0 then return end
	local alpha = math.clamp((x - absPos.X) / absSize.X, 0, 1)
	setGravityValue(alpha * GRAVITY_SLIDER_MAX)
end

