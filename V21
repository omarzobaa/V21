function refreshMainCanvasSize()
	local maxBottom = 0
	local extraBottomPad = 0
	for _, child in ipairs(pageMain:GetChildren()) do
		if child:IsA("GuiObject") then
			local bottom = child.Position.Y.Offset + child.Size.Y.Offset
			if bottom > maxBottom then
				maxBottom = bottom
			end
		end
	end
	if resetMainBtn and resetMainBtn.Parent == pageMain then
		local resetBottom = resetMainBtn.Position.Y.Offset + resetMainBtn.Size.Y.Offset
		if resetBottom > maxBottom then
			maxBottom = resetBottom
		end
		extraBottomPad = 4
	end
	pageMain.CanvasSize = UDim2.new(0, 0, 0, maxBottom + MAIN_PAGE_SCROLL_PAD + extraBottomPad)
end
local mainCanvasRefreshSuspended = false
local mainCanvasRefreshScheduled = false
local mainCanvasRefreshPending = false
function scheduleRefreshMainCanvasSize()
	mainCanvasRefreshPending = true
	if mainCanvasRefreshSuspended or mainCanvasRefreshScheduled then
		return
	end
	mainCanvasRefreshScheduled = true
	task.defer(function()
		mainCanvasRefreshScheduled = false
		if mainCanvasRefreshSuspended or not mainCanvasRefreshPending then
			return
		end
		mainCanvasRefreshPending = false
		refreshMainCanvasSize()
	end)
end
function setMainCanvasRefreshSuspended(state: boolean)
	mainCanvasRefreshSuspended = state
	if not state and mainCanvasRefreshPending then
		mainCanvasRefreshPending = false
		mainCanvasRefreshScheduled = false
		refreshMainCanvasSize()
	end
end
pageMain.ChildAdded:Connect(function()
	scheduleRefreshMainCanvasSize()
end)
pageMain.ChildRemoved:Connect(function()
	scheduleRefreshMainCanvasSize()
end)

