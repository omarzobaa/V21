-- =========================
OS_STATUS_UPDATE_INTERVAL = 0.2
OS_RAINBOW_UPDATE_INTERVAL = 1 / OS_GUI_TARGET_FPS
OS_SCROLLBAR_UPDATE_INTERVAL = 1 / math.min(OS_GUI_TARGET_FPS, 60)
OS_SCROLLBAR_NEXT_UPDATE = 0
OS_SCROLLBAR_ACCUM_DT = 0
OS_ESP_UPDATE_INTERVAL = 0.1
OS_RAINBOW_NEXT_UPDATE = 0
OS_ESP_NEXT_UPDATE = 0
OS_MAIN_UPDATE_BIND_NAME = ("OSMainUpdate_%s_%s"):format(LocalPlayer.UserId, tostring(OS_EXEC_ID))
OS_MAIN_UPDATE_CONN = nil
-- =========================
-- MAIN RUNTIME UPDATE LOOP
-- Keeps UI effects, ESP, aim, and movement helpers synced every frame.
-- =========================
function OS_runMainUpdate(dt)
	if not OS_EXEC_IS_CURRENT() then return end
	local accent = Color3.new(1, 1, 1)
	local rainbowTick = os.clock()
	local guiVisible = gui and gui.Enabled

	if rainbowTick >= OS_STATUS_NEXT_UPDATE then
		OS_STATUS_NEXT_UPDATE = rainbowTick + OS_STATUS_UPDATE_INTERVAL
		if guiVisible and pageActive.Visible then
			OS_refreshStatusPage()
		end
	end

	if guiVisible and rainbowTick >= OS_RAINBOW_NEXT_UPDATE then
		OS_RAINBOW_NEXT_UPDATE = rainbowTick + OS_RAINBOW_UPDATE_INTERVAL
		if OS_RAINBOW_TARGETS_DIRTY or rainbowTick >= (OS_RAINBOW_TARGET_SWEEP_NEXT or 0) then
			OS_rebuildActiveRainbowTargets(rainbowTick)
		end
		local sequenceCache = {}
		for i = #OS_ACTIVE_RAINBOW_GRADIENTS, 1, -1 do
			local gradient = OS_ACTIVE_RAINBOW_GRADIENTS[i]
			if not (gradient and gradient.Parent) then
				table.remove(OS_ACTIVE_RAINBOW_GRADIENTS, i)
				OS_RAINBOW_TARGETS_DIRTY = true
			elseif OS_shouldAnimateRainbowTarget(gradient) then
				local soft = gradient:GetAttribute("RainbowSoft") == true
				local span = gradient:GetAttribute("RainbowSpan") or 0.22
				local shift = ((rainbowTick * (gradient:GetAttribute("RainbowSpeed") or 0.18)) + (gradient:GetAttribute("RainbowPhase") or 0)) % 1
				local cacheKey = (soft and "S" or "H") .. ":" .. tostring(math.floor(span * 1000 + 0.5)) .. ":" .. tostring(math.floor(shift * OS_GUI_TARGET_FPS + 0.5))
				local sequence = sequenceCache[cacheKey]
				if not sequence then
					sequence = OS_buildRainbowSequence(
						soft and OS_RAINBOW_SOFT_POINTS or OS_RAINBOW_POINTS,
						shift,
						span
					)
					sequenceCache[cacheKey] = sequence
				end
				gradient.Color = sequence
			else
				table.remove(OS_ACTIVE_RAINBOW_GRADIENTS, i)
				OS_RAINBOW_TARGETS_DIRTY = true
			end
		end
		for i = #OS_ACTIVE_RAINBOW_NATIVE_SCROLLBARS, 1, -1 do
			local scroller = OS_ACTIVE_RAINBOW_NATIVE_SCROLLBARS[i]
			if not (scroller and scroller.Parent) then
				table.remove(OS_ACTIVE_RAINBOW_NATIVE_SCROLLBARS, i)
				OS_RAINBOW_TARGETS_DIRTY = true
			elseif OS_isGuiObjectVisibleInTree(scroller) then
				scroller.ScrollBarImageColor3 = OS_sampleRainbow(OS_RAINBOW_POINTS, rainbowTick * 0.18)
			else
				table.remove(OS_ACTIVE_RAINBOW_NATIVE_SCROLLBARS, i)
				OS_RAINBOW_TARGETS_DIRTY = true
			end
		end
	end
	if guiVisible then
		OS_SCROLLBAR_ACCUM_DT = (OS_SCROLLBAR_ACCUM_DT or 0) + (dt or 0)
		local scrollbarNeedsUpdate = rainbowTick >= (OS_SCROLLBAR_NEXT_UPDATE or 0)
		if not scrollbarNeedsUpdate then
			for _, scrollbar in ipairs(OS_RAINBOW_SCROLLBARS) do
				if scrollbar and (scrollbar.dragging or scrollbar.hovering) then
					scrollbarNeedsUpdate = true
					break
				end
			end
		end
		if scrollbarNeedsUpdate then
			local scrollbarDt = math.max(OS_SCROLLBAR_ACCUM_DT or 0, dt or 0)
			OS_SCROLLBAR_ACCUM_DT = 0
			OS_SCROLLBAR_NEXT_UPDATE = rainbowTick + (OS_SCROLLBAR_UPDATE_INTERVAL or (1 / 60))
		for i = #OS_RAINBOW_SCROLLBARS, 1, -1 do
			local scrollbar = OS_RAINBOW_SCROLLBARS[i]
			if scrollbar and scrollbar.scroller and scrollbar.track and scrollbar.thumb and scrollbar.track.Parent then
				local scroller = scrollbar.scroller
				local scrollerVisible = OS_isGuiObjectVisibleInTree(scroller)
				if not scrollerVisible and not scrollbar.dragging then
					scrollbar.track.Visible = false
				else
					local canvasSize = scroller.AbsoluteCanvasSize
					local windowSize = scroller.AbsoluteWindowSize
					local scrollable = scrollerVisible and canvasSize.Y > windowSize.Y
					local mousePos = UserInputService:GetMouseLocation()
					local absSize = scroller.AbsoluteSize
					local trackHeight = math.max(1, absSize.Y - S(12))
					local maxScroll = math.max(1, canvasSize.Y - windowSize.Y)
					local thumbHeight = math.max(S(24), math.floor(trackHeight * math.clamp(windowSize.Y / math.max(canvasSize.Y, 1), 0, 1) + 0.5))
					local usable = math.max(1, trackHeight - thumbHeight)
					if scrollbar.dragging and scrollable then
						local deltaY = mousePos.Y - scrollbar.dragStartMouseY
						local nextScroll = math.clamp(scrollbar.dragStartCanvasY + (deltaY * (maxScroll / usable)), 0, maxScroll)
						scroller.CanvasPosition = Vector2.new(scroller.CanvasPosition.X, nextScroll)
					end
					local active = scrollbar.dragging or scrollbar.hovering
					local targetWidth = active and math.max(scrollbar.hoverThickness, scrollbar.idleThickness + S(1)) or math.max(scrollbar.idleThickness, S(4))
					local targetTrackTransparency = active and 0.38 or 0.58
					local targetThumbTransparency = active and scrollbar.hoverTransparency or scrollbar.idleTransparency
					local lerpAlpha = math.min(1, scrollbarDt * 14)
					scrollbar.currentWidth = scrollbar.currentWidth + ((targetWidth - scrollbar.currentWidth) * lerpAlpha)
					scrollbar.currentTrackTransparency = scrollbar.currentTrackTransparency + ((targetTrackTransparency - scrollbar.currentTrackTransparency) * lerpAlpha)
					scrollbar.currentThumbTransparency = scrollbar.currentThumbTransparency + ((targetThumbTransparency - scrollbar.currentThumbTransparency) * lerpAlpha)
					local width = math.max(1, math.floor(scrollbar.currentWidth + 0.5))
					local show = scrollable
					scrollbar.track.Visible = show
					if show then
						local alpha = math.clamp(scroller.CanvasPosition.Y / maxScroll, 0, 1)
						scrollbar.track.Size = UDim2.new(0, width, 1, -S(12))
						scrollbar.track.Position = UDim2.new(
							scroller.Position.X.Scale + scroller.Size.X.Scale,
							scroller.Position.X.Offset - width - S(4),
							scroller.Position.Y.Scale,
							scroller.Position.Y.Offset + S(6)
						)
						scrollbar.track.BackgroundTransparency = scrollbar.currentTrackTransparency
						scrollbar.thumb.Size = UDim2.new(1, 0, 0, thumbHeight)
						scrollbar.thumb.Position = UDim2.fromOffset(0, math.floor(usable * alpha + 0.5))
						scrollbar.thumb.BackgroundTransparency = scrollbar.currentThumbTransparency
					else
						scrollbar.currentWidth = math.max(scrollbar.idleThickness, S(4))
						scrollbar.currentTrackTransparency = 0.72
						scrollbar.currentThumbTransparency = scrollbar.idleTransparency
					end
				end
			else
				table.remove(OS_RAINBOW_SCROLLBARS, i)
			end
		end
		end
	end

	if walkSpeedEnabled and not (FREECAM and FREECAM.enabled) then
		local humanoid = getHumanoid()
		if humanoid and humanoid.WalkSpeed ~= walkSpeedValue then
			humanoid.WalkSpeed = walkSpeedValue
		end
		applyInstantWalkVelocity()
	end

	if espEnabled and rainbowTick >= OS_ESP_NEXT_UPDATE then
		OS_ESP_NEXT_UPDATE = rainbowTick + OS_ESP_UPDATE_INTERVAL
		local espAccent = OS_sampleRainbow(OS_RAINBOW_POINTS, rainbowTick * 0.18)
		local activePlayerCharacters = {} :: { [Model]: boolean }
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local char = plr.Character
				if char and char:IsA("Model") and alive(char) and (not PLAYERTOOLS or not PLAYERTOOLS.allowEspPlayer or PLAYERTOOLS.allowEspPlayer(plr)) then
					activePlayerCharacters[char] = true
					OS_trackPlayerEspCharacter(char)
					local hl = ensureHighlight(char)
					if hl then
						hl.FillColor = espAccent
						hl.OutlineColor = espAccent
					end
				else
					OS_forgetTrackedPlayerEspCharacter(char)
				end
			end
		end
		OS_sweepTrackedPlayerEspCharacters(activePlayerCharacters)
		if PLAYERTOOLS and PLAYERTOOLS.npcEspEnabled == true then
			for model in pairs(NPCTargets) do
				if alive(model) then
					local hl = ensureHighlight(model)
					if hl then
						hl.FillColor = espAccent
						hl.OutlineColor = espAccent
					end
				else
					removeHighlight(model)
				end
			end
		else
			for model in pairs(NPCTargets) do
				removeHighlight(model)
			end
		end
	end

	if aimEnabled then
		if not aimArmed then
			aimStop()
			return
		end

		if targetPart and not isAimTargetPartValid(targetPart) then
			if targetPlayer and targetPlayer.Parent ~= Players then
				aimLeaveBlockAcquire = true
			end
			clearAimTarget()
		end

		if not targetPart then
			tryAcquireAimTarget(selectedPartName)
			if not targetPart then
				destroyLaser()
				return
			end
		end

		if aimControlMode == "Mouse" then
			local aimScreenPoint, aimPosition = getAimLockScreenPoint(targetPart)
			if not aimPosition then
				destroyLaser()
				return
			end

			if aimScreenPoint then
				if not nudgeMouseToward(aimScreenPoint, dt) then
					applyCameraAim(aimPosition, dt)
				end
			else
				applyCameraAim(aimPosition, dt)
			end

			ensureLaser()
			updateLaserStart()
			setLaserEndPosition(aimPosition)
		else
			local aimPosition = getPredictedAimPosition(targetPart)
			applyCameraAim(aimPosition, dt)

			ensureLaser()
			updateLaserStart()
			setLaserEndPosition(aimPosition)
		end
	end
end

function OS_bindMainUpdate()
	pcall(function()
		RunService:UnbindToRenderStep(OS_MAIN_UPDATE_BIND_NAME)
	end)
	if OS_MAIN_UPDATE_CONN then
		OS_MAIN_UPDATE_CONN:Disconnect()
		OS_MAIN_UPDATE_CONN = nil
	end

	OS_MAIN_UPDATE_CONN = RunService.RenderStepped:Connect(OS_runMainUpdate)
end

OS_bindMainUpdate()

