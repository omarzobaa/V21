		end
	end
end))

for _, plr in ipairs(Players:GetPlayers()) do
	OS_bindPlayerCharacterLifecycle(plr)
end

OS_CONNECT(Players.PlayerAdded:Connect(function(plr)
	if not OS_EXEC_IS_CURRENT() then return end
	OS_bindPlayerCharacterLifecycle(plr)
	OS_ESP_NEXT_UPDATE = 0
end))

OS_CONNECT(RunService.Stepped:Connect(function(_, dt)
	if not OS_EXEC_IS_CURRENT() then return end
	if not noclipEnabled then return end
	for _, p in ipairs(noclipParts) do
		if p and p.Parent then
			applyNoclipToPart(p)
		end
	end

	local noclipCharacter = LocalPlayer.Character
	if not noclipCharacter then return end
	local noclipHumanoid = noclipCharacter:FindFirstChildOfClass("Humanoid")
	local noclipRoot = noclipCharacter:FindFirstChild("HumanoidRootPart")
	if not noclipHumanoid or not noclipRoot then return end
	if noclipHumanoid.MoveDirection.Magnitude <= 0.05 then return end

	local horizontalVelocity = Vector3.new(noclipRoot.AssemblyLinearVelocity.X, 0, noclipRoot.AssemblyLinearVelocity.Z)
	if horizontalVelocity.Magnitude > 1.5 then return end

	local noclipPush = math.max(0.2, math.min(0.75, (dt or 0.016) * math.max(noclipHumanoid.WalkSpeed, 16) * 0.9))
	noclipRoot.CFrame = noclipRoot.CFrame + (noclipHumanoid.MoveDirection.Unit * noclipPush)
end))

-- =========================
-- CLEANUP
-- =========================
OS_CONNECT(Players.PlayerRemoving:Connect(function(plr)
	if not OS_EXEC_IS_CURRENT() then return end
	OS_forgetTrackedPlayerEspCharacter(plr.Character)
	OS_disconnectPlayerCharacterLifecycle(plr)
	if PLAYERTOOLS and PLAYERTOOLS.onPlayerRemoving then
		PLAYERTOOLS.onPlayerRemoving(plr)
	end
	removeHighlight(plr)
	if targetPlayer == plr or (targetPart and plr.Character and targetPart:IsDescendantOf(plr.Character)) then
		aimLeaveBlockAcquire = true
		clearAimTarget()
		destroyLaser()
	end
end))

OS_CONNECT(LocalPlayer.CharacterAdded:Connect(function(character)
	if not OS_EXEC_IS_CURRENT() then return end
	removeAllHighlights()
	aimStop()
	storedWalkSpeed = nil
	storedJumpPower = nil
	storedUseJumpPower = nil
	INFINITE_JUMP_ARMED = true
	LAST_INFINITE_JUMP_AT = 0
	local humanoid = character:WaitForChild("Humanoid", 5)
	if walkSpeedEnabled and humanoid then
		applyWalkSpeed()
	end
	if jumpPowerEnabled and humanoid then
		applyJumpPower()
	end
	if humanoid and not (FREECAM and FREECAM.enabled) and not (PLAYERTOOLS and PLAYERTOOLS.spectateActive) then
		OS_restorePlayerCamera(humanoid)
	end
	if OS_POVCAM and OS_POVCAM.enabled then
		OS_applyPovCameraState()
	end
end))

OS_EXEC_GUARD.cleanup = function()
	pcall(function()
		ContextActionService:UnbindAction(OS_GUI_POINTER_BLOCK_ACTION)
	end)
	pcall(function()
		RunService:UnbindToRenderStep(OS_MAIN_UPDATE_BIND_NAME)
	end)
	pcall(function()
		if OS_MAIN_UPDATE_CONN then
			OS_MAIN_UPDATE_CONN:Disconnect()
			OS_MAIN_UPDATE_CONN = nil
		end
	end)
	pcall(function()
		if PLAYERTOOLS and PLAYERTOOLS.stopAll then
			PLAYERTOOLS.stopAll()
		end
	end)
	pcall(function()
		if FREECAM and FREECAM.stop then
			FREECAM.stop(false)
		end
	end)
	pcall(function()
		OS_cancelFreecamExitMouseReset()
	end)
	pcall(function()
		OS_applyPovCameraState(true)
	end)
	pcall(function()
		local state = getgenv()._osInspectorIntegratedInvis
		if type(state) == "table" and type(state.cleanup) == "function" then
			state.cleanup()
		end
	end)
	pcall(function()
		if type(setWalkSpeedEnabledState) == "function" then
			setWalkSpeedEnabledState(false, true)
		else
			walkSpeedEnabled = false
			applyWalkSpeed()
		end
	end)
	pcall(function()
		jumpPowerEnabled = false
		applyJumpPower()
	end)
	pcall(function()
		setFlingEnabled(false, true)
	end)
	pcall(function()
		setNoclipState(false)
	end)
	pcall(function()
		cleanupFly()
	end)
	pcall(function()
		aimStop()
	end)
	pcall(function()
		for plr in pairs(OS_PLAYER_CHARACTER_LIFECYCLE_CONNECTIONS) do
			OS_disconnectPlayerCharacterLifecycle(plr)
		end
	end)
	pcall(function()
		removeAllHighlights()
	end)
	pcall(function()
		destroyLaser()
	end)
	pcall(function()
		for _, conn in ipairs(OS_RUNTIME_CONNECTIONS) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		table.clear(OS_RUNTIME_CONNECTIONS)
	end)
	pcall(function()
		if gui and gui.Parent then
			gui:Destroy()
		end
	end)
	OS_EXEC_GUARD.lockUntil = 0
end

end

OS_initUiRuntimeTail()
