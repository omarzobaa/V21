-- Active tab mirror: add a row here any time a new feature gains state,
-- then update this refresh function so the tab stays a complete dashboard.
function OS_refreshStatusPage()
	invisState = getgenv()._osInspectorIntegratedInvis
	local activeCount = 0
	local function mark(labelText: string, enabled: boolean, activeText: string?, inactiveText: string?)
		OS_setStatusRow(labelText, enabled, activeText, inactiveText)
		if enabled then
			activeCount += 1
		end
	end
	local function hasEntries(t)
		return type(t) == "table" and next(t) ~= nil
	end
	local brightnessValue = BRIGHTNESS_CONTROL and BRIGHTNESS_CONTROL.value or 50
	local brightnessActive = math.floor((brightnessValue or 50) + 0.5) ~= 50
	local gravityActive = math.abs((gravityValue or GRAVITY_RESET_VALUE) - GRAVITY_RESET_VALUE) > 0.01
	local checkpointCount = PLAYERTOOLS and type(PLAYERTOOLS.checkpoints) == "table" and #PLAYERTOOLS.checkpoints or 0
	local aimFiltersActive = PLAYERTOOLS and (
		hasEntries(PLAYERTOOLS.exclusiveAimTargets)
		or hasEntries(PLAYERTOOLS.aimWhitelist)
		or hasEntries(PLAYERTOOLS.aimBlacklist)
	) or false
	local espFiltersActive = PLAYERTOOLS and (
		hasEntries(PLAYERTOOLS.exclusiveEspTargets)
		or hasEntries(PLAYERTOOLS.espWhitelist)
		or hasEntries(PLAYERTOOLS.espBlacklist)
	) or false

	mark("ESP", espEnabled)
	mark("ESP Armed", espArmed)
	mark("Aim", aimEnabled)
	mark("Aim Armed", aimArmed)
	OS_setStatusRow("Aim Mode", true, aimControlMode or "Camera")
	mark("Target Switch", aimTargetSwitchEnabled)
	mark("Noclip", noclipEnabled)
	mark("Noclip Armed", noclipArmed)
	mark("Invis", type(invisState) == "table" and invisState.on == true)
	mark("Invis Armed", invisArmed)
	mark("Walk Speed", walkSpeedEnabled, walkSpeedEnabled and tostring(walkSpeedValue) or nil)
	mark("Walk Armed", WALK_ARMED)
	mark("Walk Instant", walkSpeedInstant)
	mark("Fly", flyEnabled, flyEnabled and tostring(flySpeedValue) or nil)
	mark("Fly Armed", FLY_ARMED)
	mark("Infinite Jump", infiniteJumpEnabled)
	mark("Jump Power", jumpPowerEnabled, jumpPowerEnabled and tostring(jumpPowerValue) or nil)
	mark("Brightness", brightnessActive, ("%d%%"):format(math.floor((brightnessValue or 50) + 0.5)), "50%")
	mark("Gravity", gravityActive, tostring(math.floor((gravityValue or GRAVITY_RESET_VALUE) + 0.5)), tostring(GRAVITY_RESET_VALUE))
	mark("Aim Prediction", aimPredictionEnabled and aimPredictionValue > 0, aimPredictionEnabled and string.format("ON (%.3f)", aimPredictionValue) or "ON")
	OS_setStatusRow("Selected Hitbox", true, selectedPartName or "Head")
	mark("NPC ESP", PLAYERTOOLS and PLAYERTOOLS.npcEspEnabled == true)
	mark("NPC AIM", PLAYERTOOLS and PLAYERTOOLS.npcAimEnabled == true)
	mark("Fling", flingEnabled)
	mark("Fling Armed", flingArmed)
	mark("Teleport Armed", teleportArmed)
	mark("POV Camera", OS_POVCAM and OS_POVCAM.enabled == true)
	mark("Transparent Walls", OS_POVCAM and OS_POVCAM.transparentWalls == true)
	mark("Free Cam", FREECAM and FREECAM.enabled == true)
	mark("Track", PLAYERTOOLS and PLAYERTOOLS.trackModeActive == true)
	mark("Spectate", PLAYERTOOLS and PLAYERTOOLS.spectateActive == true)
	mark("Follow", PLAYERTOOLS and PLAYERTOOLS.followActive == true)
	mark("Return Position", PLAYERTOOLS and PLAYERTOOLS.returnCFrame ~= nil)
	mark("Checkpoints", checkpointCount > 0, tostring(checkpointCount), "0")
	mark("Aim Filters", aimFiltersActive)
	mark("ESP Filters", espFiltersActive)
	if OS_STATUS_ACTIVE_TEXT then
		local nextActiveText = "ON " .. tostring(activeCount)
		if OS_STATUS_ACTIVE_TEXT.Text ~= nextActiveText then
			OS_STATUS_ACTIVE_TEXT.Text = nextActiveText
		end
	end
end

OS_INDEX_ROWS = {}
OS_INDEX_EMPTY_LABEL = nil

function OS_indexMatches(query: string, haystack: string): boolean
	if query == "" then
		return true
	end
	return string.find(string.lower(haystack), query, 1, true) ~= nil
end

function OS_refreshIndexSearch(queryText: string?)
	local query = string.lower(tostring(queryText or "")):gsub("^%s+", ""):gsub("%s+$", "")
	local visibleCount = 0
	for _, item in ipairs(OS_INDEX_ROWS) do
		local visible = OS_indexMatches(query, item.searchText or "")
		item.row.Visible = visible
		if visible then
			visibleCount += 1
		end
	end
	if OS_INDEX_EMPTY_LABEL then
		OS_INDEX_EMPTY_LABEL.Visible = visibleCount == 0
	end
end

