function OS_initMainCardsLayout()
	buildAbsoluteSectionCards(pageMain)
	local mainCards = ABS_SECTION_CARDS and ABS_SECTION_CARDS[pageMain]
	local ARM_CARD_EXTRA = S(63)
	local aimSettingsExtraHeight = BUTTON_HEIGHT + S(13)
	local aimPredictionCardShift = (S(306) - S(17) - S(8) - S(8) - S(8)) + aimSettingsExtraHeight
	local cardExtraHeights = {
		[1] = ARM_CARD_EXTRA + 3 + S(40),
		[2] = S(10),
		[4] = S(10),
		[6] = S(10),
	}
	if mainCards and #mainCards >= 2 then
		local runningOffset = 0
		for i, card in ipairs(mainCards) do
			local pos = card.Position
			local yOffset = runningOffset
			if i == 1 then
				yOffset -= S(5)
			end
			if i > 1 then
				yOffset += aimPredictionCardShift
			end
			card.Position = UDim2.new(
				pos.X.Scale,
				pos.X.Offset,
				pos.Y.Scale,
				pos.Y.Offset + yOffset
			)
			local extraHeight = cardExtraHeights[i] or 0
			if extraHeight ~= 0 then
				card.Size = UDim2.new(
					card.Size.X.Scale,
					card.Size.X.Offset,
					card.Size.Y.Scale,
					card.Size.Y.Offset + extraHeight
				)
				runningOffset += extraHeight
			end
		end
		OS_AIM_PREDICTION_CARD = OS_makeStyledCard(
			pageMain,
			mainCards[1].Position.Y.Offset + mainCards[1].Size.Y.Offset + S(5),
			S(264) + aimSettingsExtraHeight
		)
		if teleportArmCtl and teleportArmCtl.row then
			teleportArmCtl.row.Parent = mainCards[1]
			teleportArmCtl.row.Position = UDim2.fromOffset(S(4), S(225))
		end
		if npcEspBtn and npcAimBtn then
			npcEspBtn.Parent = mainCards[1]
			npcAimBtn.Parent = mainCards[1]
			npcEspBtn.Position = UDim2.new(0, S(4), 0, S(264))
			npcAimBtn.Position = UDim2.new(0.51, 0, 0, S(264))
		end
		scheduleRefreshMainCanvasSize()
	end
end
