local function alive(char: Model?)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

function OS_getLivePlayerCharacter(plr: Player?): Model?
	local char = plr and plr.Character
	if char and char:IsA("Model") and alive(char) then
		return char
	end
	return nil
end

local function pointToRayDistance(origin: Vector3, dirUnit: Vector3, point: Vector3)
	local v = point - origin
	local t = v:Dot(dirUnit)
	if t <= 0 or t > MAX_RAY_DISTANCE then
		return math.huge, t
	end
	local closest = origin + dirUnit * t
	return (point - closest).Magnitude, t
end

local function getCharPart(char: Model, name: string): BasePart?
	local p = char:FindFirstChild(name)
	if p and p:IsA("BasePart") then return p end

	if name == "UpperTorso" or name == "LowerTorso" then
		local torso = char:FindFirstChild("Torso")
		if torso and torso:IsA("BasePart") then return torso end
	end
	if name == "Torso" then
		local ut = char:FindFirstChild("UpperTorso")
		if ut and ut:IsA("BasePart") then return ut end
		local lt = char:FindFirstChild("LowerTorso")
		if lt and lt:IsA("BasePart") then return lt end
	end
	return nil
end

local function getAimCandidatePart(model: Model, preferredName: string): BasePart?
	local preferred = getCharPart(model, preferredName)
	if preferred then
		return preferred
	end

	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end

	return getCharPart(model, "Head")
		or getCharPart(model, "UpperTorso")
		or getCharPart(model, "Torso")
		or getCharPart(model, "LowerTorso")
end

function getPredictedAimPosition(part: BasePart): Vector3
	if not aimPredictionEnabled or aimPredictionValue <= 0 then
		return part.Position
	end

	local velocityPart = part
	local model = part.Parent
	if model and model:IsA("Model") then
		velocityPart = model:FindFirstChild("HumanoidRootPart")
			or model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Torso")
			or part
	end

	local velocity = velocityPart.AssemblyLinearVelocity
	local cameraLook = Camera.CFrame.LookVector
	local screenPlaneVelocity = velocity - (cameraLook * velocity:Dot(cameraLook))
	if screenPlaneVelocity.Magnitude <= 0.05 then
		return part.Position
	end

	return part.Position + (screenPlaneVelocity.Unit * aimPredictionValue)
end

local function getAimSmoothnessAlpha(dt: number?): number
	if aimSmoothnessValue <= 0 then
		return 1
	end

	local normalized = math.clamp(aimSmoothnessValue / AIM_SMOOTHNESS_SLIDER_MAX, 0, 1)
	local response = 28 - (24 * (normalized ^ 1.35))
	return math.clamp((dt or (1 / 60)) * response, 0.04, 1)
end

local function getMouseViewportPosition(): Vector2
	local topLeftInset = select(1, GuiService:GetGuiInset())
	return UserInputService:GetMouseLocation() - topLeftInset
end

local function worldToAimScreenPoint(worldPosition: Vector3, allowOffscreen: boolean?): (Vector2?, boolean)
	local screenPos, onScreen = Camera:WorldToScreenPoint(worldPosition)
	if screenPos.Z <= 0 then
		return nil, false
	end
	if not onScreen and not allowOffscreen then
		return nil, false
	end

	local cameraSpace = Camera.CFrame:PointToObjectSpace(worldPosition)
	if cameraSpace.Z > 0 then
		screenPos = Vector3.new(
			Camera.ViewportSize.X - screenPos.X,
			Camera.ViewportSize.Y - screenPos.Y,
			screenPos.Z
		)
	end

	return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function isAimTargetPartValid(part: BasePart?): boolean
	if not part or not part.Parent or not part:IsDescendantOf(Workspace) then
		return false
	end

	local model = part.Parent
	if not model:IsA("Model") or not alive(model) then
		return false
	end

	local owner = Players:GetPlayerFromCharacter(model)
	if owner then
		if owner == LocalPlayer or owner.Parent ~= Players then
			return false
		end
		if PLAYERTOOLS and PLAYERTOOLS.allowAimPlayer and not PLAYERTOOLS.allowAimPlayer(owner) then
			return false
		end
		if part == targetPart then
			return targetModel == model and targetPlayer == owner and owner.Character == model
		end
		return owner.Character == model
	end

	if PLAYERTOOLS and PLAYERTOOLS.npcAimEnabled == false then
		return false
	end
	if part == targetPart and targetModel ~= model then
		return false
	end

	return NPCTargets[model] == true
end

local function resetAimMouseController()
	aimMouseCarry = Vector2.zero
	aimMouseLastDelta = nil
end

local function clearAimTarget()
	resetAimMouseController()
	targetPart = nil
	targetModel = nil
	targetPlayer = nil
end

local function setAimTarget(part: BasePart?): BasePart?
	if not part or not part.Parent or not part.Parent:IsA("Model") then
		clearAimTarget()
		return nil
	end

	if targetPart ~= part then
		resetAimMouseController()
	end
	targetPart = part
	targetModel = part.Parent
	targetPlayer = Players:GetPlayerFromCharacter(targetModel)
	return targetPart
end

-- Mouse-lock rides Roblox's own cursor behavior, so zoom/camera state naturally
-- becomes the "center vs free mouse" switch without extra mode toggles.
local function getAimLockScreenPoint(part: BasePart): (Vector2?, Vector3?)
	local aimPosition = getPredictedAimPosition(part)
	local aimScreenPoint = worldToAimScreenPoint(aimPosition, true)
	return aimScreenPoint, aimPosition
end

local function quantizeMouseAxis(value: number): number
	if value > 0 then
		return math.floor(value)
	end
	if value < 0 then
		return math.ceil(value)
	end
	return 0
end

local function nudgeMouseToward(screenPoint: Vector2, dt: number?): boolean
	if type(mousemoverel) ~= "function" then
		return false
	end

	local mousePos = getMouseViewportPosition()
	local mouseDelta = screenPoint - mousePos
	local distance = mouseDelta.Magnitude
	if distance <= AIM_MOUSE_SETTLE_RADIUS then
		aimMouseCarry = Vector2.zero
		aimMouseLastDelta = mouseDelta
		return true
	end

	local smoothnessAlpha = getAimSmoothnessAlpha(dt)
	local baseAlpha = AIM_MOUSE_RESPONSE_FLOOR + ((AIM_MOUSE_RESPONSE_CEILING - AIM_MOUSE_RESPONSE_FLOOR) * smoothnessAlpha)
	local catchUpAlpha = math.clamp((distance - AIM_MOUSE_SETTLE_RADIUS) / AIM_MOUSE_CATCHUP_DISTANCE, 0, 1)
	local moveAlpha = math.clamp(
		baseAlpha + ((AIM_MOUSE_RESPONSE_CEILING - baseAlpha) * catchUpAlpha),
		AIM_MOUSE_RESPONSE_FLOOR,
		AIM_MOUSE_RESPONSE_CEILING
	)

	if aimMouseLastDelta and aimMouseLastDelta:Dot(mouseDelta) <= 0 then
		moveAlpha = math.min(moveAlpha, AIM_MOUSE_REVERSAL_BRAKE)
	end

	if moveAlpha <= 0.01 then
		aimMouseCarry = Vector2.zero
		aimMouseLastDelta = mouseDelta
		return true
	end

	local moveX = quantizeMouseAxis(mouseDelta.X * moveAlpha)
	local moveY = quantizeMouseAxis(mouseDelta.Y * moveAlpha)

	if moveX == 0 and moveY == 0 then
		aimMouseCarry = Vector2.zero
		if distance >= AIM_MOUSE_FORCE_STEP_DISTANCE then
			if math.abs(mouseDelta.X) >= math.abs(mouseDelta.Y) then
				moveX = mouseDelta.X >= 0 and 1 or -1
			else
				moveY = mouseDelta.Y >= 0 and 1 or -1
			end
		else
			aimMouseLastDelta = mouseDelta
			return true
		end
	end

	aimMouseCarry = Vector2.zero
	mousemoverel(moveX, moveY)
	aimMouseLastDelta = mouseDelta
	return true
end

NPCTargets = NPCTargets or {}
OS_NPC_REBUILD_CHUNK = 100
OS_NPC_REBUILD_RUNNING = false
function OS_npcFeaturesActive(): boolean
	return PLAYERTOOLS
		and (PLAYERTOOLS.npcEspEnabled == true or PLAYERTOOLS.npcAimEnabled == true)
		or false
end
local function getNpcCorePart(model: Model)
	return model:FindFirstChild("HumanoidRootPart")
		or getCharPart(model, "Head")
		or getCharPart(model, "Torso")
		or getCharPart(model, "UpperTorso")
		or getCharPart(model, "LowerTorso")
end
local function trackNpcModel(model)
	if not model or not model:IsA("Model") or model == LocalPlayer.Character or Players:GetPlayerFromCharacter(model) then
		NPCTargets[model] = nil
		return
	end
	if model:FindFirstChildOfClass("Humanoid") and getNpcCorePart(model) then
		NPCTargets[model] = true
	else
		NPCTargets[model] = nil
	end
end
local function rebuildNpcTargets()
	if OS_NPC_REBUILD_RUNNING then
		return
	end
	if not OS_npcFeaturesActive() then
		table.clear(NPCTargets)
		return
	end
	OS_NPC_REBUILD_RUNNING = true
	table.clear(NPCTargets)
	local stack = { Workspace }
	local processed = 0
	while #stack > 0 do
		if not OS_EXEC_IS_CURRENT() then
			OS_NPC_REBUILD_RUNNING = false
			return
		end
		local current = table.remove(stack)
		for _, child in ipairs(current:GetChildren()) do
			processed += 1
			if child:IsA("Humanoid") then
				trackNpcModel(child.Parent)
			end
			table.insert(stack, child)
			if processed % OS_NPC_REBUILD_CHUNK == 0 then
				task.wait()
				if not OS_EXEC_IS_CURRENT() then
					OS_NPC_REBUILD_RUNNING = false
					return
				end
			end
		end
	end
	OS_NPC_REBUILD_RUNNING = false
end
local function requestNpcTargetsRebuild()
	if OS_NPC_REBUILD_RUNNING or not OS_npcFeaturesActive() then
		return
	end
	task.defer(rebuildNpcTargets)
end
table.clear(NPCTargets)
OS_CONNECT(Workspace.DescendantAdded:Connect(function(desc)
	if not OS_npcFeaturesActive() then
		return
	end
	if desc:IsA("Humanoid") then
		task.defer(trackNpcModel, desc.Parent)
	elseif desc:IsA("Model") then
		task.defer(trackNpcModel, desc)
	elseif desc:IsA("BasePart") and (
		desc.Name == "HumanoidRootPart"
		or desc.Name == "Head"
		or desc.Name == "Torso"
		or desc.Name == "UpperTorso"
		or desc.Name == "LowerTorso"
	) then
		task.defer(trackNpcModel, desc:FindFirstAncestorOfClass("Model"))
	end
end))
OS_CONNECT(Workspace.DescendantRemoving:Connect(function(desc)
	if not OS_npcFeaturesActive() and next(NPCTargets) == nil then
		return
	end
	if desc:IsA("Humanoid") then
		local model = desc.Parent
		if model then
			NPCTargets[model] = nil
		end
	elseif desc:IsA("Model") then
		NPCTargets[desc] = nil
	elseif desc:IsA("BasePart") and (
		desc.Name == "HumanoidRootPart"
