local function collectPovOccludingParts(): { [BasePart]: boolean }
	local visibleNow = {} :: { [BasePart]: boolean }
	local currentCamera = OS_syncCurrentCamera()
	local hum = getHumanoid()
	local root = hum and (hum.RootPart or (hum.Parent and hum.Parent:FindFirstChild("HumanoidRootPart")))
	if not (currentCamera and root and root.Parent) then
		return visibleNow
	end

	local targetPoints = { root.Position }
	local character = hum.Parent
	if character and character:IsA("Model") then
		local head = character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			table.insert(targetPoints, head.Position)
		end
		local upperTorso = character:FindFirstChild("UpperTorso")
		if upperTorso and upperTorso:IsA("BasePart") then
			table.insert(targetPoints, upperTorso.Position)
		end
	end

	local cameraObstructions = currentCamera:GetPartsObscuringTarget(targetPoints, { LocalPlayer.Character })
	for _, part in ipairs(cameraObstructions) do
		if part and part:IsA("BasePart") and not part:IsDescendantOf(LocalPlayer.Character) then
			markPovTransparent(part)
			visibleNow[part] = true
		end
	end
	if next(visibleNow) then
		return visibleNow
	end

	local origin = currentCamera.CFrame.Position
	local targetPos = root.Position
	local dir = targetPos - origin
	local totalDist = dir.Magnitude
	if totalDist < 0.5 then
		return visibleNow
	end

	local dirUnit = dir / totalDist
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist
	rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
	rayParams.IgnoreWater = true

	local remaining = totalDist
	local currentOrigin = origin
	while remaining > 0 do
		local result = Workspace:Raycast(currentOrigin, dirUnit * remaining, rayParams)
		if not result or not result.Instance then
			break
		end
		local hit = result.Instance
		if hit:IsA("BasePart") then
			markPovTransparent(hit)
			visibleNow[hit] = true
		end
		local step = math.clamp(result.Distance + 0.6, 0.6, remaining)
		currentOrigin = currentOrigin + (dirUnit * step)
		remaining -= step
	end
	return visibleNow
end

local function applyPovVisibleSet(visibleSet: { [BasePart]: boolean })
	for part, original in pairs(OS_POVCAM_TRANSPARENCY.original) do
		if not visibleSet[part] then
			if part and part.Parent then
				part.LocalTransparencyModifier = original
			end
			OS_POVCAM_TRANSPARENCY.original[part] = nil
			OS_POVCAM_TRANSPARENCY.touched[part] = nil
		end
	end
	table.clear(OS_POVCAM_TRANSPARENCY.visibleNow)
	for part in pairs(visibleSet) do
		OS_POVCAM_TRANSPARENCY.visibleNow[part] = true
	end
end

