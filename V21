OS_CONNECT(UserInputService.InputBegan:Connect(function(input, gp)
	if not OS_EXEC_IS_CURRENT() then return end
	if OS_isStrongGuiPointerInput(input) then return end


	local aimBindPressed = matchesBind(input, aimBind)
	local teleportBindPressed = matchesBind(input, teleportBind)
	if gp and input.UserInputType ~= Enum.UserInputType.Keyboard and not aimBindPressed and not teleportBindPressed then return end
	if UserInputService:GetFocusedTextBox() then return end
	if waitingFor then return end
	if FREECAM and FREECAM.enabled then return end

	local teleportMouseLocation = nil
	if teleportBindPressed and input.UserInputType ~= Enum.UserInputType.Keyboard then
		teleportMouseLocation = Vector2.new(input.Position.X, input.Position.Y)
	end

	if teleportBindPressed and OS_tryClickTeleport(teleportMouseLocation) then
		pulseUI()
		return
	end

	if walkSpeedEnabled and input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.W
			or input.KeyCode == Enum.KeyCode.A
			or input.KeyCode == Enum.KeyCode.S
			or input.KeyCode == Enum.KeyCode.D
			or input.KeyCode == Enum.KeyCode.Up
			or input.KeyCode == Enum.KeyCode.Left
			or input.KeyCode == Enum.KeyCode.Down
			or input.KeyCode == Enum.KeyCode.Right then
			applyWalkSpeed()
		end
	end

	if matchesBind(input, espBind) then
		if not espArmed then
			return
		end
		espEnabled = not espEnabled
		if not espEnabled then
			removeAllHighlights()
		else
			OS_ESP_NEXT_UPDATE = 0
			pulseUI()
		end
	end

	if aimBindPressed then
		if not aimArmed then
			return
		end
		pulseUI()
		aimStart()
	end

	if matchesBind(input, noclipBind) then
		if not noclipArmed then
			return
		end
		setNoclipState(not noclipEnabled)
		pulseUI()
	end

	if matchesBind(input, walkBind) then
		if not (FREECAM and FREECAM.enabled) then
			if not WALK_ARMED then
				return
			end
			if bindEquals(walkBind, flyBind) then
				showBindError("Walk and Fly cannot share the same bind.")
			else
				setWalkSpeedEnabledState(not walkSpeedEnabled)
			end
		end
	end

	if matchesBind(input, flyBind) then
		if not (FREECAM and FREECAM.enabled) then
			if not FLY_ARMED then
				return
			end
			if bindEquals(walkBind, flyBind) then
				showBindError("Walk and Fly cannot share the same bind.")
			else
				setFlyEnabledState(not flyEnabled)
			end
		end
	end

	if matchesBind(input, invisBind) then
		if not invisArmed then
			return
		end
		toggleIntegratedInvis()
		pulseUI()
	end

	if matchesBind(input, flingBind) then
		if not flingArmed then
			return
		end
		setFlingEnabled(not flingEnabled)
	end
end))

