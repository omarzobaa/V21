function OS_createStatusRow(parent: Instance, labelText: string)
	statusRow = mk("Frame", {
		Size = UDim2.new(1, 0, 0, S(34)),
		BackgroundColor3 = THEME_CARD_ALT,
		BorderSizePixel = 0,
		ZIndex = 54,
		Parent = parent,
	})
	mk("UICorner", { CornerRadius = UDim.new(0, S(12)), Parent = statusRow })
	mk("UIStroke", { Thickness = 1, Color = THEME_STROKE, Transparency = 0.36, Parent = statusRow })
	mk("TextLabel", {
		Size = UDim2.new(0.58, 0, 1, 0),
		Position = UDim2.fromOffset(S(12), 0),
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = labelText,
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(21),
		TextColor3 = THEME_TEXT,
		ZIndex = 55,
		Parent = statusRow,
	})
	statusPill = mk("Frame", {
		Size = UDim2.fromOffset(S(94), S(22)),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -S(10), 0.5, 0),
		BackgroundColor3 = REBIND_BG_IDLE,
		BorderSizePixel = 0,
		ZIndex = 55,
		Parent = statusRow,
	})
	mk("UICorner", { CornerRadius = UDim.new(0, S(11)), Parent = statusPill })
	statusStroke = mk("UIStroke", { Thickness = 1, Color = THEME_STROKE, Transparency = 0.22, Parent = statusPill })
	statusValue = mk("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "OFF",
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(21),
		TextColor3 = THEME_MUTED,
		ZIndex = 56,
		Parent = statusPill,
	})
	OS_STATUS_ROWS[labelText] = {
		value = statusValue,
		pill = statusPill,
		stroke = statusStroke,
	}
	return statusRow
end

function OS_setStatusRow(labelText: string, enabled: boolean, activeText: string?, inactiveText: string?)
	statusRow = OS_STATUS_ROWS and OS_STATUS_ROWS[labelText]
	if not statusRow then return end
	local nextText = enabled and (activeText or "ON") or (inactiveText or "OFF")
	if statusRow.lastEnabled == enabled and statusRow.lastText == nextText then
		return
	end
	statusRow.lastEnabled = enabled
	statusRow.lastText = nextText
	statusRow.value.Text = nextText
	statusRow.value.TextColor3 = enabled and THEME_TEXT or THEME_MUTED
	OS_setAccentGradientEnabled(statusRow.pill, enabled, "Background", REBIND_BG_IDLE, nil, true)
	OS_setAccentGradientEnabled(statusRow.stroke, enabled, "Stroke", THEME_STROKE, 0.22)
end

