end))
task.spawn(function()
	while OS_EXEC_IS_CURRENT() do
		local npcFeaturesActive = OS_npcFeaturesActive()
		if npcFeaturesActive or next(NPCTargets) ~= nil then
			for model in pairs(NPCTargets) do
