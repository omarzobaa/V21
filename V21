				titleGradient.Enabled = true
			end

			titleButton.MouseButton1Click:Connect(function()
				titleGradient.Enabled = false
				titleButton.Visible = false
				titleEdit.Visible = true
				titleEdit:CaptureFocus()
				titleEdit.CursorPosition = #titleEdit.Text + 1
			end)

			titleEdit.Focused:Connect(function()
				dragLock = true
			end)
			titleEdit.FocusLost:Connect(function()
				finishEditingCheckpointName()
			end)
			titleEdit:GetPropertyChangedSignal("Text"):Connect(function()
				if titleEdit.Visible then
					titleButton.Text = titleEdit.Text
				end
			end)

			removeBtn.MouseButton1Click:Connect(function()
				for i, savedCheckpoint in ipairs(PLAYERTOOLS.checkpoints) do
					if savedCheckpoint == checkpointData or savedCheckpoint.index == checkpointIndex then
						table.remove(PLAYERTOOLS.checkpoints, i)
						break
					end
				end
				card:Destroy()
			end)

			actionBtn.MouseButton1Click:Connect(function()
				local checkpointName = getCheckpointName()
				if FREECAM and FREECAM.enabled and FREECAM.stop then
					FREECAM.stop()
				end
				if PLAYERTOOLS and PLAYERTOOLS.stopAll then
					PLAYERTOOLS.stopAll()
				end
				local localRoot = OS_playerToolsGetLocalRoot()
				if not localRoot then
					statusLabel.Text = "Your character is not ready"
					statusLabel.TextColor3 = OS_PLAYERTOOLS_ERROR_COLOR
					return
				end
				if checkpointData.cframe then
					OS_playerToolsTeleportLocalRoot(localRoot, checkpointData.cframe)
					statusLabel.Text = "Teleported to " .. checkpointName
					statusLabel.TextColor3 = OS_PLAYERTOOLS_FOUND_COLOR
					return
				end
				checkpointData.cframe = OS_playerToolsGetLocalRootCFrame(localRoot)
				actionBtn.Text = "Teleport"
				setPillToggleVisual(actionBtn, true)
				statusLabel.Text = checkpointName .. " saved"
				statusLabel.TextColor3 = OS_PLAYERTOOLS_FOUND_COLOR
			end)
		end
		PLAYERTOOLS.createCheckpointCard = createCheckpointCard

		addCheckpointBtn.MouseButton1Click:Connect(function()
			createCheckpointCard(nil)
		end)
		for _, checkpointData in ipairs(PLAYERTOOLS.checkpoints) do
			createCheckpointCard(checkpointData)
		end
end

function OS_installPlayerToolMethods()
	function PLAYERTOOLS.refreshTrackButtons()
		if not PLAYERTOOLS.trackAction then return end
		local action = PLAYERTOOLS.trackAction
		action.button.Text = PLAYERTOOLS.trackModeActive and "Untrack" or "Track"
		setPillToggleVisual(action.button, PLAYERTOOLS.trackModeActive)
		if action.overlay then
			action.overlay.Visible = PLAYERTOOLS.trackModeActive == true
		end
		if action.followButton then
			action.followButton.Text = PLAYERTOOLS.followActive and "Stop Follow" or "Follow TP"
			setPillToggleVisual(action.followButton, PLAYERTOOLS.followActive)
		end
		if action.returnButton then
			setPillToggleVisual(action.returnButton, PLAYERTOOLS.returnCFrame ~= nil)
		end
	end

	function PLAYERTOOLS.stopSpectate(statusText: string?, statusColor: Color3?)
		PLAYERTOOLS.spectateActive = false
		PLAYERTOOLS.spectateTarget = nil
		PLAYERTOOLS.trackModeActive = PLAYERTOOLS.followActive == true
		OS_restorePlayerCamera()
		if PLAYERTOOLS.spectateAction then
			if statusText then
				PLAYERTOOLS.spectateAction.setStatus(statusText, statusColor or OS_PLAYERTOOLS_NEUTRAL_COLOR)
			end
		end
		PLAYERTOOLS.refreshTrackButtons()
	end

	function PLAYERTOOLS.stopFollow(statusText: string?, statusColor: Color3?)
		PLAYERTOOLS.followActive = false
		PLAYERTOOLS.followTarget = nil
		PLAYERTOOLS.trackModeActive = PLAYERTOOLS.spectateActive == true
		if not PLAYERTOOLS.spectateActive then
			OS_restorePlayerCamera()
		end
		if PLAYERTOOLS.followAction then
			if statusText then
				PLAYERTOOLS.followAction.setStatus(statusText, statusColor or OS_PLAYERTOOLS_NEUTRAL_COLOR)
			end
		end
		PLAYERTOOLS.refreshTrackButtons()
	end

	PLAYERTOOLS.stopAll = function()
		PLAYERTOOLS.stopSpectate("Spectate idle", OS_PLAYERTOOLS_NEUTRAL_COLOR)
		PLAYERTOOLS.stopFollow("Follow idle", OS_PLAYERTOOLS_NEUTRAL_COLOR)
		PLAYERTOOLS.trackModeActive = false
		PLAYERTOOLS.refreshTrackButtons()
	end

	function PLAYERTOOLS.returnToSavedPosition()
		if PLAYERTOOLS.followActive then
			PLAYERTOOLS.stopFollow("Follow idle", OS_PLAYERTOOLS_NEUTRAL_COLOR)
		end
		local localRoot = OS_playerToolsGetLocalRoot()
		if not localRoot then
			return false, "Your character is not ready"
		end
		if not PLAYERTOOLS.returnCFrame then
			return false, "No saved position yet"
		end
		OS_playerToolsTeleportLocalRoot(localRoot, PLAYERTOOLS.returnCFrame)
		return true, "Returned to saved spot"
	end

	function PLAYERTOOLS.refreshReturnButtons()
		local canReturn = PLAYERTOOLS.returnCFrame ~= nil
		local overlayReturnButton = PLAYERTOOLS.trackAction and PLAYERTOOLS.trackAction.returnButton
		if PLAYERTOOLS.teleportReturnButton then
			PLAYERTOOLS.teleportReturnButton.Visible = PLAYERTOOLS.teleportReturnButton == overlayReturnButton or canReturn
			setPillToggleVisual(PLAYERTOOLS.teleportReturnButton, canReturn)
		end
		if PLAYERTOOLS.followReturnButton and PLAYERTOOLS.followReturnButton ~= PLAYERTOOLS.teleportReturnButton then
			PLAYERTOOLS.followReturnButton.Visible = PLAYERTOOLS.followReturnButton == overlayReturnButton or canReturn
			setPillToggleVisual(PLAYERTOOLS.followReturnButton, canReturn)
		end
	end

	function PLAYERTOOLS.startSpectate(plr: Player)
		if FREECAM and FREECAM.enabled and FREECAM.stop then
			FREECAM.stop(false)
		end
		local hum = OS_playerToolsGetPlayerHumanoid(plr)
		if not hum then
			PLAYERTOOLS.spectateAction.setStatus("Target is not spawned yet", OS_PLAYERTOOLS_ERROR_COLOR)
			return
		end
		PLAYERTOOLS.spectateTarget = plr
		PLAYERTOOLS.spectateActive = true
		PLAYERTOOLS.trackModeActive = true
		PLAYERTOOLS.trackTarget = plr
		if PLAYERTOOLS.followActive then
			PLAYERTOOLS.followTarget = plr
		end
		OS_syncCurrentCamera()
		Camera.CameraType = Enum.CameraType.Custom
		Camera.CameraSubject = hum
		if PLAYERTOOLS.trackAction then
			PLAYERTOOLS.trackAction.setSelected(plr)
		end
		PLAYERTOOLS.spectateAction.setStatus("Spectating: " .. OS_playerToolsFormatPlayer(plr), OS_PLAYERTOOLS_FOUND_COLOR)
		PLAYERTOOLS.refreshTrackButtons()
	end

	function PLAYERTOOLS.startFollow(plr: Player)
		if FREECAM and FREECAM.enabled and FREECAM.stop then
			FREECAM.stop(false)
		end
		local localRoot = OS_playerToolsGetLocalRoot()
		if not localRoot then
			PLAYERTOOLS.followAction.setStatus("Your character is not ready", OS_PLAYERTOOLS_ERROR_COLOR)
			return
		end
		if not OS_playerToolsGetPlayerRoot(plr) then
			PLAYERTOOLS.followAction.setStatus("Target is not spawned yet", OS_PLAYERTOOLS_ERROR_COLOR)
			return
		end
		if not PLAYERTOOLS.followActive then
			PLAYERTOOLS.returnCFrame = OS_playerToolsGetLocalRootCFrame(localRoot)
		end
		PLAYERTOOLS.refreshReturnButtons()
		PLAYERTOOLS.followTarget = plr
		PLAYERTOOLS.followActive = true
		PLAYERTOOLS.trackModeActive = true
		PLAYERTOOLS.trackTarget = plr
		if PLAYERTOOLS.trackAction then
			PLAYERTOOLS.trackAction.setSelected(plr)
		end
		if not PLAYERTOOLS.spectateActive or PLAYERTOOLS.spectateTarget ~= plr then
			PLAYERTOOLS.startSpectate(plr)
		end
		PLAYERTOOLS.followAction.setStatus("Following: " .. OS_playerToolsFormatPlayer(plr), OS_PLAYERTOOLS_FOUND_COLOR)
		PLAYERTOOLS.refreshTrackButtons()
	end

	function PLAYERTOOLS.teleportToPlayer(plr: Player)
		if FREECAM and FREECAM.enabled and FREECAM.stop then
			FREECAM.stop(false)
		end
		local localRoot = OS_playerToolsGetLocalRoot()
		if not localRoot then
			PLAYERTOOLS.teleportAction.setStatus("Your character is not ready", OS_PLAYERTOOLS_ERROR_COLOR)
			return
		end
		local targetRoot = OS_playerToolsGetPlayerRoot(plr)
		if not targetRoot then
			PLAYERTOOLS.teleportAction.setStatus("Target is not spawned yet", OS_PLAYERTOOLS_ERROR_COLOR)
			return
		end
		PLAYERTOOLS.returnCFrame = OS_playerToolsGetLocalRootCFrame(localRoot)
		PLAYERTOOLS.refreshReturnButtons()
		OS_playerToolsTeleportLocalRoot(localRoot, OS_playerToolsGetBehindTargetCFrame(targetRoot, 1.2))
		PLAYERTOOLS.trackTarget = plr
		if PLAYERTOOLS.trackAction then
			PLAYERTOOLS.trackAction.setSelected(plr)
		end
		if PLAYERTOOLS.trackModeActive and (not PLAYERTOOLS.spectateActive or PLAYERTOOLS.spectateTarget ~= plr) then
			PLAYERTOOLS.startSpectate(plr)
		end
		PLAYERTOOLS.teleportAction.setStatus("Teleported to: " .. OS_playerToolsFormatPlayer(plr), OS_PLAYERTOOLS_FOUND_COLOR)
		PLAYERTOOLS.refreshTrackButtons()
	end
end

