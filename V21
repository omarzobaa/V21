		mk("UIStroke", { Thickness = 1, Color = THEME_STROKE, Transparency = 0.15, Parent = valueBox })

		local errorLabel = mk("TextLabel", {
			Size = UDim2.new(0.32, 0, 0, S(14)),
			Position = UDim2.new(0.68, 0, 0, S(29)),
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
