OS_GUI_POINTER_BLOCK_ACTION = ("OSGuiPointerBlock_%s_%s"):format(LocalPlayer.UserId, tostring(OS_EXEC_ID))

-- Pointer-area input guard. Keep Roblox GuiButton.Modal off here: Modal can
-- steal camera drag globally; local hit tests are enough for Fracture controls.
function OS_registerStrongGuiSurface(obj: Instance?)
	if obj and obj:IsA("GuiObject") then
		obj.Active = true
		pcall(function()
			obj.Selectable = false
		end)
		pcall(function()
			obj.Modal = false
		end)
		obj:SetAttribute("StrongGuiSurface", true)
		table.insert(OS_STRONG_GUI_SURFACES, obj)
	end
	return obj
end

function OS_isGuiObjectVisibleInTree(obj: GuiObject?)
	if not (obj and obj.Parent and obj.Visible) then
		return false
	end
	local current = obj.Parent
	while current do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		if current:IsA("ScreenGui") and not current.Enabled then
			return false
		end
		current = current.Parent
	end
	return true
end

function OS_getInputScreenPoint(input: InputObject?)
	if input and input.Position then
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	return UserInputService:GetMouseLocation()
end

function OS_pointInsideStrongGuiObject(obj: GuiObject?, point: Vector2?)
	if not point or not OS_isGuiObjectVisibleInTree(obj) then
		return false
	end
	local absPos = obj.AbsolutePosition
	local absSize = obj.AbsoluteSize
	if absSize.X <= 0 or absSize.Y <= 0 then
		return false
	end
	return point.X >= absPos.X
		and point.X <= absPos.X + absSize.X
		and point.Y >= absPos.Y
		and point.Y <= absPos.Y + absSize.Y
end

function OS_isStrongGuiInputType(input: InputObject?)
	if not input then
		return false
	end
	local inputType = input.UserInputType
	return inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton3
		or inputType == Enum.UserInputType.Touch
end

function OS_isPointOverStrongGui(point: Vector2?)
	if not (gui and gui.Enabled and point) then
		return false
	end
	for i = #OS_STRONG_GUI_SURFACES, 1, -1 do
		local surface = OS_STRONG_GUI_SURFACES[i]
		if not (surface and surface.Parent) then
			table.remove(OS_STRONG_GUI_SURFACES, i)
		elseif OS_pointInsideStrongGuiObject(surface, point) then
			return true
		end
	end
	return false
end

function OS_isStrongGuiPointerInput(input: InputObject?)
	return OS_isStrongGuiInputType(input) and OS_isPointOverStrongGui(OS_getInputScreenPoint(input))
end

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local rainbowStrokes = {} :: { UIStroke }
local rainbowFrames = {} :: { Frame }
OS_RAINBOW_SCROLLBARS = {}
OS_RAINBOW_GRADIENTS = {}
OS_RAINBOW_NATIVE_SCROLLBARS = {}
OS_ACTIVE_RAINBOW_GRADIENTS = {}
OS_ACTIVE_RAINBOW_NATIVE_SCROLLBARS = {}
OS_RAINBOW_TARGETS_DIRTY = true
OS_RAINBOW_TARGET_SWEEP_INTERVAL = 0.5
OS_RAINBOW_TARGET_SWEEP_NEXT = 0
OS_GUI_TARGET_FPS_MAX = 30
OS_GUI_TARGET_FPS = 30
OS_GRADIENT_DENSITY_SCALE = 1.45
OS_RAINBOW_KEYPOINT_STEPS = 8
OS_SKINNY_GRADIENT_SPAN = 0.16
OS_SKINNY_GRADIENT_PX = S(10)
OS_RAINBOW_POINTS = {
	{ 0.00, THEME_ACCENT },
	{ 0.18, Color3.fromRGB(91, 160, 255) },
	{ 0.36, THEME_ACCENT_ALT },
	{ 0.55, Color3.fromRGB(235, 104, 164) },
	{ 0.74, THEME_ACCENT_WARM },
	{ 0.88, Color3.fromRGB(118, 230, 188) },
	{ 1.00, THEME_ACCENT },
}
OS_RAINBOW_SOFT_POINTS = {
	{ 0.00, THEME_ACCENT_SOFT },
	{ 0.20, Color3.fromRGB(46, 83, 136) },
	{ 0.40, Color3.fromRGB(89, 70, 142) },
	{ 0.58, Color3.fromRGB(129, 61, 103) },
	{ 0.76, Color3.fromRGB(131, 91, 53) },
	{ 0.90, Color3.fromRGB(48, 120, 102) },
	{ 1.00, THEME_ACCENT_SOFT },
}
OS_RAINBOW_DIRECTION_ROTATION = 0

function OS_sampleRainbow(points, t: number)
	t = t % 1
	for i = 1, #points - 1 do
		local a = points[i]
		local b = points[i + 1]
		if t >= a[1] and t <= b[1] then
			local alpha = (t - a[1]) / math.max(0.0001, b[1] - a[1])
			return a[2]:Lerp(b[2], alpha)
		end
	end
	return points[#points][2]
end

function OS_buildRainbowSequence(points, phase: number, span: number?)
	local seq = {}
	local visibleSpan = math.clamp((span or 0.22) * OS_GRADIENT_DENSITY_SCALE, 0, 1)
	local steps = math.max(4, OS_RAINBOW_KEYPOINT_STEPS or 8)
	for i = 0, steps do
		local alpha = i / steps
		table.insert(seq, ColorSequenceKeypoint.new(alpha, OS_sampleRainbow(points, phase + (alpha * visibleSpan))))
	end
	return ColorSequence.new(seq)
end

function OS_getRainbowAttrNumber(inst: Instance?, attrName: string)
	if not inst then
		return nil
	end
	local value = inst:GetAttribute(attrName)
	if type(value) == "number" then
		return value
	end
	return nil
end

function OS_getGradientGuiObject(target: Instance): GuiObject?
	if target:IsA("GuiObject") then
		return target
	end
	local current = target.Parent
	while current do
		if current:IsA("GuiObject") then
			return current
		end
		current = current.Parent
	end
	return nil
end

function OS_shouldAnimateRainbowTarget(target: Instance?): boolean
	if not (target and target.Parent) then
		return false
	end
	local guiObject = OS_getGradientGuiObject(target)
	if guiObject then
		return OS_isGuiObjectVisibleInTree(guiObject)
	end
	return true
end

function OS_markRainbowTargetsDirty()
	OS_RAINBOW_TARGETS_DIRTY = true
end

function OS_rebuildActiveRainbowTargets(now: number?)
	table.clear(OS_ACTIVE_RAINBOW_GRADIENTS)
	table.clear(OS_ACTIVE_RAINBOW_NATIVE_SCROLLBARS)

	for i = #OS_RAINBOW_GRADIENTS, 1, -1 do
		local gradient = OS_RAINBOW_GRADIENTS[i]
		if not (gradient and gradient.Parent) then
			table.remove(OS_RAINBOW_GRADIENTS, i)
		elseif OS_shouldAnimateRainbowTarget(gradient) then
			table.insert(OS_ACTIVE_RAINBOW_GRADIENTS, gradient)
		end
	end

	for i = #OS_RAINBOW_NATIVE_SCROLLBARS, 1, -1 do
		local scroller = OS_RAINBOW_NATIVE_SCROLLBARS[i]
		if not (scroller and scroller.Parent) then
			table.remove(OS_RAINBOW_NATIVE_SCROLLBARS, i)
		elseif OS_isGuiObjectVisibleInTree(scroller) then
			table.insert(OS_ACTIVE_RAINBOW_NATIVE_SCROLLBARS, scroller)
		end
	end

	for i = #rainbowStrokes, 1, -1 do
		local stroke = rainbowStrokes[i]
		if not (stroke and stroke.Parent) then
			table.remove(rainbowStrokes, i)
		end
	end
	for i = #rainbowFrames, 1, -1 do
		local frame = rainbowFrames[i]
		if not (frame and frame.Parent) then
			table.remove(rainbowFrames, i)
		end
	end

	OS_RAINBOW_TARGETS_DIRTY = false
	OS_RAINBOW_TARGET_SWEEP_NEXT = (now or os.clock()) + OS_RAINBOW_TARGET_SWEEP_INTERVAL
end

function OS_getGradientGuiSize(target: Instance)
	local guiObject = OS_getGradientGuiObject(target)
	if not guiObject then
		return nil, nil
	end
	local width = guiObject.AbsoluteSize.X
	local height = guiObject.AbsoluteSize.Y
	if width <= 0 or height <= 0 then
		width = math.max(guiObject.Size.X.Offset, 0)
		height = math.max(guiObject.Size.Y.Offset, 0)
	end
	if width <= 0 or height <= 0 then
		return nil, nil
	end
	return width, height
end

function OS_isSkinnyGradientTarget(target: Instance): boolean
	local width, height = OS_getGradientGuiSize(target)
	if not width or not height then
		return false
	end
	return math.min(width, height) <= OS_SKINNY_GRADIENT_PX
end

function OS_getSkinnyGradientRotation(target: Instance)
	local width, height = OS_getGradientGuiSize(target)
	if width and height and height > width then
		return 90
	end
	return OS_RAINBOW_DIRECTION_ROTATION
end

function OS_registerRainbowGradient(gradient: UIGradient, speed: number?, phase: number?, span: number?)
	gradient.Name = "OSRainbowAccent"
	local rotation = gradient:GetAttribute("RainbowRotation")
	if type(rotation) ~= "number" then
		rotation = gradient.Rotation or OS_RAINBOW_DIRECTION_ROTATION
		gradient:SetAttribute("RainbowRotation", rotation)
	end
	gradient.Rotation = rotation
	if speed ~= nil or gradient:GetAttribute("RainbowSpeed") == nil then
		gradient:SetAttribute("RainbowSpeed", speed or gradient:GetAttribute("RainbowSpeed") or 0.22)
	end
	if phase ~= nil or gradient:GetAttribute("RainbowPhase") == nil then
		gradient:SetAttribute("RainbowPhase", phase or gradient:GetAttribute("RainbowPhase") or 0)
	end
	if span ~= nil or gradient:GetAttribute("RainbowSpan") == nil then
		gradient:SetAttribute("RainbowSpan", span or gradient:GetAttribute("RainbowSpan") or 0.22)
	end
	if not gradient:GetAttribute("RainbowRegistered") then
		gradient:SetAttribute("RainbowRegistered", true)
		table.insert(OS_RAINBOW_GRADIENTS, gradient)
		OS_markRainbowTargetsDirty()
	end
	gradient.Color = OS_buildRainbowSequence(
		gradient:GetAttribute("RainbowSoft") and OS_RAINBOW_SOFT_POINTS or OS_RAINBOW_POINTS,
		((os.clock() * (gradient:GetAttribute("RainbowSpeed") or 0.7)) + (gradient:GetAttribute("RainbowPhase") or 0)) % 1,
		gradient:GetAttribute("RainbowSpan") or 0.22
	)
	return gradient
end

function OS_attachAccentGradient(target: Instance, mode: string, soft: boolean?, rotation: number?, span: number?)
	local existing = target:FindFirstChild("OSRainbowAccent")
	local resolvedSpan = span or OS_getRainbowAttrNumber(existing, "RainbowSpan") or OS_getRainbowAttrNumber(target, "RainbowSpan")
	if resolvedSpan == nil and OS_isSkinnyGradientTarget(target) then
		resolvedSpan = OS_SKINNY_GRADIENT_SPAN
	end
	local resolvedRotation = rotation or OS_getRainbowAttrNumber(existing, "RainbowRotation") or OS_getRainbowAttrNumber(target, "RainbowRotation")
	if resolvedRotation == nil and OS_isSkinnyGradientTarget(target) then
		resolvedRotation = OS_getSkinnyGradientRotation(target)
	end
	resolvedRotation = resolvedRotation or OS_RAINBOW_DIRECTION_ROTATION
	if existing and existing:IsA("UIGradient") then
		existing:SetAttribute("RainbowSoft", soft == true)
		existing:SetAttribute("RainbowSpan", resolvedSpan or existing:GetAttribute("RainbowSpan") or 0.22)
		existing:SetAttribute("RainbowRotation", resolvedRotation)
		existing.Rotation = resolvedRotation
		existing.Enabled = true
		return OS_registerRainbowGradient(existing, nil, nil, resolvedSpan)
	end
	if mode == "Stroke" and target:IsA("UIStroke") then
		target.Color = Color3.new(1, 1, 1)
	elseif mode == "Text" and (target:IsA("TextLabel") or target:IsA("TextButton") or target:IsA("TextBox")) then
		target.TextColor3 = Color3.new(1, 1, 1)
	elseif mode == "Background" and target:IsA("GuiObject") then
		target.BackgroundColor3 = Color3.new(1, 1, 1)
	elseif mode == "Image" and target:IsA("ImageLabel") then
		target.ImageColor3 = Color3.new(1, 1, 1)
	end
	local gradient = mk("UIGradient", {
		Name = "OSRainbowAccent",
		Color = OS_buildRainbowSequence(
			soft and OS_RAINBOW_SOFT_POINTS or OS_RAINBOW_POINTS,
			(os.clock() * 0.22) % 1,
			resolvedSpan
		),
		Rotation = resolvedRotation,
		Parent = target,
	})
	gradient:SetAttribute("RainbowSoft", soft == true)
	gradient:SetAttribute("RainbowRotation", resolvedRotation)
	return OS_registerRainbowGradient(gradient, nil, nil, resolvedSpan)
end

function OS_setAccentGradientEnabled(target: Instance, enabled: boolean, mode: string, offColor, offTransparency: number?, soft: boolean?)
	local gradient = OS_attachAccentGradient(target, mode, soft)
	gradient.Enabled = enabled
	if mode == "Stroke" and target:IsA("UIStroke") then
		target.Color = enabled and Color3.new(1, 1, 1) or (offColor or THEME_STROKE)
		target.Transparency = enabled and 0 or (offTransparency or 0.15)
	elseif mode == "Background" and target:IsA("GuiObject") then
		target.BackgroundColor3 = enabled and Color3.new(1, 1, 1) or offColor
	elseif mode == "Text" and (target:IsA("TextLabel") or target:IsA("TextButton") or target:IsA("TextBox")) then
		target.TextColor3 = enabled and Color3.new(1, 1, 1) or offColor
	elseif mode == "Image" and target:IsA("ImageLabel") then
		target.ImageColor3 = enabled and Color3.new(1, 1, 1) or offColor
	end
end

function OS_applySwitchAccentState(sw: TextButton, swStroke: UIStroke, fill: Frame, enabled: boolean)
	sw.BackgroundColor3 = SWITCH_OFF
	if enabled then
		OS_setAccentGradientEnabled(fill, true, "Background", SWITCH_OFF, nil, true)
		fill.BackgroundTransparency = 0
		OS_setAccentGradientEnabled(swStroke, true, "Stroke", THEME_STROKE, 0.15)
	else
		OS_setAccentGradientEnabled(fill, false, "Background", SWITCH_OFF, nil, true)
		fill.BackgroundTransparency = 1
		OS_setAccentGradientEnabled(swStroke, false, "Stroke", THEME_STROKE, 0.15)
	end
end

function OS_setSwitchVisualState(sw: TextButton, swStroke: UIStroke, knob: Frame, fill: Frame, enabled: boolean, instant: boolean?)
	local pos = enabled
		and UDim2.fromOffset(SWITCH_WIDTH - SWITCH_KNOB_SIZE - SWITCH_PADDING, SWITCH_PADDING)
		or UDim2.fromOffset(SWITCH_PADDING, SWITCH_PADDING)
	local fillWidth = pos.X.Offset + SWITCH_KNOB_SIZE + SWITCH_PADDING
	local token = (sw:GetAttribute("SwitchVisualToken") or 0) + 1
	sw:SetAttribute("SwitchVisualToken", token)

	if instant then
		knob.Position = pos
		fill.Size = UDim2.fromOffset(fillWidth, SWITCH_HEIGHT)
		OS_applySwitchAccentState(sw, swStroke, fill, enabled)
		return
	end

	fill.Visible = true
	if enabled then
		OS_setAccentGradientEnabled(fill, true, "Background", SWITCH_OFF, nil, true)
		fill.BackgroundTransparency = 0
	end
	tween(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = pos })
	tween(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(fillWidth, SWITCH_HEIGHT) })
	task.delay(0.12, function()
		if not sw or not sw.Parent then return end
		if sw:GetAttribute("SwitchVisualToken") ~= token then return end
		OS_applySwitchAccentState(sw, swStroke, fill, enabled)
	end)
end

function OS_colorIsNear(a: Color3, b: Color3)
	return math.abs(a.R - b.R) < 0.01 and math.abs(a.G - b.G) < 0.01 and math.abs(a.B - b.B) < 0.01
end

function OS_getColorStats(color: Color3)
	local maxChannel = math.max(color.R, color.G, color.B)
	local minChannel = math.min(color.R, color.G, color.B)
	local delta = maxChannel - minChannel
	local hue = 0
	if delta > 0.0001 then
		if maxChannel == color.R then
			hue = ((color.G - color.B) / delta) % 6
		elseif maxChannel == color.G then
			hue = ((color.B - color.R) / delta) + 2
		else
			hue = ((color.R - color.G) / delta) + 4
		end
		hue = hue / 6
	end
	local saturation = maxChannel <= 0 and 0 or (delta / maxChannel)
	return hue, saturation, maxChannel
end

function OS_colorWantsRainbow(color: Color3, includeDark: boolean?)
	if OS_colorIsNear(color, THEME_BASE)
		or OS_colorIsNear(color, THEME_SURFACE)
		or OS_colorIsNear(color, THEME_ELEVATED)
		or OS_colorIsNear(color, THEME_PANEL)
		or OS_colorIsNear(color, THEME_PANEL_ACTIVE)
		or OS_colorIsNear(color, THEME_INPUT)
		or OS_colorIsNear(color, THEME_STROKE)
		or OS_colorIsNear(color, THEME_MUTED)
		or OS_colorIsNear(color, THEME_TRACK)
		or OS_colorIsNear(color, THEME_KNOB)
		or OS_colorIsNear(color, THEME_CARD)
		or OS_colorIsNear(color, THEME_CARD_ALT)
		or OS_colorIsNear(color, THEME_CARD_TOP)
		or OS_colorIsNear(color, THEME_CARD_BOTTOM) then
		return false
	end
	if OS_colorIsNear(color, THEME_ACCENT) or OS_colorIsNear(color, THEME_ACCENT_SOFT) then
		return true
	end
	local hue, saturation, value = OS_getColorStats(color)
	if saturation < 0.14 or value < (includeDark and 0.32 or 0.28) then
		return false
	end
	local warmBand = hue >= 0.035 and hue <= 0.18
	local coolBand = hue >= 0.48 and hue <= 0.72
	return warmBand or coolBand
end

function OS_colorShouldUseSoftRainbow(color: Color3)
	local _, _, value = OS_getColorStats(color)
	return value < 0.5
end

function OS_colorSequenceWantsRainbow(sequence: ColorSequence)
	for _, point in ipairs(sequence.Keypoints) do
		if OS_colorWantsRainbow(point.Value, true) then
			return true
		end
	end
	return false
end

function OS_colorSequenceShouldUseSoftRainbow(sequence: ColorSequence)
	local brightest = 0
	for _, point in ipairs(sequence.Keypoints) do
		local _, _, value = OS_getColorStats(point.Value)
		brightest = math.max(brightest, value)
	end
	return brightest < 0.5
end

function OS_registerNativeRainbowScrollbar(scroller: ScrollingFrame)
	if scroller:GetAttribute("RainbowNativeScrollbarRegistered") then
		return
	end
	scroller:SetAttribute("RainbowNativeScrollbarRegistered", true)
	table.insert(OS_RAINBOW_NATIVE_SCROLLBARS, scroller)
	OS_markRainbowTargetsDirty()
end

function OS_setHoverStrokeGradient(stroke: UIStroke?, enabled: boolean, offColor: Color3?, offTransparency: number?, span: number?)
	if not stroke then
		return nil
	end
	local gradient = stroke:FindFirstChild("OSRainbowAccent")
	if not gradient or not gradient:IsA("UIGradient") then
		gradient = OS_attachAccentGradient(stroke, "Stroke", false, 0, span or stroke:GetAttribute("HoverRainbowSpan") or 0.34)
	end
	gradient.Enabled = enabled
	if enabled then
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Transparency = 0
	else
		stroke.Color = offColor or stroke:GetAttribute("HoverBaseStrokeColor") or THEME_STROKE
		stroke.Transparency = offTransparency == nil and (stroke:GetAttribute("HoverBaseStrokeTransparency") or 0.15) or offTransparency
	end
	return gradient
end

function OS_prepareHoverStroke(stroke: UIStroke?, baseColor: Color3?, baseTransparency: number?, span: number?)
	if not stroke then
		return nil
	end
	stroke:SetAttribute("HoverRainbowOnly", true)
	stroke:SetAttribute("HoverRainbowSpan", span or 0.34)
	stroke:SetAttribute("HoverBaseStrokeColor", baseColor or THEME_STROKE)
	stroke:SetAttribute("HoverBaseStrokeTransparency", baseTransparency == nil and 0.15 or baseTransparency)
	return OS_setHoverStrokeGradient(stroke, false, baseColor or THEME_STROKE, baseTransparency == nil and 0.15 or baseTransparency, span)
end

function OS_applyAccentGradients(root: Instance)
	for _, stroke in ipairs(rainbowStrokes) do
		if stroke and stroke.Parent then
			if stroke:GetAttribute("HoverRainbowOnly") then
				OS_setHoverStrokeGradient(stroke, false)
			else
				OS_attachAccentGradient(stroke, "Stroke")
			end
		end
	end
	for _, frame in ipairs(rainbowFrames) do
		if frame and frame.Parent then
			OS_attachAccentGradient(frame, "Background")
		end
	end
	for _, obj in ipairs(root:GetDescendants()) do
		local guiObject = OS_getGradientGuiObject(obj)
		if guiObject and not OS_isGuiObjectVisibleInTree(guiObject) then
			continue
		end
		if obj:IsA("UIGradient") and obj.Name ~= "OSRainbowAccent" and OS_colorSequenceWantsRainbow(obj.Color) then
			obj:SetAttribute("RainbowSoft", OS_colorSequenceShouldUseSoftRainbow(obj.Color))
			OS_registerRainbowGradient(obj, nil, nil, obj:GetAttribute("RainbowSoft") and 0.46 or 0.72)
		elseif obj:IsA("ScrollingFrame") and OS_colorWantsRainbow(obj.ScrollBarImageColor3, false) then
			OS_registerNativeRainbowScrollbar(obj)
		elseif obj:IsA("UIStroke") and obj:GetAttribute("HoverRainbowOnly") then
			OS_setHoverStrokeGradient(obj, false)
		elseif obj:IsA("UIStroke") and OS_colorWantsRainbow(obj.Color, true) then
			OS_attachAccentGradient(obj, "Stroke", OS_colorShouldUseSoftRainbow(obj.Color), 0, 0.36)
		elseif (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and OS_colorWantsRainbow(obj.TextColor3, false) then
			OS_attachAccentGradient(obj, "Text", false, 0, 0.32)
		elseif obj:IsA("ImageLabel") and OS_colorWantsRainbow(obj.ImageColor3, false) then
			OS_attachAccentGradient(obj, "Image", false, 0, 0.32)
		elseif obj:IsA("GuiObject") and OS_colorWantsRainbow(obj.BackgroundColor3, true) then
			OS_attachAccentGradient(obj, "Background", OS_colorShouldUseSoftRainbow(obj.BackgroundColor3), 90, 0.46)
		end
	end
end

function OS_setImageChildrenVisible(container: Instance, visible: boolean)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") then
			child.Visible = visible
		end
	end
end

function OS_setImageDescendantTransparency(container: Instance, alpha: number, animationInfo)
	for _, child in ipairs(container:GetDescendants()) do
		if child:IsA("GuiObject") then
			local baseBg = child:GetAttribute("VisualBaseBackgroundTransparency")
			if baseBg == nil then
				baseBg = child.BackgroundTransparency
				child:SetAttribute("VisualBaseBackgroundTransparency", baseBg)
			end
			local targetBg = baseBg + ((1 - baseBg) * alpha)
			if animationInfo then
				tween(child, animationInfo, { BackgroundTransparency = targetBg })
			else
				child.BackgroundTransparency = targetBg
			end
		end
		if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
			local baseText = child:GetAttribute("VisualBaseTextTransparency")
			if baseText == nil then
				baseText = child.TextTransparency
				child:SetAttribute("VisualBaseTextTransparency", baseText)
			end
			local targetText = baseText + ((1 - baseText) * alpha)
			if animationInfo then
				tween(child, animationInfo, { TextTransparency = targetText })
			else
				child.TextTransparency = targetText
			end
		end
		if child:IsA("ImageLabel") then
			local baseImage = child:GetAttribute("VisualBaseImageTransparency")
			if baseImage == nil then
				baseImage = child.ImageTransparency
				child:SetAttribute("VisualBaseImageTransparency", baseImage)
			end
			local targetImage = baseImage + ((1 - baseImage) * alpha)
			if animationInfo then
				tween(child, animationInfo, { ImageTransparency = targetImage })
			else
				child.ImageTransparency = targetImage
			end
		end
		if child:IsA("UIStroke") then
			local baseStroke = child:GetAttribute("VisualBaseStrokeTransparency")
			if baseStroke == nil then
				baseStroke = child.Transparency
				child:SetAttribute("VisualBaseStrokeTransparency", baseStroke)
			end
			local targetStroke = baseStroke + ((1 - baseStroke) * alpha)
			if animationInfo then
				tween(child, animationInfo, { Transparency = targetStroke })
			else
				child.Transparency = targetStroke
			end
		end
	end
end

function OS_cloneImageChildren(source: Instance, target: Instance, prefix: string)
	for _, child in ipairs(source:GetChildren()) do
		if child:IsA("GuiObject") then
			local clone = child:Clone()
			clone.Name = prefix .. child.Name
			clone.ZIndex = 323
			clone.Parent = target
			for _, desc in ipairs(clone:GetDescendants()) do
				if desc:IsA("UIGradient") and desc.Name == "OSRainbowAccent" then
					OS_registerRainbowGradient(
						desc,
						desc:GetAttribute("RainbowSpeed"),
						desc:GetAttribute("RainbowPhase"),
						desc:GetAttribute("RainbowSpan")
					)
				end
			end
		end
	end
end

