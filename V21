				if aimSmoothnessErrorToken ~= token then return end
				tween(aimSmoothnessErrorLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					TextTransparency = 1,
				})
				task.delay(0.26, function()
					if aimSmoothnessErrorToken ~= token then return end
					aimSmoothnessErrorLabel.Visible = false
				end)
			end)
		end

		function updateAimSmoothnessSliderVisual(value: number)
			local displayValue = math.clamp(value, 0, AIM_SMOOTHNESS_SLIDER_MAX)
			local percent = 0
			if AIM_SMOOTHNESS_SLIDER_MAX > 0 then
				percent = displayValue / AIM_SMOOTHNESS_SLIDER_MAX
			end
			aimSmoothnessSliderKnobOuter.Position = UDim2.new(percent, 0, 0.5, 0)
		end

		OS_setAimSmoothnessValue = function(value: number, showLimitError: boolean?)
			local newValue = math.floor(value + 0.5)
			if newValue < 0 then newValue = 0 end
			if newValue > AIM_SMOOTHNESS_INPUT_MAX then
				newValue = AIM_SMOOTHNESS_INPUT_MAX
				if showLimitError then
					showAimSmoothnessError(("Max is %d"):format(AIM_SMOOTHNESS_INPUT_MAX))
				end
			end
			aimSmoothnessValue = newValue
			aimSmoothnessValueBox.Text = tostring(newValue)
			updateAimSmoothnessSliderVisual(newValue)
		end

		OS_setAimSmoothnessValue(aimSmoothnessValue)

		function updateAimSmoothnessSliderFromX(x: number)
			local absPos = aimSmoothnessSliderTrack.AbsolutePosition
			local absSize = aimSmoothnessSliderTrack.AbsoluteSize
			if absSize.X <= 0 then return end
			local alpha = (x - absPos.X) / absSize.X
			alpha = math.clamp(alpha, 0, 1)
			OS_setAimSmoothnessValue(alpha * AIM_SMOOTHNESS_SLIDER_MAX)
		end

		aimSmoothnessSliderTrack.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingAimSmoothnessSlider = true
				dragLock = true
				updateAimSmoothnessSliderFromX(input.Position.X)
			end
		end)

		aimSmoothnessSliderKnobOuter.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingAimSmoothnessSlider = true
				dragLock = true
				updateAimSmoothnessSliderFromX(input.Position.X)
			end
		end)

		OS_CONNECT(UserInputService.InputChanged:Connect(function(input)
			if not draggingAimSmoothnessSlider then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			updateAimSmoothnessSliderFromX(input.Position.X)
		end))

		OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingAimSmoothnessSlider = false
				clearDragLockIfIdle()
			end
		end))

		aimSmoothnessValueBox.Focused:Connect(function()
			dragLock = true
		end)

		aimSmoothnessValueBox.FocusLost:Connect(function()
			clearDragLockIfIdle()
			local parsed = tonumber(aimSmoothnessValueBox.Text)
			if not parsed then
				aimSmoothnessValueBox.Text = tostring(aimSmoothnessValue)
				showAimSmoothnessError("Numbers only")
				return
			end
			OS_setAimSmoothnessValue(parsed, true)
		end)
	end
end

