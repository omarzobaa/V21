function wireScrollHover(scroller: ScrollingFrame, idleThickness: number, hoverThickness: number, idleTransparency: number, hoverTransparency: number)
	scroller.ScrollBarThickness = 0
	scroller.ScrollBarImageTransparency = 1
	scroller.Active = false
	local maxWidth = math.max(idleThickness, hoverThickness, S(7))
	local track = mk("TextButton", {
		Name = scroller.Name .. "Scrollbar",
		Size = UDim2.new(0, maxWidth, 1, -S(12)),
		Position = UDim2.new(scroller.Position.X.Scale + scroller.Size.X.Scale, scroller.Position.X.Offset - maxWidth - S(4), scroller.Position.Y.Scale, scroller.Position.Y.Offset + S(6)),
		BackgroundColor3 = THEME_INPUT,
		BackgroundTransparency = 0.58,
		BorderSizePixel = 0,
		Active = true,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = scroller.ZIndex + 2,
		Parent = scroller.Parent,
	})
	mk("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
	local thumb = mk("TextButton", {
		Name = "Thumb",
		Size = UDim2.new(1, 0, 0, S(24)),
		Position = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = idleTransparency,
		BorderSizePixel = 0,
		Active = true,
		AutoButtonColor = false,
		Text = "",
		ZIndex = scroller.ZIndex + 3,
		Parent = track,
	})
	mk("UICorner", { CornerRadius = UDim.new(1, 0), Parent = thumb })
	OS_attachAccentGradient(thumb, "Background", false, 90, OS_SKINNY_GRADIENT_SPAN)
	local state = {
		scroller = scroller,
		track = track,
		thumb = thumb,
		idleThickness = idleThickness,
		hoverThickness = hoverThickness,
		idleTransparency = idleTransparency,
		hoverTransparency = hoverTransparency,
		currentWidth = math.max(idleThickness, S(4)),
		currentTrackTransparency = 0.58,
		currentThumbTransparency = idleTransparency,
		hovering = false,
		dragging = false,
		dragStartMouseY = 0,
		dragStartCanvasY = 0,
	}
	table.insert(OS_RAINBOW_SCROLLBARS, state)
	local function isOverThumb()
		if not track.Visible then
			return false
		end
		local mousePos = UserInputService:GetMouseLocation()
		local absPos = thumb.AbsolutePosition
		local absSize = thumb.AbsoluteSize
		local withinY = mousePos.Y >= absPos.Y and mousePos.Y <= (absPos.Y + absSize.Y)
		local withinX = mousePos.X >= (absPos.X - S(2)) and mousePos.X <= (absPos.X + absSize.X + S(2))
		return withinX and withinY
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not track.Visible then
			return
		end
		local thumbTop = thumb.AbsolutePosition.Y
		local thumbBottom = thumbTop + thumb.AbsoluteSize.Y
		if input.Position.Y < thumbTop or input.Position.Y > thumbBottom then
			return
		end
	end)
	thumb.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and track.Visible then
			state.dragging = true
			state.dragStartMouseY = UserInputService:GetMouseLocation().Y
			state.dragStartCanvasY = scroller.CanvasPosition.Y
			scroller.ScrollingEnabled = false
		end
	end)
	thumb.MouseEnter:Connect(function()
		state.hovering = true
	end)
	thumb.MouseLeave:Connect(function()
		if not state.dragging then
			state.hovering = false
		end
	end)
	OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			state.dragging = false
			state.dragStartMouseY = 0
			state.hovering = false
			scroller.ScrollingEnabled = true
		end
	end))
	scroller.MouseLeave:Connect(function()
		state.hovering = false
		if not state.dragging and not isOverThumb() then
			track.Visible = idleThickness > 0 and scroller.Visible
		end
	end)
end

