		trackButton.Text = PLAYERTOOLS.trackModeActive and "Untrack" or "Track"
	end

	function action.setSelected(plr: Player?, statusText: string?, statusColor: Color3?)
		PLAYERTOOLS.trackTarget = plr
		if plr then
			targetLabel.Text = OS_playerToolsFormatPlayer(plr)
			searchBox.Text = plr.Name
			if statusText then
				action.setStatus(statusText, statusColor or OS_PLAYERTOOLS_FOUND_COLOR)
			end
		else
			targetLabel.Text = "No player selected"
			if statusText then
				action.setStatus(statusText, statusColor or OS_PLAYERTOOLS_NEUTRAL_COLOR)
			end
		end
	end

	function action.resolve()
		local plr, message, kind = OS_resolveServerPlayer(searchBox.Text)
		if plr then
			action.setSelected(plr, "Selected: " .. OS_playerToolsFormatPlayer(plr), OS_PLAYERTOOLS_FOUND_COLOR)
			return plr
		end
		if kind == "multiple" then
			action.setStatus(message, OS_PLAYERTOOLS_WARNING_COLOR)
		elseif kind == "missing" then
			action.setStatus(message, OS_PLAYERTOOLS_ERROR_COLOR)
		else
			action.setStatus(message, OS_PLAYERTOOLS_NEUTRAL_COLOR)
