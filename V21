function createAbsoluteSectionCard(parent: Instance, y: number, height: number)
	ABS_SECTION_GROUPS = ABS_SECTION_GROUPS or {}
	ABS_SECTION_GROUPS[parent] = ABS_SECTION_GROUPS[parent] or {}
	table.insert(ABS_SECTION_GROUPS[parent], {
		sourceY = S(y),
		sourceHeight = S(height),
		cardY = S(y),
		cardHeight = S(height),
	})
end

function buildAbsoluteSectionCards(parent: Instance)
	local specs = ABS_SECTION_GROUPS and ABS_SECTION_GROUPS[parent]
	if not specs then return end
	ABS_SECTION_CARDS = ABS_SECTION_CARDS or {}
	ABS_SECTION_CARDS[parent] = {}
	local cardInsetLeft = S(9)
	local cardInsetRight = S(9)
	if parent == pageJob then
		cardInsetLeft = -S(4) + 5
		cardInsetRight = S(40) - 5
	end
	table.sort(specs, function(a, b)
		return a.cardY < b.cardY
	end)
	local cardLookup = {}
	for _, spec in ipairs(specs) do
		local card = mk("Frame", {
			Size = UDim2.new(1, -(cardInsetLeft + cardInsetRight), 0, spec.cardHeight),
			Position = UDim2.fromOffset(cardInsetLeft, spec.cardY),
			BackgroundColor3 = THEME_CARD,
			BorderSizePixel = 0,
			ZIndex = 52,
			ClipsDescendants = false,
			Parent = parent,
		})
		mk("UICorner", { CornerRadius = UDim.new(0, S(18)), Parent = card })
		mk("UIStroke", {
			Thickness = 1.25,
			Color = THEME_STROKE,
			Transparency = 0.22,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = card,
		})
		mk("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, THEME_CARD_TOP),
				ColorSequenceKeypoint.new(0.46, THEME_CARD),
				ColorSequenceKeypoint.new(1, THEME_CARD_BOTTOM),
			}),
			Rotation = 135,
			Parent = card,
		})
		spec.card = card
		cardLookup[card] = true
		table.insert(ABS_SECTION_CARDS[parent], card)
	end
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("GuiObject") and not cardLookup[child] and not child:GetAttribute("SectionGrouped") then
			local oldPos = child.Position
			local yPos = oldPos.Y.Offset
			for _, spec in ipairs(specs) do
				if yPos >= spec.sourceY and yPos < (spec.sourceY + spec.sourceHeight) then
					child:SetAttribute("SectionGrouped", true)
					child.Parent = spec.card
					child.Position = UDim2.new(oldPos.X.Scale, oldPos.X.Offset, oldPos.Y.Scale, yPos - spec.sourceY + S(10))
					break
				end
			end
		end
	end
end

