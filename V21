function OS_normalizeHelpLabel(labelText: string?)
	local label = tostring(labelText or "")
	label = label:gsub("^%s+", ""):gsub("%s+$", "")
	label = label:gsub(":%s*ON$", ""):gsub(":%s*OFF$", "")
	return label
end

function OS_getHelpText(labelText: string?, fallback: string?)
	local label = OS_normalizeHelpLabel(labelText)
	return OS_HELP_TEXT[label] or fallback or ("Controls " .. label .. ".")
end

