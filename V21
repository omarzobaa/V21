tabButtons = {} :: { [string]: { button: TextButton, stroke: UIStroke, active: boolean } }
tabOrder = {} :: { { button: TextButton, stroke: UIStroke, active: boolean } }
tabPages = {} :: { [string]: ScrollingFrame }
TAB_TEXT_STROKE = Color3.fromRGB(0, 0, 0)
TAB_TEXT_STROKE_VISIBLE = 0.12
TAB_TEXT_STROKE_HIDDEN = 1
tabActiveIndicatorTween = nil
tabBarLastCanvasY = tabBar.CanvasPosition.Y

function stopTabActiveIndicatorTween()
	if tabActiveIndicatorTween then
		tabActiveIndicatorTween:Cancel()
		tabActiveIndicatorTween = nil
	end
end

function updateTabButtonSizes()
	if tabBar.AbsoluteSize.X <= 0 then return end
	for _, tab in ipairs(tabOrder) do
		tab.button.Size = UDim2.new(1, 0, 0, S(44))
	end
	task.defer(function()
		updateTabActiveIndicator(true)
	end)
end

function updateTabActiveIndicator(instant: boolean?)
	if not TAB_ACTIVE_INDICATOR or not TAB_ACTIVE_LAYER or not tabBar.Visible then
		if TAB_ACTIVE_INDICATOR then
			stopTabActiveIndicatorTween()
			TAB_ACTIVE_INDICATOR.Visible = false
			if TAB_ACTIVE_LAYER and TAB_ACTIVE_INDICATOR.Parent ~= TAB_ACTIVE_LAYER then
				TAB_ACTIVE_INDICATOR.Parent = TAB_ACTIVE_LAYER
			end
		end
		return
	end
	local activeTab = ACTIVE_TAB_KEY and tabButtons[ACTIVE_TAB_KEY]
	if not activeTab then
		stopTabActiveIndicatorTween()
		TAB_ACTIVE_INDICATOR.Visible = false
		if TAB_ACTIVE_INDICATOR.Parent ~= TAB_ACTIVE_LAYER then
			TAB_ACTIVE_INDICATOR.Parent = TAB_ACTIVE_LAYER
		end
		return
	end
	local target = activeTab.button
	if not target or not target.Parent or target.AbsoluteSize.Y <= 0 or TAB_ACTIVE_LAYER.AbsoluteSize.Y <= 0 then
		task.defer(function()
			updateTabActiveIndicator(true)
		end)
		return
	end
	if TAB_ACTIVE_INDICATOR.Parent ~= TAB_ACTIVE_LAYER then
		TAB_ACTIVE_INDICATOR.Parent = TAB_ACTIVE_LAYER
	end
	local relY = target.AbsolutePosition.Y - TAB_ACTIVE_LAYER.AbsolutePosition.Y + math.floor((target.AbsoluteSize.Y - TAB_ACTIVE_INDICATOR.AbsoluteSize.Y) / 2)
	local targetPos = UDim2.fromOffset(S(21) + 4, relY)
	TAB_ACTIVE_INDICATOR.Visible = true
	if instant or not TAB_ACTIVE_INDICATOR:GetAttribute("Primed") then
		stopTabActiveIndicatorTween()
		TAB_ACTIVE_INDICATOR.Position = targetPos
		TAB_ACTIVE_INDICATOR:SetAttribute("Primed", true)
	else
		stopTabActiveIndicatorTween()
		local tweenObj = tween(TAB_ACTIVE_INDICATOR, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Position = targetPos,
		})
		tabActiveIndicatorTween = tweenObj
		tweenObj.Completed:Connect(function()
			if tabActiveIndicatorTween == tweenObj then
				tabActiveIndicatorTween = nil
			end
		end)
	end
end

function refreshTabActiveIndicatorAfterScroll(expectedKey: string?)
	if expectedKey and ACTIVE_TAB_KEY ~= expectedKey then return end
	updateTabActiveIndicator(true)
end

function setActiveTab(key: string)
	ACTIVE_TAB_KEY = key
	for name, page in pairs(tabPages) do
		page.Visible = name == key
	end
	OS_markRainbowTargetsDirty()
	for name, tab in pairs(tabButtons) do
		local active = name == key
		tab.active = active
		OS_setAccentGradientEnabled(tab.button, active, "Background", THEME_CARD_ALT, nil, true)
		tab.button.TextColor3 = active and THEME_TEXT or TAB_INACTIVE_TEXT
		tab.button.TextStrokeColor3 = TAB_TEXT_STROKE
		tab.button.TextStrokeTransparency = active and TAB_TEXT_STROKE_VISIBLE or TAB_TEXT_STROKE_HIDDEN
		OS_setAccentGradientEnabled(tab.stroke, active, "Stroke", THEME_STROKE, 0.44)
		tab.stroke.Transparency = active and 0.04 or 0.44
		tab.stroke.Thickness = active and 1.6 or 1
	end
	updateTabActiveIndicator(false)
	task.defer(function()
		if ACTIVE_TAB_KEY ~= key then return end
		local activeTab = tabButtons[key]
		if not activeTab or not activeTab.button then return end
		local buttonTop = activeTab.button.AbsolutePosition.Y - tabBar.AbsolutePosition.Y + tabBar.CanvasPosition.Y
		local buttonBottom = buttonTop + activeTab.button.AbsoluteSize.Y
		local visibleTop = tabBar.CanvasPosition.Y
		local visibleBottom = visibleTop + tabBar.AbsoluteSize.Y
		local didScroll = false
		if buttonTop < visibleTop then
			tabBar.CanvasPosition = Vector2.new(0, math.max(0, math.floor(buttonTop - S(12))))
			didScroll = true
		elseif buttonBottom > visibleBottom then
			tabBar.CanvasPosition = Vector2.new(0, math.max(0, math.floor(buttonBottom - tabBar.AbsoluteSize.Y + S(12))))
			didScroll = true
		end
		if didScroll then
			TAB_ACTIVE_INDICATOR.Visible = true
			refreshTabActiveIndicatorAfterScroll(key)
		end
	end)
end

function createTabButton(key: string, label: string, order: number, page: ScrollingFrame)
	local btn = mk("TextButton", {
		Name = ("Tab_%s"):format(key),
		Size = UDim2.new(1, 0, 0, S(44)),
		BackgroundColor3 = THEME_CARD_ALT,
		Text = label,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(21),
		TextColor3 = TAB_INACTIVE_TEXT,
		TextStrokeColor3 = TAB_TEXT_STROKE,
		TextStrokeTransparency = TAB_TEXT_STROKE_HIDDEN,
		AutoButtonColor = false,
		ZIndex = 54,
		LayoutOrder = order,
		Parent = tabBar,
	})
	mk("UICorner", { CornerRadius = UDim.new(0, S(14)), Parent = btn })
	mk("UIPadding", {
		PaddingLeft = UDim.new(0, S(26)),
		PaddingRight = UDim.new(0, S(10)),
		Parent = btn,
	})
	local stroke = mk("UIStroke", { Thickness = 1, Color = THEME_STROKE, Transparency = 0.44, Parent = btn })

	local tab = { button = btn, stroke = stroke, active = false }
	tabButtons[key] = tab
	table.insert(tabOrder, tab)
	tabPages[key] = page

	btn.MouseButton1Click:Connect(function()
		setActiveTab(key)
	end)
	OS_attachHelpTooltip(btn, label, nil, S(8))
	btn.MouseEnter:Connect(function()
		if not tab.active then
			OS_setAccentGradientEnabled(btn, true, "Background", THEME_CARD_ALT, nil, true)
			btn.TextColor3 = THEME_TEXT
			btn.TextStrokeColor3 = TAB_TEXT_STROKE
			btn.TextStrokeTransparency = TAB_TEXT_STROKE_VISIBLE
		end
	end)
	btn.MouseLeave:Connect(function()
		if not tab.active then
			OS_setAccentGradientEnabled(btn, false, "Background", THEME_CARD_ALT, nil, true)
			btn.TextColor3 = TAB_INACTIVE_TEXT
			btn.TextStrokeTransparency = TAB_TEXT_STROKE_HIDDEN
		end
	end)
end

