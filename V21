		end
		pcall(function()
			LocalPlayer.DevCameraOcclusionMode = base.occlusionMode or Enum.DevCameraOcclusionMode.Zoom
		end)
		return
	end

	OS_POVCAM.wallIgnore = true
	LocalPlayer.CameraMode = Enum.CameraMode.Classic
	LocalPlayer.CameraMinZoomDistance = math.max(0.5, OS_POVCAM.minZoom or 0.5)
	LocalPlayer.CameraMaxZoomDistance = math.max(LocalPlayer.CameraMinZoomDistance + 1, OS_POVCAM.maxZoom or OS_POVCAM_UNLIMITED_ZOOM or 1e6)
	pcall(function()
		LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
	end)

