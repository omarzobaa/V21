function OS_isHittableFractureGuiObject(guiObject: GuiObject, point: Vector2): boolean
	local current: Instance? = guiObject
	while current and current ~= gui do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		if current:IsA("GuiObject") and current.ClipsDescendants and not OS_pointInsideGuiObject(current, point) then
			return false
		end
		current = current.Parent
	end
	return true
end

function OS_pointInsideGuiObject(guiObject: GuiObject, point: Vector2): boolean
	local absPos = guiObject.AbsolutePosition
	local absSize = guiObject.AbsoluteSize
	return point.X >= absPos.X
		and point.X <= absPos.X + absSize.X
		and point.Y >= absPos.Y
		and point.Y <= absPos.Y + absSize.Y
end

function OS_isPointerOverFractureGui(mouseLocation: Vector2?): boolean
	if not gui or not gui.Parent or not gui.Enabled then
		return false
	end
	local pos = mouseLocation or UserInputService:GetMouseLocation()
	local inset = select(1, GuiService:GetGuiInset())
	local points = { pos, pos - inset }

	for _, point in ipairs(points) do
		local ok, objects = pcall(function()
			return GuiService:GetGuiObjectsAtPosition(point.X, point.Y)
		end)
		if ok and type(objects) == "table" then
			for _, object in ipairs(objects) do
				if object == gui or object:IsDescendantOf(gui) then
					return true
				end
			end
		end
	end

	for _, object in ipairs(gui:GetDescendants()) do
		if object:IsA("GuiObject") then
			for _, point in ipairs(points) do
				if OS_pointInsideGuiObject(object, point) and OS_isHittableFractureGuiObject(object, point) then
					return true
				end
			end
		end
	end

	return false
end

function OS_tryClickTeleport(mouseLocation: Vector2?): boolean
	if not teleportArmed then
		return false
	end
	if UserInputService:GetFocusedTextBox() or waitingFor or dragLock then
		return false
	end
	mouseLocation = mouseLocation or UserInputService:GetMouseLocation()
	if OS_isPointerOverFractureGui(mouseLocation) then
		return false
	end

	local character = LocalPlayer.Character
	if not (character and character.Parent) then
		return false
	end

	local mouse = LocalPlayer:GetMouse()
	if not (mouse and mouse.Target and mouse.Hit) then
		return false
	end
	if mouse.Target:IsDescendantOf(character) then
		return false
	end

	local root = OS_getClickTeleportRoot()
	local targetPosition = mouse.Hit.Position
	character:MoveTo(targetPosition)

	if not (root and root.Parent) then
		return true
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

function OS_getClickTeleportRoot(): BasePart?
	local humanoid = getHumanoid()
	local character = LocalPlayer.Character
	local root = humanoid and humanoid.RootPart
	if not root and character then
		root = character:FindFirstChild("HumanoidRootPart")
	end
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

