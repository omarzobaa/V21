					if miniLogoScale and miniLogoScale:IsA("UIScale") then
						miniLogoScale.Scale = 0.84
						tween(miniLogoScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
					end
					if panelScale and panelScale:IsA("UIScale") then
						panelScale.Scale = 1
					end
				end
			end)
		end
	else
		panel.Size = MINI_COLLAPSED_SIZE
		panel.Visible = true
		inner.Visible = true
		top.Visible = false
		mini.Visible = true
		mini.BackgroundTransparency = 1
		miniStroke.Transparency = 1
		setMiniLogoTransparency(0)
		inner.Position = UDim2.fromOffset(0, -S(58))
		if panelScale and panelScale:IsA("UIScale") then
			panelScale.Scale = 0.94
		end
		if innerScale and innerScale:IsA("UIScale") then
			innerScale.Scale = 0.985
		end
		if miniScale and miniScale:IsA("UIScale") then
			miniScale.Scale = 1
		end
		if miniLogoScale and miniLogoScale:IsA("UIScale") then
			miniLogoScale.Scale = 1
		end

		if instant then
			panel.Size = openSize
			inner.Position = UDim2.fromOffset(0, 0)
			inner.Visible = true
			top.Visible = true
			if innerStroke then
				innerStroke.Transparency = 0.25
			end
			if panelScale and panelScale:IsA("UIScale") then
				panelScale.Scale = 1
			end
			if innerScale and innerScale:IsA("UIScale") then
				innerScale.Scale = 1
			end
			mini.Visible = false
			if miniLogoScale and miniLogoScale:IsA("UIScale") then
				miniLogoScale.Scale = 1
			end
		else
			if innerStroke then
				innerStroke.Transparency = 1
			end
			tween(panel, MINIMIZE_TWEEN_INFO, { Size = openSize })
			if panelScale and panelScale:IsA("UIScale") then
				tween(panelScale, TweenInfo.new(0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			end
			if miniScale and miniScale:IsA("UIScale") then
				miniScale.Scale = 1
			end
			mini.Visible = false
			mini.BackgroundTransparency = 1
			miniStroke.Transparency = 1
			setMiniLogoTransparency(1)
			if miniLogoScale and miniLogoScale:IsA("UIScale") then
				miniLogoScale.Scale = 1
				miniLogoScale.Scale = 0.88
			end
			task.delay(0.08, function()
				if not MINIMIZED and panel.Visible and panel:GetAttribute("MinimizeToken") == transitionToken then
					inner.Visible = true
					tween(inner, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
						Position = UDim2.fromOffset(0, 0)
					})
					if innerScale and innerScale:IsA("UIScale") then
						tween(innerScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
					end
				end
			end)
			task.delay(0.12, function()
				if not MINIMIZED and panel.Visible and panel:GetAttribute("MinimizeToken") == transitionToken then
					top.Visible = true
					if innerStroke then
						tween(innerStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.25 })
					end
				end
			end)
			task.delay(0.08, function()
				if not MINIMIZED and panel.Visible and panel:GetAttribute("MinimizeToken") == transitionToken then
					setMiniLogoTransparency(1, MINI_INFO_OPEN)
				end
			end)
		end

		task.delay(0.06, function()
			if not MINIMIZED and panel:GetAttribute("MinimizeToken") == transitionToken then
				mini.Visible = false
				if miniScale and miniScale:IsA("UIScale") then
					miniScale.Scale = 1
				end
				if miniLogoScale and miniLogoScale:IsA("UIScale") then
					miniLogoScale.Scale = 1
				end
			end
		end)

		task.delay(0.17, function()
			if not MINIMIZED and panel.Visible and panel:GetAttribute("MinimizeToken") == transitionToken then
				inner.Visible = true
			end
		end)
	end
end

