function OS_isNativeRightMouseDown(): boolean
	local ok, value = pcall(function()
		return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	end)
	return ok and value == true
end

function OS_scheduleNativeCameraDragRelease()
	OS_NATIVE_CAMERA_DRAG_RELEASE.token = (OS_NATIVE_CAMERA_DRAG_RELEASE.token or 0) + 1
	local token = OS_NATIVE_CAMERA_DRAG_RELEASE.token
	local startedAt = os.clock()

	task.spawn(function()
		while OS_EXEC_IS_CURRENT() and OS_NATIVE_CAMERA_DRAG_RELEASE.token == token do
			if FREECAM and FREECAM.enabled then
				return
			end

			local rightDown = OS_isNativeRightMouseDown()
			if not rightDown and UserInputService.MouseBehavior == Enum.MouseBehavior.LockCurrentPosition then
				OS_releaseFreecamMouse()
			end

			local elapsed = os.clock() - startedAt
			if elapsed >= 0.35 and not rightDown and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCurrentPosition then
				break
			end
			if elapsed >= 1.5 then
				break
			end

			RunService.RenderStepped:Wait()
		end
	end)
end

