function setMiniLogoTransparency(alpha: number, animationInfo)
	local miniBackdropTarget = alpha
	local miniBackdropStrokeTarget = alpha
	OS_setImageDescendantTransparency(miniLogo, alpha, animationInfo)
	if miniLogoBackdrop and miniLogoBackdrop.Parent then
		if animationInfo then
			tween(miniLogoBackdrop, animationInfo, { BackgroundTransparency = miniBackdropTarget })
		else
			miniLogoBackdrop.BackgroundTransparency = miniBackdropTarget
		end
	end
	if miniLogoBackdropStroke and miniLogoBackdropStroke.Parent then
		if animationInfo then
			tween(miniLogoBackdropStroke, animationInfo, { Transparency = miniBackdropStrokeTarget })
		else
			miniLogoBackdropStroke.Transparency = miniBackdropStrokeTarget
		end
	end
end

function OS_playLogoSpin(target: GuiObject, duration: number)
	if not target or not target.Parent then return end
	if target:GetAttribute("SpinActive") then return end
	local spinToken = (target:GetAttribute("SpinToken") or 0) + 1
	target:SetAttribute("SpinToken", spinToken)
	target:SetAttribute("SpinActive", true)
	target.Rotation = 0
	local tw = tween(target, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Rotation = 360,
	})
	tw.Completed:Connect(function()
		if not target or not target.Parent then return end
		if target:GetAttribute("SpinToken") ~= spinToken then return end
		target.Rotation = 0
		target:SetAttribute("SpinActive", false)
	end)
end

