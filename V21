function OS_freecamSlider(titleText: string, minValue: number, maxValue: number, key: string, decimals: number, callback, inputMax: number?)
	local row = mk("Frame", {
		LayoutOrder = OS_freecamNextOrder(),
		Size = UDim2.new(1, 0, 0, inputMax and S(74) or S(60)),
		BackgroundColor3 = THEME_CARD_ALT,
		BorderSizePixel = 0,
		ZIndex = 53,
		Parent = OS_FREECAM_PAGE,
	})
	mk("UICorner", { CornerRadius = UDim.new(0, S(16)), Parent = row })
	mk("UIStroke", { Thickness = 1.1, Color = THEME_STROKE, Transparency = 0.08, Parent = row })

	local innerRow = mk("Frame", {
		Size = UDim2.new(1, -(FULL_WIDTH_INSET * 2), 1, 0),
		Position = UDim2.fromOffset(FULL_WIDTH_INSET, 0),
		BackgroundTransparency = 1,
		ZIndex = 53,
		Parent = row,
	})

	local valueBox
	local errorLabel = nil
	local errorToken = 0
	local setValue

	mk("TextLabel", {
		Size = UDim2.new(0.58, 0, 0, S(18)),
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = titleText,
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(21),
		TextColor3 = THEME_TEXT,
		ZIndex = 54,
		Parent = innerRow,
	})
	OS_attachHelpTooltip(row, titleText)

	valueBox = mk("TextBox", {
		Size = UDim2.new(0.32, 0, 0, S(20)),
		Position = UDim2.new(0.68, 0, 0, S(7)),
		BackgroundColor3 = THEME_INPUT,
		Text = string.format("%." .. decimals .. "f", FREECAM.settings[key]),
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(21),
		TextColor3 = THEME_TEXT,
		ClearTextOnFocus = false,
		ZIndex = 54,
		Parent = innerRow,
	})
	dragBlockTargets[valueBox] = true
	mk("UICorner", { CornerRadius = UDim.new(0, S(10)), Parent = valueBox })
	mk("UIStroke", { Thickness = 1, Color = THEME_STROKE, Transparency = 0.15, Parent = valueBox })

	if inputMax then
		errorLabel = mk("TextLabel", {
			Size = UDim2.new(0.32, 0, 0, S(14)),
			Position = UDim2.new(0.68, 0, 0, S(29)),
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
			Font = Enum.Font.GrenzeGotisch,
			TextSize = S(19),
			TextColor3 = THEME_DANGER,
			Visible = false,
			ZIndex = 54,
			Parent = innerRow,
		})
	end

	local track = mk("Frame", {
		Size = UDim2.new(1, -((SLIDER_ARROW_SIZE * 2) + (SLIDER_ARROW_GAP * 2) + SLIDER_KNOB_SIZE), 0, SLIDER_TRACK_HEIGHT),
		Position = UDim2.new(0, SLIDER_ARROW_SIZE + SLIDER_ARROW_GAP + math.floor(SLIDER_KNOB_SIZE / 2), 0, inputMax and S(54) or S(40)),
		BackgroundColor3 = THEME_TRACK,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		ZIndex = 54,
		Parent = innerRow,
	})
	dragBlockTargets[track] = true
	local actualMax = inputMax or maxValue
	makeSliderArrowButton(innerRow, 0, 0, "<", function()
		setValue(FREECAM.settings[key] - getSmartSliderStep(FREECAM.settings[key], actualMax), true)
	end, 0, (inputMax and S(54) or S(40)) + math.floor(SLIDER_TRACK_HEIGHT / 2))
	makeSliderArrowButton(innerRow, 1, -SLIDER_ARROW_SIZE, ">", function()
		setValue(FREECAM.settings[key] + getSmartSliderStep(FREECAM.settings[key], actualMax), true)
	end, 0, (inputMax and S(54) or S(40)) + math.floor(SLIDER_TRACK_HEIGHT / 2))
	mk("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
	local stroke = mk("UIStroke", {
		Thickness = SLIDER_GLOW_THICKNESS,
		Color = THEME_ACCENT,
		Transparency = 0.15,
		Parent = track,
	})
	table.insert(rainbowStrokes, stroke)

	local knob = mk("Frame", {
		Size = UDim2.fromOffset(SLIDER_KNOB_SIZE, SLIDER_KNOB_SIZE),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = THEME_KNOB,
		BorderSizePixel = 0,
		ZIndex = 55,
		Parent = track,
	})
	dragBlockTargets[knob] = true
	mk("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
	mk("UIStroke", { Thickness = 2, Color = THEME_ACCENT, Transparency = 0.34, Parent = knob })
	local knobInner = mk("Frame", {
		Size = UDim2.fromOffset(math.max(1, math.floor(SLIDER_KNOB_SIZE * 0.45)), math.max(1, math.floor(SLIDER_KNOB_SIZE * 0.45))),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		BackgroundColor3 = THEME_TEXT,
		BorderSizePixel = 0,
		ZIndex = 56,
		Parent = knob,
	})
	mk("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knobInner })

	local dragging = false
	local function showError(message: string?)
		if not errorLabel then return end
		if not message or message == "" then
			errorLabel.Visible = false
			return
		end
		errorToken += 1
		local token = errorToken
		errorLabel.Text = message
		errorLabel.TextTransparency = 0
		errorLabel.Visible = true
		task.delay(2, function()
			if errorToken ~= token then return end
			tween(errorLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				TextTransparency = 1,
			})
			task.delay(0.26, function()
				if errorToken ~= token then return end
				errorLabel.Visible = false
			end)
		end)
	end

	setValue = function(value: number, showLimitError: boolean?)
		local clamped = value
		if clamped < minValue then clamped = minValue end
		if clamped > actualMax then
			clamped = actualMax
			if showLimitError then
				showError(("Max is %d"):format(actualMax))
			end
		end
		FREECAM.settings[key] = clamped
		local displayValue = math.clamp(clamped, minValue, maxValue)
		local alpha = 0
		if maxValue > minValue then
			alpha = (displayValue - minValue) / (maxValue - minValue)
		end
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueBox.Text = string.format("%." .. decimals .. "f", clamped)
		if callback then
			callback(clamped)
		end
		if FREECAM.enabled and FREECAM.applyVisuals then
			FREECAM.applyVisuals()
		end
	end

	local function setFromX(x: number)
		local absPos = track.AbsolutePosition
		local absSize = track.AbsoluteSize
		if absSize.X <= 0 then return end
		local alpha = math.clamp((x - absPos.X) / absSize.X, 0, 1)
		setValue(minValue + ((maxValue - minValue) * alpha))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragLock = true
			setFromX(input.Position.X)
		end
	end)
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragLock = true
			setFromX(input.Position.X)
		end
	end)
	OS_CONNECT(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		setFromX(input.Position.X)
	end))
	OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			clearDragLockIfIdle()
		end
	end))
	valueBox.Focused:Connect(function()
		dragLock = true
	end)
	valueBox.FocusLost:Connect(function()
		clearDragLockIfIdle()
		local parsed = tonumber(valueBox.Text)
		if not parsed then
			valueBox.Text = string.format("%." .. decimals .. "f", FREECAM.settings[key])
			showError("Numbers only")
			return
		end
		setValue(parsed, true)
	end)

	setValue(FREECAM.settings[key])
	table.insert(FREECAM.refreshUi, function()
		setValue(FREECAM.settings[key])
	end)
end

function OS_resetFreecamSettings()
	for k, v in pairs(FREECAM.defaults or FREECAM_DEFAULTS) do
		FREECAM.settings[k] = v
	end
	for _, refresh in ipairs(FREECAM.refreshUi or {}) do
		refresh()
	end
	if FREECAM.enabled and FREECAM.applyVisuals then
		FREECAM.applyVisuals()
	elseif FREECAM.restoreVisuals then
		FREECAM.restoreVisuals()
	end
end

function OS_getFreecamSpeed()
	return OS_getFreecamSpeedValue()
end

function OS_resetFreecamMoveState()
	FREECAM.moveState.forward = false
	FREECAM.moveState.backward = false
	FREECAM.moveState.left = false
	FREECAM.moveState.right = false
	FREECAM.moveState.up = false
	FREECAM.moveState.down = false
end

function OS_setFreecamMoveKey(keyCode: Enum.KeyCode, isDown: boolean)
	if keyCode == Enum.KeyCode.W or keyCode == Enum.KeyCode.Up then
		FREECAM.moveState.forward = isDown
	elseif keyCode == Enum.KeyCode.S or keyCode == Enum.KeyCode.Down then
		FREECAM.moveState.backward = isDown
	elseif keyCode == Enum.KeyCode.A or keyCode == Enum.KeyCode.Left then
		FREECAM.moveState.left = isDown
	elseif keyCode == Enum.KeyCode.D or keyCode == Enum.KeyCode.Right then
		FREECAM.moveState.right = isDown
	elseif keyCode == Enum.KeyCode.Space then
		FREECAM.moveState.up = isDown
	elseif keyCode == Enum.KeyCode.LeftControl then
		FREECAM.moveState.down = isDown
	end
end

function OS_isFreecamMouseUnlockKey(keyCode: Enum.KeyCode): boolean
	return keyCode == Enum.KeyCode.LeftShift or keyCode == Enum.KeyCode.RightShift
end

function OS_isFreecamLookDragButton(input: InputObject?): boolean
	if not input then
		return false
	end
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.MouseButton2
end

function OS_resetFreecamLookDrag()
	FREECAM.lookDragActive = false
	FREECAM.lookDragButton = nil
	FREECAM.lookDragLastPosition = nil
end

function OS_applyFreecamLookDelta(delta)
	if not delta then
		return
	end
	local dx = delta.X or 0
	local dy = delta.Y or 0
	if math.abs(dx) <= 0.001 and math.abs(dy) <= 0.001 then
		return
	end
	local sensitivity = FREECAM.settings.lookSensitivity * 0.004
	FREECAM.rotation += Vector2.new(-math.rad(dy * sensitivity), -math.rad(dx * sensitivity))
end

function OS_beginFreecamLookDrag(input: InputObject?): boolean
	if not (FREECAM and FREECAM.enabled and FREECAM.mouseUnlocked == true) then
		return false
	end
	if FREECAM.isMobile or UserInputService:GetFocusedTextBox() then
		return false
	end
	if not OS_isFreecamLookDragButton(input) then
		return false
	end
	if OS_isPointOverStrongGui(OS_getInputScreenPoint(input)) then
		return false
	end
	FREECAM.lookDragActive = true
	FREECAM.lookDragButton = input.UserInputType
	FREECAM.lookDragLastPosition = input.Position
	OS_releaseFreecamMouse()
	return true
end

function OS_updateFreecamLookDrag(input: InputObject?)
	if not (FREECAM and FREECAM.enabled and FREECAM.mouseUnlocked == true and FREECAM.lookDragActive) then
		return
	end
	if not input or input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	local delta = input.Delta
	if FREECAM.lookDragLastPosition and input.Position then
		local fallbackDelta = input.Position - FREECAM.lookDragLastPosition
		if not delta or math.abs(delta.X) + math.abs(delta.Y) <= 0.001 then
			delta = fallbackDelta
		end
	end
	FREECAM.lookDragLastPosition = input.Position
	OS_applyFreecamLookDelta(delta)
	OS_releaseFreecamMouse()
end

function OS_endFreecamLookDrag(input: InputObject?)
	if not (FREECAM and FREECAM.lookDragActive) then
		return
	end
	if input and FREECAM.lookDragButton and input.UserInputType ~= FREECAM.lookDragButton then
		return
	end
	OS_resetFreecamLookDrag()
	OS_releaseFreecamMouse()
end

function OS_ensureFreecamControls()
	if FREECAM.controls ~= nil then return FREECAM.controls end
	local ok, controls = pcall(function()
		local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
		if not playerScripts then return nil end
		local module = playerScripts:FindFirstChild("PlayerModule")
		if not module then return nil end
		return require(module):GetControls()
	end)
	FREECAM.controls = ok and controls or false
	return ok and controls or nil
end

function OS_ensureFreecamEffect(className: string, name: string)
	local lighting = FREECAM.lighting
	if not lighting then
		return nil
	end
	local effect = lighting:FindFirstChild(name)
	if effect and effect.ClassName ~= className then
		effect:Destroy()
		effect = nil
	end
	if not effect then
		effect = Instance.new(className)
		effect.Name = name
		effect.Parent = lighting
	end
	return effect
end

function OS_destroyFreecamEffects()
	local lighting = FREECAM.lighting
	if not lighting then
		return
	end
	for _, name in ipairs({ "OSFreecamBloom", "OSFreecamSunRays", "OSFreecamCC", "OSFreecamDoF" }) do
		local effect = lighting:FindFirstChild(name)
		if effect then
			effect:Destroy()
		end
	end
end

