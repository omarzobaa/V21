		end, 0, S(54) + math.floor(SLIDER_TRACK_HEIGHT / 2))
		makeSliderArrowButton(innerRow, 1, -SLIDER_ARROW_SIZE, ">", function()
			OS_POVCAM.maxZoom = math.min(inputMax, OS_POVCAM.maxZoom + getSmartSliderStep(OS_POVCAM.maxZoom, inputMax))
			refreshPovUi()
