local function ensurePillTextOutline(btn: TextButton)
	local outlineOffsets = {
		Vector2.new(-1, 0),
		Vector2.new(1, 0),
		Vector2.new(0, -1),
		Vector2.new(0, 1),
		Vector2.new(-1, -1),
		Vector2.new(1, -1),
		Vector2.new(-1, 1),
		Vector2.new(1, 1),
	}
	local outline
	local function sync()
		local outlineOffset = math.max(1, math.floor((btn.TextSize * 0.08) + 0.5))
		outline.Size = UDim2.fromScale(1, 1)
		outline.Position = UDim2.fromOffset(0, 0)
		outline.ZIndex = btn.ZIndex + 1
		for index, offset in ipairs(outlineOffsets) do
			local label = outline:FindFirstChild(("Outline%d"):format(index))
			if label and label:IsA("TextLabel") then
				label.Size = UDim2.fromScale(1, 1)
				label.Position = UDim2.fromOffset(offset.X * outlineOffset, offset.Y * outlineOffset)
				label.Text = btn.Text
				label.Font = btn.Font
				label.TextSize = btn.TextSize
				label.TextColor3 = Color3.new(1, 1, 1)
				label.TextTransparency = 0
				label.TextStrokeTransparency = 1
				label.ZIndex = btn.ZIndex + 1
				label.TextXAlignment = btn.TextXAlignment
				label.TextYAlignment = btn.TextYAlignment
			end
		end
	end
	outline = btn:FindFirstChild("PillTextOutline")
	local created = false
	if outline and outline:IsA("Frame") then
		-- reuse the existing outline and resync it with the button below
	else
		if outline then
			outline:Destroy()
		end
		outline = mk("Frame", {
			Name = "PillTextOutline",
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = false,
			ZIndex = btn.ZIndex + 1,
			Parent = btn,
		})
		for index, _ in ipairs(outlineOffsets) do
			local label = mk("TextLabel", {
				Name = ("Outline%d"):format(index),
				Size = UDim2.fromScale(1, 1),
				Position = UDim2.fromOffset(0, 0),
				BackgroundTransparency = 1,
				Text = btn.Text,
				Font = btn.Font,
				TextSize = btn.TextSize,
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeTransparency = 1,
				ZIndex = btn.ZIndex + 1,
				Parent = outline,
			})
			OS_attachAccentGradient(label, "Text", false, 0, 0.32)
		end
		created = true
	end
	sync()
	if not created then
		return outline
	end
	btn:GetPropertyChangedSignal("Text"):Connect(function()
		sync()
	end)
	btn:GetPropertyChangedSignal("Font"):Connect(function()
		sync()
	end)
	btn:GetPropertyChangedSignal("TextSize"):Connect(function()
		sync()
	end)
	btn:GetPropertyChangedSignal("TextXAlignment"):Connect(function()
		sync()
	end)
	btn:GetPropertyChangedSignal("TextYAlignment"):Connect(function()
		sync()
	end)
	btn:GetPropertyChangedSignal("ZIndex"):Connect(function()
		sync()
	end)
	return outline
end

local function ensurePillTextLayers(btn: TextButton)
	local overlay = ensurePillTextOverlay(btn)
	local outline = ensurePillTextOutline(btn)
	btn.TextTransparency = 1
	return overlay, outline
end

local function setPillToggleVisual(btn: TextButton, enabled: boolean)
	local overlay = ensurePillTextOverlay(btn)
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	btn.TextTransparency = 1
	overlay.TextTransparency = 0
	overlay.TextColor3 = Color3.new(1, 1, 1)
	if enabled then
		OS_setAccentGradientEnabled(btn, true, "Background", REBIND_BG_IDLE, nil, true)
		btn:SetAttribute("HoverBaseBg", Color3.new(1, 1, 1))
		btn:SetAttribute("HoverKeepAccentGradient", true)
		if stroke then
			stroke:SetAttribute("HoverRainbowOnly", false)
			OS_setHoverStrokeGradient(stroke, true, Color3.new(1, 1, 1), 0)
			btn:SetAttribute("HoverBaseStrokeColor", Color3.new(1, 1, 1))
			btn:SetAttribute("HoverBaseStrokeTransparency", 0)
		end
	else
		OS_setAccentGradientEnabled(btn, false, "Background", REBIND_BG_IDLE, nil, true)
		btn.BackgroundColor3 = REBIND_BG_IDLE
		btn:SetAttribute("HoverBaseBg", REBIND_BG_IDLE)
		btn:SetAttribute("HoverKeepAccentGradient", false)
		if stroke then
			OS_prepareHoverStroke(stroke, THEME_STROKE, 0.15)
			btn:SetAttribute("HoverBaseStrokeColor", THEME_STROKE)
			btn:SetAttribute("HoverBaseStrokeTransparency", 0.15)
		end
	end
end

function getSmartSliderStep(value: number, maxValue: number?)
	local step = math.max(1, math.floor(math.abs(value) / 100))
	if maxValue and step > maxValue then
		step = maxValue
	end
	return step
end

function makeSliderArrowButton(parent: Instance, xScale: number, xOffset: number, text: string, onClick, yScale: number?, yOffset: number?)
	local btn = mk("TextButton", {
		Size = UDim2.fromOffset(SLIDER_ARROW_SIZE, SLIDER_ARROW_SIZE),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(xScale, xOffset, yScale or 0.5, yOffset or 0),
		BackgroundColor3 = THEME_INPUT,
		Text = text,
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(17),
		TextColor3 = THEME_TEXT,
		AutoButtonColor = false,
		ZIndex = 54,
		Parent = parent,
	})
	dragBlockTargets[btn] = true
	mk("UICorner", { CornerRadius = UDim.new(0, S(9)), Parent = btn })
	local stroke = mk("UIStroke", {
		Thickness = OUTLINE_THIN,
		Color = Color3.new(1, 1, 1),
		Transparency = 1,
		Enabled = false,
		Parent = btn,
	})
	local gradient = OS_attachAccentGradient(stroke, "Stroke", false, 0, 0.2)
	if gradient then
		gradient.Enabled = false
	end

	btn.MouseEnter:Connect(function()
		stroke.Enabled = true
		if gradient then
			gradient.Enabled = true
		end
		tween(stroke, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0 })
	end)

	btn.MouseLeave:Connect(function()
		local t = tween(stroke, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 })
		t.Completed:Connect(function()
			stroke.Enabled = false
			if gradient then
				gradient.Enabled = false
			end
		end)
	end)

	btn.MouseButton1Click:Connect(onClick)
	return btn
end

