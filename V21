				OS_HITBOX_MENU_HEIGHTS[menu] = 0
				OS_HITBOX_EXPANDED_MENUS[menu] = false
				if OS_HITBOX_UPDATE_PANEL_HEIGHT then
					OS_HITBOX_UPDATE_PANEL_HEIGHT()
				end
				local closeTween = tween(menu, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, -((FULL_WIDTH_INSET * 2) - S(2)), 0, 0) })
				closeTween.Completed:Connect(function()
					if not expanded then
						menu.Visible = false
					end
				end)
			end
		end)
	end

	header.MouseEnter:Connect(function()
		header.BackgroundColor3 = REBIND_BG_HOVER
	end)
	header.MouseLeave:Connect(function()
		header.BackgroundColor3 = REBIND_BG_IDLE
	end)
	OS_attachHelpTooltip(header, titleText)
end

