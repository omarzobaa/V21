function OS_wireGravitySection()
	setGravityValue = function(value: number, showLimitError: boolean?)
		local newValue = math.floor(value + 0.5)
		if newValue < 0 then newValue = 0 end
		if newValue > GRAVITY_INPUT_MAX then
			newValue = GRAVITY_INPUT_MAX
			if showLimitError then
				OS_showGravityError(("Max is %d"):format(GRAVITY_INPUT_MAX))
			end
		end
		gravityValue = newValue
		gravityValueBox.Text = tostring(newValue)
		getgenv().walkSpeedSettings.Gravity.Value = newValue
		Workspace.Gravity = newValue
		OS_updateGravitySliderVisual(newValue)
	end
	OS_setGravityValue = setGravityValue

	gravitySliderTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingGravitySlider = true
			dragLock = true
			OS_updateGravitySliderFromX(input.Position.X)
		end
	end)

	gravitySliderKnobOuter.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingGravitySlider = true
			dragLock = true
			OS_updateGravitySliderFromX(input.Position.X)
		end
	end)

	OS_CONNECT(UserInputService.InputChanged:Connect(function(input)
		if not draggingGravitySlider then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		OS_updateGravitySliderFromX(input.Position.X)
	end))

	OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingGravitySlider = false
			clearDragLockIfIdle()
		end
	end))

	gravityValueBox.Focused:Connect(function()
		dragLock = true
	end)
	gravityValueBox.FocusLost:Connect(function()
		clearDragLockIfIdle()
		local parsed = tonumber(gravityValueBox.Text)
		if not parsed then
			gravityValueBox.Text = tostring(math.floor(gravityValue + 0.5))
			OS_showGravityError("Numbers only")
			return
		end
		setGravityValue(parsed, true)
	end)

	setGravityValue(gravityValue)
end

