function OS_playerToolsBindActionButtons()
	local function getTrackedPlayers(requireSpawned: boolean?)
		local list = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			local hum = requireSpawned and OS_playerToolsGetPlayerHumanoid(plr) or nil
			local root = requireSpawned and OS_playerToolsGetPlayerRoot(plr) or nil
			if plr ~= LocalPlayer and (not requireSpawned or (hum and hum.Health > 0 and root)) then
				list[#list + 1] = plr
			end
		end
		table.sort(list, function(a, b)
			return string.lower(a.Name) < string.lower(b.Name)
		end)
		return list
	end

	local function getNearestTrackedPlayer()
		local list = getTrackedPlayers(true)
		if #list == 0 then
			return nil
		end

		local localRoot = OS_playerToolsGetLocalRoot()
		local localCFrame = localRoot and OS_playerToolsGetLocalRootCFrame(localRoot)
		local referencePosition = localCFrame and localCFrame.Position
		if not referencePosition then
			local currentCamera = OS_syncCurrentCamera()
			referencePosition = currentCamera and currentCamera.CFrame.Position or Vector3.zero
		end

		local nearestPlayer = nil
		local nearestDistance = math.huge
		for _, plr in ipairs(list) do
			local root = OS_playerToolsGetPlayerRoot(plr)
			if root then
				local distance = (root.Position - referencePosition).Magnitude
				if distance < nearestDistance then
					nearestDistance = distance
					nearestPlayer = plr
				end
			end
		end
		return nearestPlayer
	end

	local function selectTrackedPlayer(plr: Player?, startSpectating: boolean?)
		if not plr then
			PLAYERTOOLS.trackAction.setSelected(nil, "No spawned players in server", OS_PLAYERTOOLS_ERROR_COLOR)
			PLAYERTOOLS.refreshTrackButtons()
			return
		end
		PLAYERTOOLS.trackAction.setSelected(plr, "Selected: " .. OS_playerToolsFormatPlayer(plr), OS_PLAYERTOOLS_FOUND_COLOR)
		if startSpectating then
			PLAYERTOOLS.startSpectate(plr)
		elseif PLAYERTOOLS.spectateActive then
			PLAYERTOOLS.startSpectate(plr)
		elseif PLAYERTOOLS.followActive then
			PLAYERTOOLS.followTarget = plr
			PLAYERTOOLS.startSpectate(plr)
		end
	end

	local function stepTrackedPlayer(direction: number)
		if not PLAYERTOOLS.trackModeActive then
			PLAYERTOOLS.trackAction.setStatus("Press Track before switching players.", OS_PLAYERTOOLS_NEUTRAL_COLOR)
			return
		end

		local list = getTrackedPlayers(true)
		if #list == 0 then
			selectTrackedPlayer(nil, false)
			return
		end

		local current = PLAYERTOOLS.trackTarget
		local index = 0
		for i, plr in ipairs(list) do
			if plr == current then
				index = i
				break
			end
		end
		if index == 0 then
			index = direction > 0 and 0 or 1
		end
		index = ((index - 1 + direction) % #list) + 1
		selectTrackedPlayer(list[index], PLAYERTOOLS.trackModeActive)
	end

	PLAYERTOOLS.trackAction.button.MouseButton1Click:Connect(function()
		if PLAYERTOOLS.trackModeActive then
			PLAYERTOOLS.stopAll()
			PLAYERTOOLS.trackAction.setStatus("Track idle", OS_PLAYERTOOLS_NEUTRAL_COLOR)
			return
		end

		local nearest = getNearestTrackedPlayer()
		if not nearest then
			selectTrackedPlayer(nil, false)
			return
		end
		selectTrackedPlayer(nearest, true)
	end)

	PLAYERTOOLS.trackAction.prevButton.MouseButton1Click:Connect(function()
		stepTrackedPlayer(-1)
	end)

	PLAYERTOOLS.trackAction.nextButton.MouseButton1Click:Connect(function()
		stepTrackedPlayer(1)
	end)

	PLAYERTOOLS.trackAction.teleportButton.MouseButton1Click:Connect(function()
		local plr = PLAYERTOOLS.trackTarget or PLAYERTOOLS.trackAction.resolve()
		if not plr then return end
		PLAYERTOOLS.teleportToPlayer(plr)
	end)

	PLAYERTOOLS.trackAction.followButton.MouseButton1Click:Connect(function()
		local plr = PLAYERTOOLS.trackTarget or PLAYERTOOLS.trackAction.resolve()
		if not plr then return end
		if PLAYERTOOLS.followActive and PLAYERTOOLS.followTarget == plr then
			PLAYERTOOLS.stopFollow("Follow idle", OS_PLAYERTOOLS_NEUTRAL_COLOR)
			return
		end
		PLAYERTOOLS.startFollow(plr)
	end)
end

