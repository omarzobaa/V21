function OS_applyConfig(config)
	if type(config) ~= "table" then
		return false, "Config is not valid"
	end
	config = OS_expandConfig(config)

	local arms = type(config.arms) == "table" and config.arms or {}
	espArmed = arms.esp == true
	aimArmed = arms.aim == true
	noclipArmed = arms.noclip == true
	flingArmed = arms.fling == true
	invisArmed = arms.invis == true
	teleportArmed = arms.teleport == true
	WALK_ARMED = arms.walk == true
	FLY_ARMED = arms.fly == true
	if espArmCtl then espArmCtl.setOn(espArmed, true) end
	if aimArmCtl then aimArmCtl.setOn(aimArmed, true) end
	if noclipArmCtl then noclipArmCtl.setOn(noclipArmed, true) end
	if flingArmCtl then flingArmCtl.setOn(flingArmed, true) end
	if invisArmCtl then invisArmCtl.setOn(invisArmed, true) end
	if teleportArmCtl then teleportArmCtl.setOn(teleportArmed, true) end
	if walkSpeedEnabledCtl then walkSpeedEnabledCtl.setOn(WALK_ARMED, true) end
	if flyEnabledCtl then flyEnabledCtl.setOn(FLY_ARMED, true) end

	local active = type(config.active) == "table" and config.active or {}
	espEnabled = active.esp == true and espArmed
	if not espEnabled then
		removeAllHighlights()
	end
	if active.aim == true and aimArmed then
		aimStart()
	else
		aimStop()
	end
	if active.noclip == true and noclipArmed then
		setNoclipState(true)
	else
		setNoclipState(false)
	end
	local invisState = getgenv()._osInspectorIntegratedInvis
	if type(invisState) == "table" and type(invisState.set) == "function" then
		invisState.set(active.invis == true and invisArmed)
	end

	local aim = type(config.aim) == "table" and config.aim or {}
	if type(aim.mode) == "string" and setAimControlMode then
		setAimControlMode(aim.mode, true)
	end
	aimTargetSwitchEnabled = aim.targetSwitch == true
	if aimTargetSwitchCtl then aimTargetSwitchCtl.setOn(aimTargetSwitchEnabled, true) end
	aimPredictionEnabled = aim.predictionEnabled == true
	if aimPredictionCtl then aimPredictionCtl.setOn(aimPredictionEnabled, true) end
	if OS_setAimPredictionValue and tonumber(aim.predictionValue) then
		OS_setAimPredictionValue(tonumber(aim.predictionValue), true)
	end
	if OS_setAimSmoothnessValue and tonumber(aim.smoothnessValue) then
		OS_setAimSmoothnessValue(tonumber(aim.smoothnessValue), true)
	end
	if PLAYERTOOLS then
		PLAYERTOOLS.npcEspEnabled = aim.npcEsp == true
		PLAYERTOOLS.npcAimEnabled = aim.npcAim == true
	end
	if npcEspBtn then
		npcEspBtn.Text = PLAYERTOOLS.npcEspEnabled and "NPC ESP: ON" or "NPC ESP: OFF"
		setPillToggleVisual(npcEspBtn, PLAYERTOOLS.npcEspEnabled)
	end
	if npcAimBtn then
		npcAimBtn.Text = PLAYERTOOLS.npcAimEnabled and "NPC AIM: ON" or "NPC AIM: OFF"
		setPillToggleVisual(npcAimBtn, PLAYERTOOLS.npcAimEnabled)
	end
	if PLAYERTOOLS and (PLAYERTOOLS.npcEspEnabled == true or PLAYERTOOLS.npcAimEnabled == true) then
		requestNpcTargetsRebuild()
	else
		for model in pairs(NPCTargets) do
			removeHighlight(model)
		end
		table.clear(NPCTargets)
	end
	if tonumber(aim.targetPlayerUserId) then
		local savedAimPlayer = OS_findPlayerByUserId(aim.targetPlayerUserId)
		local savedAimChar = savedAimPlayer and savedAimPlayer.Character
		if savedAimChar and alive(savedAimChar) then
			local savedAimPart = getAimCandidatePart(savedAimChar, tostring(aim.targetPartName or selectedPartName))
			if savedAimPart then
				setAimTarget(savedAimPart)
			end
		end
	end

	local hitbox = type(config.hitbox) == "table" and config.hitbox or {}
	if type(hitbox.selectedPart) == "string" and hitbox.selectedPart ~= "" then
		if type(OS_setSelectedHitboxPart) == "function" then
			OS_setSelectedHitboxPart(hitbox.selectedPart)
		else
			selectedPartName = hitbox.selectedPart
		end
	end

	local player = type(config.player) == "table" and config.player or {}
	if setWalkSpeedValue and tonumber(player.walkSpeed) then
		setWalkSpeedValue(tonumber(player.walkSpeed), true)
	end
	if setFlySpeedValue and tonumber(player.flySpeed) then
		setFlySpeedValue(tonumber(player.flySpeed), true)
	end
	walkSpeedInstant = player.walkInstant == true
	getgenv().walkSpeedSettings.WalkSpeed.Instant = walkSpeedInstant
	if walkSpeedInstantBtn then
		walkSpeedInstantBtn.Text = walkSpeedInstant and "Instantanious: ON" or "Instantanious: OFF"
		setPillToggleVisual(walkSpeedInstantBtn, walkSpeedInstant)
	end
	if OS_setBrightnessValue and tonumber(player.brightness) then
		OS_setBrightnessValue(tonumber(player.brightness), true)
	end
	if OS_setJumpPowerValue and tonumber(player.jumpPower) then
		OS_setJumpPowerValue(tonumber(player.jumpPower), true)
	end
	if OS_setGravityValue and tonumber(player.gravity) then
		OS_setGravityValue(tonumber(player.gravity), true)
	end

	local pov = type(config.pov) == "table" and config.pov or {}
	if OS_POVCAM then
		if pov.enabled ~= nil then
			OS_POVCAM.enabled = pov.enabled == true
		end
		if pov.wallIgnore ~= nil then
			OS_POVCAM.wallIgnore = pov.wallIgnore == true
		end
		if pov.transparentWalls ~= nil then
			OS_POVCAM.transparentWalls = pov.transparentWalls == true
		end
		if tonumber(pov.minZoom) then
			OS_POVCAM.minZoom = math.max(0.5, tonumber(pov.minZoom))
		end
		if tonumber(pov.maxZoom) then
			OS_POVCAM.maxZoom = math.max(OS_POVCAM.minZoom or 0.5, tonumber(pov.maxZoom))
		end
		if tonumber(pov.savedMaxZoom) then
			OS_POVCAM.savedMaxZoom = math.max(OS_POVCAM.minZoom or 0.5, tonumber(pov.savedMaxZoom))
		else
			OS_POVCAM.savedMaxZoom = nil
		end
		OS_applyPovCameraState(not OS_POVCAM.enabled)
		OS_updatePovWallTransparency()
		if type(OS_refreshPovUi) == "function" then
			OS_refreshPovUi()
		end
	end

	local freecam = type(config.freecam) == "table" and config.freecam or {}
	if FREECAM and type(FREECAM.settings) == "table" and type(freecam.settings) == "table" then
		for key, value in pairs(freecam.settings) do
			if FREECAM.settings[key] ~= nil then
				FREECAM.settings[key] = value
			end
		end
		for _, refresh in ipairs(FREECAM.refreshUi or {}) do
			pcall(refresh)
		end
		if freecam.enabled == true and type(FREECAM.start) == "function" then
			FREECAM.start()
		elseif freecam.enabled == false and FREECAM.enabled and type(FREECAM.stop) == "function" then
			FREECAM.stop(false)
		end
	end

	local ui = type(config.ui) == "table" and config.ui or {}
	OS_applyUiConfig(ui)

	local playerTools = type(config.playerTools) == "table" and config.playerTools or {}
	OS_applyPlayerToolsConfig(playerTools)

	infiniteJumpEnabled = active.infiniteJump == true
	getgenv().walkSpeedSettings.Jump.Infinite = infiniteJumpEnabled
	if OS_infiniteJumpCtl then OS_infiniteJumpCtl.setOn(infiniteJumpEnabled, true) end
	jumpPowerEnabled = active.jumpPower == true
	getgenv().walkSpeedSettings.Jump.PowerEnabled = jumpPowerEnabled
	if OS_jumpPowerEnabledCtl then OS_jumpPowerEnabledCtl.setOn(jumpPowerEnabled, true) end
	applyJumpPower()
	if setWalkSpeedEnabledState then
		setWalkSpeedEnabledState(false, true)
	end
	if setFlyEnabledState then
		setFlyEnabledState(false, true)
	end
	if active.fly == true and FLY_ARMED and setFlyEnabledState then
		setFlyEnabledState(true, true)
	elseif active.walkSpeed == true and WALK_ARMED and setWalkSpeedEnabledState then
		setWalkSpeedEnabledState(true, true)
	end
	if active.fling == true and flingArmed then
		setFlingEnabled(true, true)
	else
		setFlingEnabled(false, true)
	end

	local binds = type(config.binds) == "table" and config.binds or {}
	espBind = OS_configToBind(binds.esp, espBind)
	aimBind = OS_configToBind(binds.aim, aimBind)
	noclipBind = OS_configToBind(binds.noclip, noclipBind)
	walkBind = OS_configToBind(binds.walk, walkBind)
	flyBind = OS_configToBind(binds.fly, flyBind)
	invisBind = OS_configToBind(binds.invis, invisBind)
	flingBind = OS_configToBind(binds.fling, flingBind)
	teleportBind = OS_configToBind(binds.teleport, teleportBind)
	OS_refreshConfigBindButtons()

	if refreshAimModeUi then refreshAimModeUi() end
	pulseUI()
	return true, "Config loaded"
end

OS_CONFIG_EXPORT_PREFIX = "FRC2:"
OS_CONFIG_EXPORT_KEY = "FractureConfigV2"
OS_CONFIG_B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function OS_trimConfigText(text: string?): string
	return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

function OS_byteXor(a: number, b: number): number
	if bit32 and type(bit32.bxor) == "function" then
		return bit32.bxor(a, b)
	end
	local result = 0
	local bitValue = 1
	while a > 0 or b > 0 do
		local abit = a % 2
		local bbit = b % 2
		if abit ~= bbit then
			result += bitValue
		end
		a = math.floor(a / 2)
		b = math.floor(b / 2)
		bitValue *= 2
	end
	return result
end

function OS_xorConfigText(text: string): string
	local key = OS_CONFIG_EXPORT_KEY
	local out = table.create(#text)
	for i = 1, #text do
		local keyByte = key:byte(((i - 1) % #key) + 1)
		out[i] = string.char(OS_byteXor(text:byte(i), keyByte))
	end
	return table.concat(out)
end

function OS_base64Encode(data: string): string
	local bytes = { data:byte(1, #data) }
	local out = {}
	for i = 1, #bytes, 3 do
		local a = bytes[i] or 0
		local b = bytes[i + 1] or 0
		local c = bytes[i + 2] or 0
		local triple = (a * 65536) + (b * 256) + c
		local one = math.floor(triple / 262144) % 64
		local two = math.floor(triple / 4096) % 64
		local three = math.floor(triple / 64) % 64
		local four = triple % 64
		table.insert(out, OS_CONFIG_B64_CHARS:sub(one + 1, one + 1))
		table.insert(out, OS_CONFIG_B64_CHARS:sub(two + 1, two + 1))
		table.insert(out, bytes[i + 1] and OS_CONFIG_B64_CHARS:sub(three + 1, three + 1) or "=")
		table.insert(out, bytes[i + 2] and OS_CONFIG_B64_CHARS:sub(four + 1, four + 1) or "=")
	end
	return table.concat(out)
end

function OS_base64Decode(data: string): string?
	data = OS_trimConfigText(data):gsub("%s+", "")
	if data == "" or data:find("[^A-Za-z0-9%+/=]") then
		return nil
	end
	local out = {}
	for i = 1, #data, 4 do
		local chunk = data:sub(i, i + 3)
		if #chunk < 4 then
			return nil
		end
		local values = {}
		local padding = 0
		for j = 1, 4 do
			local ch = chunk:sub(j, j)
			if ch == "=" then
				values[j] = 0
				padding += 1
			else
				local index = OS_CONFIG_B64_CHARS:find(ch, 1, true)
				if not index then
					return nil
				end
				values[j] = index - 1
			end
		end
		local triple = (values[1] * 262144) + (values[2] * 4096) + (values[3] * 64) + values[4]
		local a = math.floor(triple / 65536) % 256
		local b = math.floor(triple / 256) % 256
		local c = triple % 256
		table.insert(out, string.char(a))
		if padding < 2 then table.insert(out, string.char(b)) end
		if padding < 1 then table.insert(out, string.char(c)) end
	end
	return table.concat(out)
end

function OS_encodeConfig(config): string
	return HttpService:JSONEncode(OS_compactConfig(config))
end

function OS_encodePortableConfig(config): string
	local json = OS_encodeConfig(config)
	return OS_CONFIG_EXPORT_PREFIX .. OS_base64Encode(OS_xorConfigText(json))
end

function OS_decodeConfig(text: string)
	text = OS_trimConfigText(text)
	if text:sub(1, #OS_CONFIG_EXPORT_PREFIX) == OS_CONFIG_EXPORT_PREFIX then
		local decodedText = OS_base64Decode(text:sub(#OS_CONFIG_EXPORT_PREFIX + 1))
		if not decodedText then
			return nil
		end
		text = OS_xorConfigText(decodedText)
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(text)
	end)
	if ok then
		return OS_expandConfig(decoded)
	end
	return nil
end

function OS_saveConfigToFile()
	if not OS_hasFileApi() then
		OS_configStatus("File save not supported by this executor")
		return
	end
	if not OS_ensureConfigFolder() then
		OS_configStatus("Could not create " .. OS_CONFIG_FOLDER)
		return
	end
	local ok, err = pcall(function()
		writefile(OS_CONFIG_FILE, OS_encodeConfig(OS_captureConfig()))
	end)
	OS_configStatus(ok and ("Saved " .. OS_CONFIG_FILE) or ("Save failed: " .. tostring(err)))
end

function OS_loadConfigFromFile(silent: boolean?)
	if not OS_hasFileApi() then
		if not silent then OS_configStatus("File load not supported by this executor") end
		return false
	end
	if not isfile(OS_CONFIG_FILE) then
		if not silent then OS_configStatus("No saved config yet") end
		return false
	end
	local ok, text = pcall(function()
		return readfile(OS_CONFIG_FILE)
	end)
	if not ok then
		if not silent then OS_configStatus("Could not read config") end
		return false
	end
	local decoded = OS_decodeConfig(text)
	local applied, message = OS_applyConfig(decoded)
	if not silent or applied then
		OS_configStatus(message or "Config load failed")
	end
	return applied
end

