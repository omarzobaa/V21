ensureBrightnessEffect = function()
	local lighting = game:GetService("Lighting")
	local effect = lighting:FindFirstChild("OSBrightnessControl")
	if effect and effect:IsA("ColorCorrectionEffect") then
		return effect
	end
	if effect then
		effect:Destroy()
	end
	effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "OSBrightnessControl"
	effect.Parent = lighting
	return effect
end

restoreBrightnessLighting = function()
	local base = BRIGHTNESS_CONTROL.base
	if not base then return end

	local lighting = game:GetService("Lighting")
	lighting.Brightness = base.Brightness
	lighting.ExposureCompensation = base.ExposureCompensation
	lighting.Ambient = base.Ambient
	lighting.OutdoorAmbient = base.OutdoorAmbient
	lighting.ColorShift_Top = base.ColorShift_Top
	lighting.ColorShift_Bottom = base.ColorShift_Bottom
	lighting.EnvironmentDiffuseScale = base.EnvironmentDiffuseScale
	lighting.EnvironmentSpecularScale = base.EnvironmentSpecularScale
	lighting.GlobalShadows = base.GlobalShadows

	local effect = ensureBrightnessEffect()
	effect.Enabled = false
	effect.Brightness = 0
	effect.Contrast = 0
	effect.Saturation = 0
	effect.TintColor = Color3.fromRGB(255, 255, 255)
end

applyBrightnessLevel = function(value: number)
	local base = BRIGHTNESS_CONTROL.base
	if not base then return end

	local newValue = math.clamp(math.floor(value + 0.5), 0, 100)
	BRIGHTNESS_CONTROL.value = newValue

	if newValue == 50 then
		restoreBrightnessLighting()
		return
	end

	local lighting = game:GetService("Lighting")
	local effect = ensureBrightnessEffect()
	effect.Enabled = true
	effect.Saturation = 0
	effect.TintColor = Color3.fromRGB(255, 255, 255)

	if newValue > 50 then
		local alpha = math.clamp((newValue - 50) / 40, 0, 1)
		alpha = alpha * alpha
		local overdrive = math.clamp((newValue - 90) / 10, 0, 1)
		lighting.Brightness = base.Brightness + ((24 - base.Brightness) * alpha)
		lighting.ExposureCompensation = base.ExposureCompensation + ((5 - base.ExposureCompensation) * alpha)
		lighting.Ambient = base.Ambient:Lerp(Color3.fromRGB(255, 255, 255), alpha)
		lighting.OutdoorAmbient = base.OutdoorAmbient:Lerp(Color3.fromRGB(255, 255, 255), alpha)
		lighting.ColorShift_Top = base.ColorShift_Top:Lerp(Color3.fromRGB(255, 255, 255), alpha)
		lighting.ColorShift_Bottom = base.ColorShift_Bottom:Lerp(Color3.fromRGB(255, 255, 255), alpha)
		lighting.EnvironmentDiffuseScale = base.EnvironmentDiffuseScale + ((1 - base.EnvironmentDiffuseScale) * alpha)
		lighting.EnvironmentSpecularScale = base.EnvironmentSpecularScale + ((1 - base.EnvironmentSpecularScale) * alpha)
		lighting.GlobalShadows = false
		effect.Brightness = alpha + (0.18 * overdrive)
		effect.Contrast = (-0.1 * alpha) - (0.05 * overdrive)
		if overdrive > 0 then
			lighting.Brightness += 3 * overdrive
			lighting.ExposureCompensation += 0.75 * overdrive
		end
		return
	end

	local alpha = math.clamp((50 - newValue) / 35, 0, 1)
	alpha = alpha * alpha
	local overdark = math.clamp((15 - newValue) / 15, 0, 1)
	lighting.Brightness = base.Brightness * (1 - alpha)
	lighting.ExposureCompensation = base.ExposureCompensation + ((-5 - base.ExposureCompensation) * alpha)
	lighting.Ambient = base.Ambient:Lerp(Color3.fromRGB(0, 0, 0), alpha)
	lighting.OutdoorAmbient = base.OutdoorAmbient:Lerp(Color3.fromRGB(0, 0, 0), alpha)
	lighting.ColorShift_Top = base.ColorShift_Top:Lerp(Color3.fromRGB(0, 0, 0), alpha)
	lighting.ColorShift_Bottom = base.ColorShift_Bottom:Lerp(Color3.fromRGB(0, 0, 0), alpha)
	lighting.EnvironmentDiffuseScale = base.EnvironmentDiffuseScale * (1 - alpha)
	lighting.EnvironmentSpecularScale = base.EnvironmentSpecularScale * (1 - alpha)
	lighting.GlobalShadows = base.GlobalShadows
	effect.Brightness = -alpha - (0.15 * overdark)
	effect.Contrast = (alpha * 0.35) + (0.1 * overdark)
	if overdark > 0 then
		lighting.ExposureCompensation -= 0.75 * overdark
	end
end

