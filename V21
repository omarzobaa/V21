function OS_resetEverything()
	OS_PENDING_UI_CONFIG = nil
	OS_PENDING_PLAYERTOOLS_CONFIG = nil
	OS_GUI_TARGET_FPS = OS_GUI_TARGET_FPS_MAX or 30
	OS_RAINBOW_KEYPOINT_STEPS = 8
	if OS_RAINBOW_UPDATE_INTERVAL then
		OS_RAINBOW_UPDATE_INTERVAL = 1 / OS_GUI_TARGET_FPS
	end
	if OS_SCROLLBAR_UPDATE_INTERVAL then
		OS_SCROLLBAR_UPDATE_INTERVAL = 1 / math.min(OS_GUI_TARGET_FPS, 60)
	end
	resetMainTabState()
	if FREECAM then
		if FREECAM.enabled and type(FREECAM.stop) == "function" then
			FREECAM.stop(false)
		end
		if type(OS_resetFreecamSettings) == "function" then
			OS_resetFreecamSettings()
		end
	end
	if type(OS_resetPovState) == "function" then
		OS_resetPovState()
	end
	if type(OS_setSelectedHitboxPart) == "function" then
		OS_setSelectedHitboxPart("Head")
	else
		selectedPartName = "Head"
	end
	OS_resetPlayerToolsState()
	if OS_CONFIG_CODE_BOX then
		OS_CONFIG_CODE_BOX.Text = ""
	end
	if OS_hasFileApi() and OS_ensureConfigFolder() then
		pcall(function()
			writefile(OS_CONFIG_FILE, OS_encodeConfig(OS_captureConfig()))
		end)
	end
	OS_configStatus("Everything reset")
end

function OS_getTeleportQueueFunction()
	if type(queue_on_teleport) == "function" then
		return queue_on_teleport
	end
	if type(queueonteleport) == "function" then
		return queueonteleport
	end
	if type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
		return syn.queue_on_teleport
	end
	if type(syn) == "table" and type(syn.queueonteleport) == "function" then
		return syn.queueonteleport
	end
	if type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" then
		return fluxus.queue_on_teleport
	end
	if type(fluxus) == "table" and type(fluxus.queueonteleport) == "function" then
		return fluxus.queueonteleport
	end
	return nil
end

function OS_getTeleportSource()
	local source = getgenv().OS_SCRIPT_SOURCE or getgenv()._osInspectorScriptSource
	if type(source) == "string" and #source > 0 then
		return source
	end
	if OS_hasFileApi() and isfile(OS_AUTORUN_FILE) then
		return ([[
local path = %q
if type(readfile) ~= "function" or type(loadstring) ~= "function" then
	return
end
local ok, source = pcall(function()
	return readfile(path)
end)
if ok and type(source) == "string" and #source > 0 then
	loadstring(source)()
end
]]):format(OS_AUTORUN_FILE)
	end
	return nil
end

function OS_queueSelfOnTeleport(silent: boolean?)
	local queueFn = OS_getTeleportQueueFunction()
	if not queueFn then
		if not silent then OS_configStatus("Teleport queue not supported by this executor") end
		return false
	end
	local source = OS_getTeleportSource()
	if not source then
		if not silent then OS_configStatus("Put a loader in " .. OS_AUTORUN_FILE) end
		return false
	end
	local ok, err = pcall(function()
		queueFn(source)
	end)
	if not silent then
		OS_configStatus(ok and "Queued for next teleport" or ("Queue failed: " .. tostring(err)))
	end
	return ok
end

function OS_enableTeleportAutoQueue()
	if OS_TELEPORT_QUEUE_CONN then
		return
	end
	local ok, conn = pcall(function()
		return LocalPlayer.OnTeleport:Connect(function(state)
			local stateText = tostring(state)
			if stateText:find("Failed") then
				return
			end
			OS_saveConfigToFile()
			OS_queueSelfOnTeleport(true)
		end)
	end)
	if ok and conn then
		OS_TELEPORT_QUEUE_CONN = OS_CONNECT(conn)
	end
end

