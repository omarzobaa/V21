	mk("UICorner", { CornerRadius = UDim.new(1, 0), Parent = FREECAM.mobileDownBtn })
	mk("UIStroke", { Thickness = 1, Color = THEME_ACCENT, Transparency = 0, Parent = FREECAM.mobileUpBtn })
	mk("UIStroke", { Thickness = 1, Color = THEME_ACCENT, Transparency = 0, Parent = FREECAM.mobileDownBtn })

	FREECAM.mobileUpBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then FREECAM.moveUp = true end
	end)
	FREECAM.mobileUpBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then FREECAM.moveUp = false end
	end)
	FREECAM.mobileDownBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then FREECAM.moveDown = true end
	end)
	FREECAM.mobileDownBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then FREECAM.moveDown = false end
	end)

	OS_CONNECT(UserInputService.InputBegan:Connect(function(input)
		if not OS_EXEC_IS_CURRENT() then return end
		if not FREECAM.enabled then return end
		if OS_isStrongGuiPointerInput(input) then return end
		if input.UserInputType == Enum.UserInputType.Touch and input.Position.X > (Camera.ViewportSize.X / 2) then
			FREECAM.lookTouch = input
			FREECAM.lookTouchPos = input.Position
		end
	end))
	OS_CONNECT(UserInputService.InputChanged:Connect(function(input)
		if not OS_EXEC_IS_CURRENT() then return end
		if not FREECAM.enabled then return end
		if FREECAM.lookTouch and input == FREECAM.lookTouch and FREECAM.lookTouchPos then
			local delta = input.Position - FREECAM.lookTouchPos
			local sensitivity = FREECAM.settings.lookSensitivity * 0.0008
			FREECAM.rotation += Vector2.new(-delta.Y * sensitivity, -delta.X * sensitivity)
			FREECAM.lookTouchPos = input.Position
		end
	end))
	OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
		if not OS_EXEC_IS_CURRENT() then return end
		if input == FREECAM.lookTouch then
			FREECAM.lookTouch = nil
			FREECAM.lookTouchPos = nil
		end
		FREECAM.mobileUpBtn.Visible = FREECAM.enabled
		FREECAM.mobileDownBtn.Visible = FREECAM.enabled
	end))

	FREECAM.previousShowUi = OS_showFreecamUi
	FREECAM.mobileShowUi = function()
		if FREECAM.previousShowUi then
			FREECAM.previousShowUi()
		end
		FREECAM.mobileUpBtn.Visible = true
		FREECAM.mobileDownBtn.Visible = true
	end

	FREECAM.previousHideUi = OS_hideFreecamUi
	FREECAM.mobileHideUi = function()
		FREECAM.mobileUpBtn.Visible = false
		FREECAM.mobileDownBtn.Visible = false
		if FREECAM.previousHideUi then
			FREECAM.previousHideUi()
		end
	end
end

function OS_initFreecamDesktopInput()
	OS_CONNECT(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not OS_EXEC_IS_CURRENT() then return end
		if not FREECAM.enabled then return end
		if OS_isStrongGuiPointerInput(input) then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and not UserInputService:GetFocusedTextBox() then
			if OS_isFreecamMouseUnlockKey(input.KeyCode) then
				FREECAM.mouseUnlocked = not (FREECAM.mouseUnlocked == true)
				OS_resetFreecamLookDrag()
				if FREECAM.mouseUnlocked then
					OS_releaseFreecamMouse()
				end
				return
			end
			if gameProcessed then return end
			OS_setFreecamMoveKey(input.KeyCode, true)
			return
		end
		OS_beginFreecamLookDrag(input)
	end))
	OS_CONNECT(UserInputService.InputChanged:Connect(function(input)
		if not OS_EXEC_IS_CURRENT() then return end
		if not FREECAM.enabled then return end
		OS_updateFreecamLookDrag(input)
	end))
	OS_CONNECT(UserInputService.InputEnded:Connect(function(input)
		if not OS_EXEC_IS_CURRENT() then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if OS_isFreecamMouseUnlockKey(input.KeyCode) then
				return
			end
			OS_setFreecamMoveKey(input.KeyCode, false)
			return
		end
		OS_endFreecamLookDrag(input)
	end))
end

