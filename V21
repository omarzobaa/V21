OS_PLAYERTOOLS_FOUND_COLOR = THEME_SUCCESS
OS_PLAYERTOOLS_WARNING_COLOR = THEME_ACCENT
OS_PLAYERTOOLS_ERROR_COLOR = THEME_DANGER
OS_PLAYERTOOLS_NEUTRAL_COLOR = THEME_MUTED

function OS_playerToolsFormatPlayer(plr: Player)
	if plr.DisplayName ~= plr.Name then
		return ("%s (@%s)"):format(plr.DisplayName, plr.Name)
	end
	return plr.Name
end

function OS_playerToolsGetPlayerHumanoid(plr: Player)
	local char = plr and plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Parent == char then
		return hum
	end
	return nil
end

function OS_playerToolsGetPlayerRoot(plr: Player)
	local char = plr and plr.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso"))
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function OS_playerToolsGetLocalRoot()
	local char = LocalPlayer.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso"))
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function OS_playerToolsGetLocalRootCFrame(root: BasePart?)
	root = root or OS_playerToolsGetLocalRoot()
	if not (root and root.Parent) then
		return nil
	end

	local invisState = getgenv()._osInspectorIntegratedInvis
	if type(invisState) == "table" and invisState.on == true and invisState.root == root and invisState.restore then
		return invisState.restore
	end

	return root.CFrame
end

function OS_playerToolsGetBehindTargetCFrame(targetRoot: BasePart, distance: number?)
	distance = distance or 0.5
	local look = targetRoot.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude <= 1e-4 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end
	local targetPosition = targetRoot.Position - (flatLook * distance)
	return CFrame.new(targetPosition, targetPosition + flatLook)
end

function OS_playerToolsTeleportLocalRoot(root: BasePart, targetCFrame: CFrame)
	if not (root and root.Parent) then
		return false
	end

	local invisState = getgenv()._osInspectorIntegratedInvis
	if type(invisState) == "table" and invisState.on == true and invisState.root == root then
		invisState.restore = targetCFrame
		root.CFrame = targetCFrame * CFrame.new(-200000, 0, 0)
	else
		root.CFrame = targetCFrame
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

function OS_playerToolsTrimText(text: string?)
	return (text or ""):match("^%s*(.-)%s*$") or ""
end

function OS_playerToolsCollectMatchNames(group)
	local names = {}
	for i = 1, math.min(#group, 3) do
		names[i] = group[i].Name
	end
	return table.concat(names, ", ")
end

function OS_resolveServerPlayer(query: string?)
	local text = string.lower(OS_playerToolsTrimText(query))
	if text == "" then
		return nil, "Enter a username", "empty"
	end

	local exactName = {}
	local exactDisplay = {}
	local prefixName = {}
	local prefixDisplay = {}
	local containsName = {}
	local containsDisplay = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local name = string.lower(plr.Name)
			local display = string.lower(plr.DisplayName)
			if name == text then
				exactName[#exactName + 1] = plr
			elseif display == text then
				exactDisplay[#exactDisplay + 1] = plr
			elseif string.sub(name, 1, #text) == text then
				prefixName[#prefixName + 1] = plr
			elseif string.sub(display, 1, #text) == text then
				prefixDisplay[#prefixDisplay + 1] = plr
			elseif string.find(name, text, 1, true) then
				containsName[#containsName + 1] = plr
			elseif string.find(display, text, 1, true) then
				containsDisplay[#containsDisplay + 1] = plr
			end
		end
	end

	local groups = { exactName, exactDisplay, prefixName, prefixDisplay, containsName, containsDisplay }
	for _, group in ipairs(groups) do
		if #group == 1 then
			return group[1], nil, "found"
		end
		if #group > 1 then
			table.sort(group, function(a, b)
				return a.Name < b.Name
			end)
			return nil, ("Multiple matches: %s"):format(OS_playerToolsCollectMatchNames(group)), "multiple"
		end
	end

	return nil, "Player not found", "missing"
end

function OS_createPlayerAction(nextPlayerOrder: () -> number, titleText: string, buttonText: string)
	local card = mk("Frame", {
		LayoutOrder = nextPlayerOrder(),
		Size = UDim2.new(1, 0, 0, S(124)),
		BackgroundColor3 = THEME_CARD_ALT,
		BorderSizePixel = 0,
		ZIndex = 53,
		Parent = pagePlayer,
	})
	mk("UICorner", { CornerRadius = UDim.new(0, S(18)), Parent = card })
	mk("UIStroke", { Thickness = 1.15, Color = THEME_STROKE, Transparency = 0.08, Parent = card })
	mk("TextLabel", {
		Size = UDim2.new(1, -S(20), 0, S(18)),
		Position = UDim2.fromOffset(S(10), S(10)),
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(21),
		TextColor3 = THEME_ACCENT,
		Text = titleText,
		ZIndex = 54,
		Parent = card,
	})

	local box = mk("TextBox", {
		Size = UDim2.new(1, -(FULL_WIDTH_INSET * 2), 0, BUTTON_HEIGHT),
		Position = UDim2.fromOffset(FULL_WIDTH_INSET, S(36)),
		BackgroundColor3 = THEME_INPUT,
		PlaceholderText = "Enter username or display name",
		Text = "",
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(22),
		TextColor3 = THEME_TEXT,
		PlaceholderColor3 = THEME_MUTED,
		ClearTextOnFocus = false,
		ZIndex = 54,
		Parent = card,
	})
	dragBlockTargets[box] = true
	mk("UICorner", { CornerRadius = UDim.new(0, S(10)), Parent = box })
	mk("UIStroke", { Thickness = 1, Color = THEME_STROKE, Transparency = 0.15, Parent = box })

	local status = mk("TextLabel", {
		Size = UDim2.new(1, -(FULL_WIDTH_INSET * 2), 0, S(14)),
		Position = UDim2.fromOffset(FULL_WIDTH_INSET, S(68)),
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "Enter a player name, then press Enter.",
		Font = Enum.Font.GrenzeGotisch,
		TextSize = S(20),
		TextColor3 = OS_PLAYERTOOLS_NEUTRAL_COLOR,
		ZIndex = 54,
		Parent = card,
	})

	local button = makePillButton(card, buttonText, 86)
	local buttonStroke = button:FindFirstChildOfClass("UIStroke")
	if buttonStroke then
		OS_prepareHoverStroke(buttonStroke, THEME_STROKE, 0.28, 0.34)
		button:SetAttribute("HoverKeepAccentGradient", false)
		button:SetAttribute("HoverBaseStrokeTransparency", 0.28)
		button:SetAttribute("HoverBaseStrokeColor", THEME_STROKE)
	end
	ensurePillTextLayers(button)

	local action = {
		card = card,
		box = box,
		status = status,
		button = button,
	}

	function action.setStatus(text: string, color: Color3)
		status.Text = text
		status.TextColor3 = color
	end

	function action.setButton(text: string)
		button.Text = text
	end

	function action.resolve()
		local plr, message, kind = OS_resolveServerPlayer(box.Text)
		if plr then
			box.Text = plr.Name
			action.setStatus("Found: " .. OS_playerToolsFormatPlayer(plr), OS_PLAYERTOOLS_FOUND_COLOR)
			return plr
		end
		if kind == "multiple" then
			action.setStatus(message, OS_PLAYERTOOLS_WARNING_COLOR)
		elseif kind == "missing" then
			action.setStatus(message, OS_PLAYERTOOLS_ERROR_COLOR)
		else
			action.setStatus(message, OS_PLAYERTOOLS_NEUTRAL_COLOR)
		end
		return nil
	end

	box.Focused:Connect(function()
		dragLock = true
	end)
	box.FocusLost:Connect(function()
		clearDragLockIfIdle()
		action.resolve()
	end)

	return action
end

