local function getHumanoid()
	local character = LocalPlayer.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

function OS_capturePovCameraDefaults()
	if type(OS_POVCAM.base) == "table" and OS_POVCAM.base.placeId == game.PlaceId then
		return OS_POVCAM.base
	end
	OS_POVCAM.base = {
		placeId = game.PlaceId,
		minZoom = LocalPlayer.CameraMinZoomDistance,
		maxZoom = LocalPlayer.CameraMaxZoomDistance,
		cameraMode = LocalPlayer.CameraMode,
	}
	pcall(function()
		OS_POVCAM.base.occlusionMode = LocalPlayer.DevCameraOcclusionMode
	end)
	return OS_POVCAM.base
end

function OS_restorePlayerCamera(subjectHumanoid: Humanoid?)
	local currentCamera = OS_syncCurrentCamera()
	if not currentCamera then return end
	local hum = subjectHumanoid
	if not hum or not hum.Parent then
		hum = getHumanoid()
	end
	currentCamera.CameraType = Enum.CameraType.Custom
	if hum then
		currentCamera.CameraSubject = hum
	end
end

function OS_applyPovCameraState(forceRestore: boolean?)
	OS_syncCurrentCamera()
	local base = OS_capturePovCameraDefaults()
	if forceRestore or not OS_POVCAM.enabled then
		OS_clearPovWallTransparency()
