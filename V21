OS_FREECAM_EXIT_MOUSE_RESET = OS_FREECAM_EXIT_MOUSE_RESET or {
	token = 0,
	devMouseLockBackup = nil,
}

function OS_releaseFreecamMouse()
	pcall(function()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.None
	end)
end

function OS_isFreecamExitInputClear(): boolean
	local shiftDown = false
	pcall(function()
		shiftDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	end)

	local rightDown = false
	pcall(function()
		rightDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	end)

	return not shiftDown and not rightDown
end

function OS_setFreecamExitMouseLockBlocked(blocked: boolean)
	if blocked then
		if OS_FREECAM_EXIT_MOUSE_RESET.devMouseLockBackup == nil then
			local ok, value = pcall(function()
				return LocalPlayer.DevEnableMouseLock
			end)
			if ok then
				OS_FREECAM_EXIT_MOUSE_RESET.devMouseLockBackup = value
			end
		end
		pcall(function()
			LocalPlayer.DevEnableMouseLock = false
		end)
		return
	end

	local backup = OS_FREECAM_EXIT_MOUSE_RESET.devMouseLockBackup
	OS_FREECAM_EXIT_MOUSE_RESET.devMouseLockBackup = nil
	if backup ~= nil then
		pcall(function()
			LocalPlayer.DevEnableMouseLock = backup
		end)
	end
end

function OS_cancelFreecamExitMouseReset()
	OS_FREECAM_EXIT_MOUSE_RESET.token = (OS_FREECAM_EXIT_MOUSE_RESET.token or 0) + 1
	OS_releaseFreecamMouse()
	OS_setFreecamExitMouseLockBlocked(false)
end

function OS_scheduleFreecamExitMouseReset()
	OS_FREECAM_EXIT_MOUSE_RESET.token = (OS_FREECAM_EXIT_MOUSE_RESET.token or 0) + 1
	local token = OS_FREECAM_EXIT_MOUSE_RESET.token
	local startedAt = os.clock()

	OS_setFreecamExitMouseLockBlocked(true)
	OS_releaseFreecamMouse()

	task.spawn(function()
		while OS_EXEC_IS_CURRENT() and OS_FREECAM_EXIT_MOUSE_RESET.token == token do
			OS_releaseFreecamMouse()

			local elapsed = os.clock() - startedAt
			if elapsed >= 1 and OS_isFreecamExitInputClear() then
				break
			end
			if elapsed >= 2.25 then
				break
			end

			RunService.RenderStepped:Wait()
		end

		if OS_FREECAM_EXIT_MOUSE_RESET.token == token then
			OS_releaseFreecamMouse()
			OS_setFreecamExitMouseLockBlocked(false)
		end
	end)
end

function OS_restoreFreecamCharacterState()
	if FREECAM.humanoid and FREECAM.humanoid.Parent and FREECAM.humanoidBackup then
		FREECAM.humanoid.AutoRotate = FREECAM.humanoidBackup.autoRotate
		FREECAM.humanoid.WalkSpeed = FREECAM.humanoidBackup.walkSpeed
		pcall(function() FREECAM.humanoid.JumpPower = FREECAM.humanoidBackup.jumpPower end)
		pcall(function() FREECAM.humanoid.JumpHeight = FREECAM.humanoidBackup.jumpHeight end)
	end
	if FREECAM.rootPart and FREECAM.rootPart.Parent then
		FREECAM.rootPart.Anchored = FREECAM.rootAnchored == true
		FREECAM.rootPart.AssemblyLinearVelocity = Vector3.zero
		FREECAM.rootPart.AssemblyAngularVelocity = Vector3.zero
	end
	if FREECAM.controls and FREECAM.controls.Enable and not FREECAM.isMobile then
		pcall(function()
			FREECAM.controls:Enable()
		end)
	end
end

function OS_discardFreecamFeatureState()
	FREECAM.previousWalkEnabled = false
	FREECAM.previousFlyEnabled = false
end

function OS_restoreFreecamFeatureState()
	local restoreWalk = FREECAM.previousWalkEnabled == true
	local restoreFly = FREECAM.previousFlyEnabled == true
	OS_discardFreecamFeatureState()
	if restoreWalk and type(setWalkSpeedEnabledState) == "function" then
		setWalkSpeedEnabledState(true, true)
	end
	if restoreFly then
		if type(setFlyEnabledState) == "function" then
			setFlyEnabledState(true, true)
		else
			flyEnabled = true
			startFly()
		end
	end
end

function OS_freecamRestoreVisuals()
	local lighting = FREECAM.lighting
	local vignette = FREECAM.vignette
	local destroyEffects = FREECAM.destroyEffects
	local backup = FREECAM.backup
	if backup then
		Camera.FieldOfView = backup.fieldOfView or Camera.FieldOfView
		if lighting then
			lighting.ClockTime = backup.clockTime or lighting.ClockTime
		end
	end
	if type(destroyEffects) == "function" then
		destroyEffects()
	end
	if vignette then
		vignette.Visible = false
		vignette.ImageTransparency = 1
	end
	local chatEnabled = true
	if backup then
		chatEnabled = backup.chatEnabled ~= false
	end
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, chatEnabled)
	end)
end

function OS_freecamApplyVisuals()
	local settings = FREECAM.settings
	local lighting = FREECAM.lighting
	local vignette = FREECAM.vignette
	local ensureEffect = FREECAM.ensureEffect
	if not (settings and lighting and type(ensureEffect) == "function") then
		return
	end

	Camera.FieldOfView = settings.fieldOfView
	lighting.ClockTime = settings.timeOfDay

	local bloom = ensureEffect("BloomEffect", "OSFreecamBloom")
	if settings.bloom > 0 then
		bloom.Enabled = true
		bloom.Intensity = (settings.bloom / 100) * 1.5
		bloom.Size = 24 + ((settings.bloom / 100) * 30)
	else
		bloom.Enabled = false
	end

	local rays = ensureEffect("SunRaysEffect", "OSFreecamSunRays")
	if settings.sunRays > 0 then
		rays.Enabled = true
		rays.Intensity = (settings.sunRays / 100) * 0.5
		rays.Spread = settings.sunRays / 100
	else
		rays.Enabled = false
	end

	local cc = ensureEffect("ColorCorrectionEffect", "OSFreecamCC")
	cc.Enabled = settings.saturation ~= 50 or settings.contrast ~= 50
	cc.Saturation = (settings.saturation - 50) / 50
	cc.Contrast = (settings.contrast - 50) / 100

	local dof = ensureEffect("DepthOfFieldEffect", "OSFreecamDoF")
	local dofActive = settings.blurNear > 0 or settings.blurFar > 0
	dof.Enabled = dofActive
	if dofActive then
		dof.FocusDistance = settings.focusDistance
		dof.InFocusRadius = settings.focusRadius
		dof.NearIntensity = (settings.blurNear / 100) * 1.5
		dof.FarIntensity = (settings.blurFar / 100) * 3
	end

	if vignette then
		if settings.vignette > 0 and FREECAM.enabled then
			vignette.Visible = true
			vignette.ImageTransparency = 1 - (settings.vignette / 100)
		else
			vignette.Visible = false
			vignette.ImageTransparency = 1
		end
	end

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, not settings.hideChat)
	end)
end

function OS_freecamUpdate(dt: number)
	if not FREECAM.enabled then return end

	OS_syncCurrentCamera()
	if Camera.CameraType ~= Enum.CameraType.Scriptable then
		Camera.CameraType = Enum.CameraType.Scriptable
	end

	local isMobile = FREECAM.isMobile == true
	local mouseUnlocked = (not isMobile) and FREECAM.mouseUnlocked == true
	local interacting = dragLock or UserInputService:GetFocusedTextBox() ~= nil or mouseUnlocked
	if isMobile then
		FREECAM.mouseUnlocked = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	else
		local lookDelta = Vector2.zero
		if interacting then
			OS_releaseFreecamMouse()
		else
			pcall(function()
				UserInputService.MouseIconEnabled = true
				UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.None
			end)
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			lookDelta = UserInputService:GetMouseDelta()
		end
		if lookDelta.Magnitude > 0 then
			OS_applyFreecamLookDelta(lookDelta)
		end
	end

	FREECAM.rotation = Vector2.new(math.clamp(FREECAM.rotation.X, -math.pi / 2, math.pi / 2), FREECAM.rotation.Y)

	local moveVector = Vector3.zero
	if isMobile then
		local ensureControls = FREECAM.ensureControls
		local controls = type(ensureControls) == "function" and ensureControls() or nil
		if controls then
			moveVector = controls:GetMoveVector()
		end
	else
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
			moveVector += Vector3.new(0, 0, -1)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
			moveVector += Vector3.new(0, 0, 1)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
			moveVector += Vector3.new(-1, 0, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
			moveVector += Vector3.new(1, 0, 0)
		end
	end

	if isMobile then
		if FREECAM.moveUp then moveVector += Vector3.new(0, 1, 0) end
		if FREECAM.moveDown then moveVector += Vector3.new(0, -1, 0) end
	else
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
			moveVector += Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			moveVector += Vector3.new(0, -1, 0)
		end
	end

	if FREECAM.humanoid and FREECAM.humanoid.Parent then
		FREECAM.humanoid.WalkSpeed = 0
		FREECAM.humanoid.AutoRotate = false
		pcall(function() FREECAM.humanoid.JumpPower = 0 end)
		pcall(function() FREECAM.humanoid.JumpHeight = 0 end)
		FREECAM.humanoid:Move(Vector3.zero, true)
	end

	local rotation = CFrame.fromEulerAnglesYXZ(FREECAM.rotation.X, FREECAM.rotation.Y, 0)
	local position = FREECAM.position or Camera.CFrame.Position
	if moveVector.Magnitude > 0.01 then
		local getSpeed = FREECAM.getSpeed
		local speed = type(getSpeed) == "function" and getSpeed() or OS_getFreecamSpeedValue()
		position += rotation:VectorToWorldSpace(moveVector.Unit) * speed * dt
	end
	FREECAM.position = position
	Camera.CFrame = CFrame.new(position) * rotation
end

function OS_freecamStop(restoreFeatures: boolean?)
	local wasEnabled = FREECAM.enabled == true
	OS_resetFreecamRuntimeState()
	OS_syncCurrentCamera()
	if type(FREECAM.restoreVisuals) == "function" then
		FREECAM.restoreVisuals()
	end
	OS_restoreFreecamCharacterState()
	OS_restorePlayerCamera(FREECAM.humanoid)
	if OS_POVCAM then
		OS_applyPovCameraState(not OS_POVCAM.enabled)
	end
	if wasEnabled and restoreFeatures ~= false then
		OS_restoreFreecamFeatureState()
	else
		OS_discardFreecamFeatureState()
	end
	FREECAM.backup = nil
	FREECAM.humanoid = nil
	FREECAM.humanoidBackup = nil
	FREECAM.rootPart = nil
	FREECAM.rootAnchored = nil
	OS_hideFreecamUi()
	if wasEnabled then
		OS_scheduleFreecamExitMouseReset()
		pulseUI()
	end
end

function OS_freecamStart()
	if FREECAM.enabled then
		OS_showFreecamUi()
		return
	end
	OS_cancelFreecamExitMouseReset()

	if PLAYERTOOLS and PLAYERTOOLS.stopAll then
		PLAYERTOOLS.stopAll()
	end

	FREECAM.previousWalkEnabled = walkSpeedEnabled
	FREECAM.previousFlyEnabled = flyEnabled
	if walkSpeedEnabled then
		setWalkSpeedEnabledState(false, true)
	end
	if flyEnabled then
		setFlyEnabledState(false, true)
	end
	aimStop()

	local lighting = FREECAM.lighting
	local chatEnabledOk, chatEnabledValue = pcall(function()
		return StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Chat)
	end)
	FREECAM.backup = {
		fieldOfView = Camera.FieldOfView,
		clockTime = lighting and lighting.ClockTime or 0,
		chatEnabled = chatEnabledOk and chatEnabledValue or true,
	}

	local humanoid = getHumanoid()
	FREECAM.humanoid = humanoid
	if FREECAM.settings.speed == nil or FREECAM.settings.speed < 1 then
		FREECAM.settings.speed = math.max(25, walkSpeedValue, flySpeedValue)
	end
	if humanoid then
		FREECAM.humanoidBackup = {
			walkSpeed = humanoid.WalkSpeed,
			jumpPower = humanoid.JumpPower,
			jumpHeight = humanoid.JumpHeight,
			autoRotate = humanoid.AutoRotate,
		}
		local root = humanoid.RootPart or humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart")
		FREECAM.rootPart = root
		FREECAM.rootAnchored = root and root.Anchored or false
		humanoid.WalkSpeed = 0
		humanoid.AutoRotate = false
		pcall(function() humanoid.JumpPower = 0 end)
		pcall(function() humanoid.JumpHeight = 0 end)
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	local ensureControls = FREECAM.ensureControls
	local controls = type(ensureControls) == "function" and ensureControls() or nil
	if controls and controls.Disable and not FREECAM.isMobile then
		pcall(function()
			controls:Disable()
		end)
	end

	OS_syncCurrentCamera()
	local lookVector = Camera.CFrame.LookVector
	FREECAM.rotation = Vector2.new(
		math.asin(math.clamp(lookVector.Y, -1, 1)),
		math.atan2(-lookVector.X, -lookVector.Z)
	)
	Camera.CameraType = Enum.CameraType.Scriptable
	FREECAM.position = Camera.CFrame.Position
	FREECAM.enabled = true
	FREECAM.mouseUnlocked = false
	OS_resetFreecamLookDrag()
	if type(FREECAM.resetMoveState) == "function" then
		FREECAM.resetMoveState()
	end
	local setMoveKey = FREECAM.setMoveKey
	if type(setMoveKey) == "function" then
		setMoveKey(Enum.KeyCode.W, UserInputService:IsKeyDown(Enum.KeyCode.W))
		setMoveKey(Enum.KeyCode.Up, UserInputService:IsKeyDown(Enum.KeyCode.Up))
		setMoveKey(Enum.KeyCode.S, UserInputService:IsKeyDown(Enum.KeyCode.S))
		setMoveKey(Enum.KeyCode.Down, UserInputService:IsKeyDown(Enum.KeyCode.Down))
		setMoveKey(Enum.KeyCode.A, UserInputService:IsKeyDown(Enum.KeyCode.A))
		setMoveKey(Enum.KeyCode.Left, UserInputService:IsKeyDown(Enum.KeyCode.Left))
		setMoveKey(Enum.KeyCode.D, UserInputService:IsKeyDown(Enum.KeyCode.D))
		setMoveKey(Enum.KeyCode.Right, UserInputService:IsKeyDown(Enum.KeyCode.Right))
		setMoveKey(Enum.KeyCode.Space, UserInputService:IsKeyDown(Enum.KeyCode.Space))
		setMoveKey(Enum.KeyCode.LeftControl, UserInputService:IsKeyDown(Enum.KeyCode.LeftControl))
	end
	if type(FREECAM.applyVisuals) == "function" then
		FREECAM.applyVisuals()
	end
	if FREECAM.connection then
		FREECAM.connection:Disconnect()
		FREECAM.connection = nil
	end
	FREECAM.connection = RunService.RenderStepped:Connect(function(dt)
		if not OS_EXEC_IS_CURRENT() or not FREECAM.enabled then
			return
		end
		local ok, err = pcall(FREECAM.update, dt)
		if not ok then
			warn("OS Freecam update failed:", err)
		end
	end)
	OS_showFreecamUi()
	pulseUI()
end

