local pulseStrokes = {} :: { UIStroke }
local pulseBaseThickness = {} :: { [UIStroke]: number }
local pulseInFlight = {} :: { [UIStroke]: boolean }
MINI_LOGO_PULSE = nil

local function pulseUI()
	for _, s in ipairs(pulseStrokes) do
		if not (s and s.Parent) then
			pulseInFlight[s] = nil
			pulseBaseThickness[s] = nil
			continue
		end

		-- prevent stacking pulses on same stroke
		if pulseInFlight[s] then
			-- Hard-reset to base so repeated clicks cannot leave it enlarged.
			local base = pulseBaseThickness[s] or s.Thickness
			s.Thickness = base
			continue
		end

		pulseInFlight[s] = true
		local base = pulseBaseThickness[s] or s.Thickness
		pulseBaseThickness[s] = base

		-- always start from base
		s.Thickness = base

		local up = tween(s, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Thickness = base + 2 })
		up.Completed:Connect(function()
			if not (s and s.Parent) then
				pulseInFlight[s] = nil
				return
			end
			local down = tween(s, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Thickness = base })
			down.Completed:Connect(function()
				if s and s.Parent then
					s.Thickness = base
				end
				pulseInFlight[s] = nil
			end)
		end)
	end
	if MINI_LOGO_PULSE then
		MINI_LOGO_PULSE()
	end
end

local function addHover(btn: TextButton)
	local baseColor = btn.BackgroundColor3
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	local textTarget = btn:FindFirstChild("HoverTextLabel")
	if not textTarget or not textTarget:IsA("TextLabel") then
		textTarget = btn
	end
	local baseStrokeColor = stroke and stroke.Color or nil
	local baseStrokeTransparency = stroke and stroke.Transparency or nil
	local baseTextColor = textTarget.TextColor3
	local baseTextStrokeColor = textTarget.TextStrokeColor3
	local baseTextStrokeTransparency = textTarget.TextStrokeTransparency
	local hoverStrokeColor = btn:GetAttribute("HoverStrokeColor")
	local hoverStrokeTransparency = btn:GetAttribute("HoverStrokeTransparency")
	local function strokeKeepsAccent()
		return btn:GetAttribute("HoverKeepAccentGradient")
			and not btn:GetAttribute("HoverRainbowOnly")
			and not (stroke and stroke:GetAttribute("HoverRainbowOnly"))
	end
	local function setStrokeHovered(isHovered: boolean, offColor: Color3?, offTransparency: number?, useTween: boolean?)
		if not stroke then
			return
		end
		local baseOffColor = offColor or baseStrokeColor or THEME_STROKE
		local baseOffTransparency = offTransparency == nil and (baseStrokeTransparency or 0.15) or offTransparency
		if hoverStrokeColor then
			local gradient = stroke:FindFirstChild("OSRainbowAccent")
			if gradient and gradient:IsA("UIGradient") then
				gradient.Enabled = false
			end
			local props = {
				Color = isHovered and hoverStrokeColor or baseOffColor,
				Transparency = isHovered and (hoverStrokeTransparency == nil and 0 or hoverStrokeTransparency) or baseOffTransparency,
			}
			if useTween then
				tween(stroke, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			else
				stroke.Color = props.Color
				stroke.Transparency = props.Transparency
			end
			return
		end
		if isHovered or strokeKeepsAccent() then
			OS_setHoverStrokeGradient(stroke, true, baseOffColor, baseOffTransparency)
			if isHovered and hoverStrokeTransparency ~= nil then
				stroke.Transparency = hoverStrokeTransparency
			end
		else
			OS_setHoverStrokeGradient(stroke, false, baseOffColor, baseOffTransparency)
		end
	end
	btn.MouseEnter:Connect(function()
		if not btn:GetAttribute("HoverKeepAccentGradient") then
			tween(btn, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = btn:GetAttribute("HoverBgColor") or REBIND_BG_HOVER
			})
		end
		tween(textTarget, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextColor3 = btn:GetAttribute("HoverTextColor") or baseTextColor
		})
		tween(textTarget, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextStrokeColor3 = btn:GetAttribute("HoverTextStrokeColor") or baseTextStrokeColor,
			TextStrokeTransparency = btn:GetAttribute("HoverTextStrokeTransparency") == nil and baseTextStrokeTransparency or btn:GetAttribute("HoverTextStrokeTransparency"),
		})
		setStrokeHovered(true, baseStrokeColor, baseStrokeTransparency, true)
	end)
	btn.MouseLeave:Connect(function()
		local leaveColor = btn:GetAttribute("HoverBaseBg") or baseColor
		local leaveStrokeColor = btn:GetAttribute("HoverBaseStrokeColor")
		local leaveStrokeTransparency = btn:GetAttribute("HoverBaseStrokeTransparency")
		local leaveTextColor = btn:GetAttribute("HoverBaseTextColor") or baseTextColor
		local leaveTextStrokeColor = btn:GetAttribute("HoverBaseTextStrokeColor") or baseTextStrokeColor
		local leaveTextStrokeTransparency = btn:GetAttribute("HoverBaseTextStrokeTransparency")
		tween(btn, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = leaveColor })
		tween(textTarget, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextColor3 = leaveTextColor })
		tween(textTarget, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextStrokeColor3 = leaveTextStrokeColor,
			TextStrokeTransparency = leaveTextStrokeTransparency == nil and baseTextStrokeTransparency or leaveTextStrokeTransparency,
		})
		setStrokeHovered(false, leaveStrokeColor, leaveStrokeTransparency, true)
	end)
	btn.MouseButton1Down:Connect(function()
		if not btn:GetAttribute("HoverKeepAccentGradient") then
			btn.BackgroundColor3 = REBIND_BG_DOWN
		end
		textTarget.TextColor3 = btn:GetAttribute("HoverTextColor") or baseTextColor
		textTarget.TextStrokeColor3 = btn:GetAttribute("HoverTextStrokeColor") or baseTextStrokeColor
		textTarget.TextStrokeTransparency = btn:GetAttribute("HoverTextStrokeTransparency") == nil and baseTextStrokeTransparency or btn:GetAttribute("HoverTextStrokeTransparency")
		setStrokeHovered(true, baseStrokeColor, baseStrokeTransparency, false)
	end)
	btn.MouseButton1Up:Connect(function()
		local pos = UserInputService:GetMouseLocation()
		local absPos, absSize = btn.AbsolutePosition, btn.AbsoluteSize
		local inside = pos.X >= absPos.X and pos.X <= absPos.X + absSize.X and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y
		local upColor = btn:GetAttribute("HoverBaseBg") or baseColor
		local upStrokeColor = btn:GetAttribute("HoverBaseStrokeColor")
		local upStrokeTransparency = btn:GetAttribute("HoverBaseStrokeTransparency")
		local upTextColor = btn:GetAttribute("HoverBaseTextColor") or baseTextColor
		local upTextStrokeColor = btn:GetAttribute("HoverBaseTextStrokeColor") or baseTextStrokeColor
		local upTextStrokeTransparency = btn:GetAttribute("HoverBaseTextStrokeTransparency")
		btn.BackgroundColor3 = (inside and not btn:GetAttribute("HoverKeepAccentGradient")) and (btn:GetAttribute("HoverBgColor") or REBIND_BG_HOVER) or upColor
		textTarget.TextColor3 = inside and (btn:GetAttribute("HoverTextColor") or baseTextColor) or upTextColor
		textTarget.TextStrokeColor3 = inside and (btn:GetAttribute("HoverTextStrokeColor") or baseTextStrokeColor) or upTextStrokeColor
		textTarget.TextStrokeTransparency = inside and (btn:GetAttribute("HoverTextStrokeTransparency") == nil and baseTextStrokeTransparency or btn:GetAttribute("HoverTextStrokeTransparency")) or (upTextStrokeTransparency == nil and baseTextStrokeTransparency or upTextStrokeTransparency)
		setStrokeHovered(inside, upStrokeColor, upStrokeTransparency, false)
	end)
end

